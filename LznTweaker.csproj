<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Manifesto UAC para solicitar privilégios de Administrador na inicialização -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Metadados do Executável exibidos nas Propriedades do Windows -->
    <AssemblyName>LznTweaker</AssemblyName>
    <Product>LznTweaker - Windows Optimization &amp; Gaming Companion</Product>
    <Company>LznTweaker</Company>
    <Authors>LznTweaker</Authors>
    <Description>Otimizador do Windows com execução coordenada, diagnósticos em tempo real e biblioteca completa de tweaks.</Description>
    <Copyright>Copyright © 2026</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>

    <!-- Ícone do Aplicativo (vinculado automaticamente caso app.ico exista na raiz) -->
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Inclui app.ico como recurso do executável quando presente -->
  <ItemGroup Condition="Exists('app.ico')">
    <Content Include="app.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
