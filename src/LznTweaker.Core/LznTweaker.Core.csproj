<Project Sdk="Microsoft.NET.Sdk">

  <!-- Motor e serviços do LznTweaker, sem dependência de WPF. -->
  <PropertyGroup>
    <RootNamespace>LznTweaker.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LznTweaker.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Execution\Scripts\*.ps1" LogicalName="LznTweaker.Core.Execution.Scripts.%(Filename)%(Extension)" />
    <!-- Perfis do Deadlock (OptimizationLock, GPL-3.0) embutidos; a licença acompanha o app. -->
    <EmbeddedResource Include="GameTuning\Profiles\Deadlock\*.gi" LogicalName="LznTweaker.Core.GameTuning.Deadlock.%(Filename)%(Extension)" />
    <None Include="GameTuning\Profiles\Deadlock\LICENSE-GPL-3.0.txt" Link="Licenses\OptimizationLock\LICENSE-GPL-3.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GameTuning\Profiles\Deadlock\FONTES.md" Link="Licenses\OptimizationLock\FONTES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
