<UserControl x:Class="LznTweaker.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:vm="clr-namespace:LznTweaker.ViewModels"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <!-- Selo de impacto estimado na inicialização (cor de estado: baixo, médio, alto) -->
        <DataTemplate x:Key="ImpactBadge" DataType="{x:Type vm:StartupItemViewModel}">
            <Border Background="{Binding ImpactBgBrush}" CornerRadius="{StaticResource Lzn.Radius.Sm}" Padding="7,3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Impact, StringFormat=Impacto {0}}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" Foreground="{Binding ImpactBrush}" />
            </Border>
        </DataTemplate>

        <!-- Linha: ícone da categoria, nome amigável, fabricante, impacto, estado e interruptor -->
        <DataTemplate x:Key="StartupRow" DataType="{x:Type vm:StartupItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.SurfaceActive}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CategoryGlyph}" Style="{StaticResource Lzn.Icon}" FontSize="14" Foreground="{StaticResource Lzn.TextSecondary}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Publisher}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource ImpactBadge}" Margin="12,0,0,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center" Width="92">
                    <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="6" Height="6" Fill="{Binding StateBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox Grid.Column="4" Style="{StaticResource Lzn.ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                          ToolTip="Ligado: abre com o Windows. A mudança vale na hora." AutomationProperties.Name="{Binding Title}" />
            </Grid>
        </DataTemplate>

        <!-- Detalhe do item selecionado -->
        <DataTemplate x:Key="StartupDetail" DataType="{x:Type vm:StartupItemViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Section}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ImpactBadge}" />
                    <Border Style="{StaticResource Lzn.Badge}" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CategoryDisplay}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" />
                    </Border>
                </StackPanel>

                <TextBlock Text="Fabricante" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Text="{Binding Publisher}" Style="{StaticResource Lzn.Text.Body}" />

                <TextBlock Text="Ao desativar" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Style="{StaticResource Lzn.Text.Body}" TextWrapping="Wrap"
                           Text="O programa deixa de abrir sozinho com o Windows. Ele continua instalado e funciona normalmente quando você o abre. A mudança vale na hora; para voltar, ligue de novo aqui ou no Gerenciador de Tarefas." />

                <TextBlock Text="Comando executado" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBox Text="{Binding Command, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Lzn.MonoFont}" FontSize="{StaticResource Lzn.FontSize.Caption}"
                         Foreground="{StaticResource Lzn.TextSecondary}" Background="{StaticResource Lzn.SurfaceSunken}" BorderThickness="0" Padding="10,8"
                         AutomationProperties.Name="Comando executado" />

                <TextBlock Text="Origem" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Text="{Binding LocationDisplay}" Style="{StaticResource Lzn.Text.Body}" />

                <StackPanel Visibility="{Binding ShowsTechnicalName, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                    <TextBlock Text="Nome no registro" Style="{StaticResource Lzn.DetailLabel}" />
                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Lzn.MonoFont}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" />
                </StackPanel>

                <Border BorderBrush="{StaticResource Lzn.Stroke}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,18,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource Lzn.StatusDot}" Fill="{Binding StateBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StateText, StringFormat={}{0} na inicialização}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" Style="{StaticResource Lzn.ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}" />
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Inicialização" Guide="{x:Static shell:CategoryGuides.Startup}"
                             Status="Usa o mesmo controle do Gerenciador de Tarefas do Windows: o que for desativado aqui aparece desativado lá também.">
            <Button Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Lzn.Glyph.Refresh}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Atualizar" FontSize="12" /></StackPanel>
            </Button>
        </controls:PageHeader>

        <controls:Banner Grid.Row="1" Problem="{Binding Problem}">
            <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Tentar de novo" Command="{Binding RefreshCommand}" />
        </controls:Banner>

        <!-- Busca, categoria e ação rápida -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource Lzn.SearchBox}" Height="36" Tag="Buscar por nome, fabricante ou comando…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Buscar programas de inicialização" />
            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="{StaticResource Lzn.Radius.Md}" BorderThickness="1" Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.Stroke}" Padding="10,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Lzn.Glyph.Filter}" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,0,4,0" />
                    <ComboBox Style="{StaticResource MinimalComboBoxStyle}" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}" MinWidth="170"
                              BorderThickness="0" Background="Transparent" AutomationProperties.Name="Categoria" />
                </StackPanel>
            </Border>
            <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding DisableLaunchersCommand}"
                    ToolTip="Desativa a abertura automática de launchers e apps de chat. Pede confirmação antes.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE945;" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Desativar launchers de jogos" FontSize="12" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Lzn.Text.Caption}" Text="{Binding SummaryText}" />
        </Grid>

        <controls:MasterDetailLayout Grid.Row="3" Selected="{Binding SelectedItem}" DetailTemplate="{StaticResource StartupDetail}" CloseCommand="{Binding ClearSelectionCommand}"
                                     Placeholder="Selecione um programa para ver o comando, a origem e o que acontece ao desativar.">
            <controls:MasterDetailLayout.Master>
                <Grid>
                    <ListBox x:Name="StartupList" Style="{StaticResource Lzn.List}" ItemsSource="{Binding FilteredView}" SelectedItem="{Binding SelectedItem}"
                             ItemTemplate="{StaticResource StartupRow}" AutomationProperties.Name="Programas de inicialização" />
                    <controls:EmptyState Glyph="{StaticResource Lzn.Glyph.Search}" Message="Nenhum programa corresponde à busca ou à categoria escolhida."
                                         Visibility="{Binding HasItems, ElementName=StartupList, Converter={x:Static infra:VisibilityConverter.WhenFalse}}" />
                </Grid>
            </controls:MasterDetailLayout.Master>
        </controls:MasterDetailLayout>
    </Grid>
</UserControl>
