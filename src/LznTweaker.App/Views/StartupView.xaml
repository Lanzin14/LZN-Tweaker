<UserControl x:Class="LznTweaker.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <Style x:Key="StartupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentStrokeBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StartupItemTemplate">
            <Border Style="{StaticResource StartupCardStyle}">
                <Border.ToolTip>
                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                        <Border Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.AccentStroke}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel MaxWidth="420">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Lzn.Text}" />
                                <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,2,0,6" />
                                <TextBlock Text="Linha de comando executada:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Lzn.TextMuted}" />
                                <TextBlock Text="{Binding Command}" FontSize="10" Foreground="{StaticResource Lzn.AccentText}" TextWrapping="Wrap" LineHeight="14" Margin="0,2,0,6" />
                                <TextBlock Text="{Binding LocationDisplay, StringFormat='Origem: {0}'}" FontSize="10" Foreground="{StaticResource Lzn.TextMuted}" />
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Category Icon Glyph -->
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{StaticResource Lzn.SurfaceRaised}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CategoryGlyph}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Name, Publisher & Command -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Lzn.Text}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Lzn.SurfaceHover}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CategoryDisplay}" FontSize="9" Foreground="{StaticResource Lzn.AccentText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Location Tag -->
                    <Border Grid.Column="2" Background="{StaticResource Lzn.SurfaceHover}" CornerRadius="5" Padding="7,3" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding LocationDisplay}" FontSize="10" Foreground="{StaticResource Lzn.TextSecondary}" />
                    </Border>

                    <!-- Impact Badge -->
                    <Border Grid.Column="3" Background="{Binding ImpactBgBrush}" CornerRadius="5" Padding="7,3" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Impact, StringFormat='Impacto estimado {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding ImpactBrush}" />
                    </Border>

                    <!-- Toggle Enable/Disable Checkbox -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource AccentCheckBoxStyle}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{Binding StateBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" Width="70" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,22,34,32">

            <!-- Title & Subtitle Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Gerenciador de Inicialização" Style="{StaticResource Lzn.Text.Title}" />
                    <controls:CategoryInfo Guide="{x:Static shell:CategoryGuides.Startup}" Margin="0,6,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource Lzn.SurfaceActive}" BorderBrush="{StaticResource Lzn.AccentStroke}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <TextBlock Text="COMPATIBILIDADE NATIVA (STARTUPAPPROVED)" Foreground="{StaticResource Lzn.AccentText}" FontSize="9" FontWeight="Bold" />
                </Border>
            </Grid>

            <!-- Search & Actions Top Bar -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Border Background="{StaticResource Lzn.SurfaceHover}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                        <Grid>
                            <TextBlock Text="Buscar por nome, fabricante ou comando…"
                                       Foreground="{StaticResource Lzn.TextMuted}" FontSize="12" VerticalAlignment="Center"
                                       Visibility="{Binding SearchPlaceholderVisibility}" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource Lzn.Text}" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Category Filter -->
                    <ComboBox Grid.Column="1" Style="{StaticResource MinimalComboBoxStyle}"
                              ItemsSource="{Binding CategoryFilters}"
                              SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                              Height="34" MinWidth="170" Margin="0,0,10,0" />

                    <!-- Quick Gaming Optimization Button -->
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Click="DisableLaunchers_Click" Margin="0,0,10,0" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Lzn.Icon}" Foreground="{StaticResource Lzn.RiskWarn}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Desativar Launchers de Jogos" />
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click" Padding="12,8">
                        <TextBlock Text="↻ Atualizar" />
                    </Button>
                </Grid>
            </Border>

            <!-- Status & Counter Banner -->
            <Border Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource Lzn.TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Lzn.AccentText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Startup Items List -->
            <ItemsControl ItemsSource="{Binding FilteredView}" ItemTemplate="{StaticResource StartupItemTemplate}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
