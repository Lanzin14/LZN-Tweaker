<UserControl x:Class="LznTweaker.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:tweaks="clr-namespace:LznTweaker.Core.Tweaks;assembly=LznTweaker.Core"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="PresetPillButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- Compact Tweak Row Item Template with Rich Tooltip -->
        <DataTemplate x:Key="CompactTweakItemTemplate">
            <Border CornerRadius="8" Padding="10,6" Margin="0,1"
                    ToolTipService.InitialShowDelay="120"
                    ToolTipService.BetweenShowDelay="80"
                    ToolTipService.ShowDuration="25000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ToolTip>
                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                        <Border Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.AccentStroke}" BorderThickness="1" CornerRadius="10" Padding="14" MaxWidth="390">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource Lzn.Color.Shadow}" BlurRadius="18" ShadowDepth="3" Opacity="0.75" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Lzn.Text}" TextWrapping="Wrap" />
                                    <Border Grid.Column="1" Background="{Binding RiskBackgroundBrush}" BorderBrush="{Binding RiskBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding RiskLevel, StringFormat=Risco {0}}" Foreground="{Binding RiskBrush}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,0,0,6" />

                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,8" />

                                <Border Height="1" Background="{StaticResource Lzn.SurfaceActive}" Margin="0,2,0,8" />

                                <TextBlock Text="DETALHES TÉCNICOS:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding TechnicalReason}" FontSize="11" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,8" />

                                <Border Height="1" Background="{StaticResource Lzn.SurfaceActive}" Margin="0,0,0,8" />

                                <WrapPanel Margin="0,0,0,4">
                                    <Border Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.AccentStroke}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding AdministratorText}" Foreground="{StaticResource Lzn.AccentText}" FontSize="10" />
                                    </Border>
                                    <Border Background="{StaticResource Lzn.SuccessSoft}" BorderBrush="{StaticResource Lzn.SuccessStroke}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding RestartText}" Foreground="{StaticResource Lzn.RiskLow}" FontSize="10" />
                                    </Border>
                                    <Border Background="{StaticResource Lzn.WarnSoft}" BorderBrush="{StaticResource Lzn.WarnStroke}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding RollbackText}" Foreground="{StaticResource Lzn.RiskWarn}" FontSize="10" />
                                    </Border>
                                    <Border Background="{StaticResource Lzn.SurfaceHover}" BorderBrush="{StaticResource Lzn.StrokeStrong}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Compatibility}" Foreground="{StaticResource Lzn.TextMuted}" FontSize="10" />
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="{Binding StateText}" Foreground="{StaticResource AccentTextBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Checkbox -->
                    <CheckBox Grid.Column="0" Style="{StaticResource AccentCheckBoxStyle}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,10,0" />

                    <!-- Tweak Name -->
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontSize="13" FontWeight="Medium" Foreground="{StaticResource Lzn.Text}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                    <!-- Risk Badge Indicator -->
                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Background="{Binding RiskBackgroundBrush}"
                            BorderBrush="{Binding RiskBorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding RiskLevel}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{Binding RiskBrush}" />
                    </Border>

                    <!-- Help Question Mark Icon Button -->
                    <Border Grid.Column="3" Width="18" Height="18" CornerRadius="9"
                            Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}" BorderThickness="1"
                            VerticalAlignment="Center" Cursor="Help">
                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Lzn.AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28">
            <!-- Os mesmos ajustes também estão na Geral (docs/REDESIGN-OBSIDIAN.md, decisão 8.1): o aviso evita aplicar pelos dois lugares. -->
            <controls:PageHeader Title="Avançado" Guide="{x:Static shell:CategoryGuides.Advanced}"
                                 Status="Estes ajustes também estão na página Geral. Aplique por um lugar só." Margin="0,0,0,18" />

            <!-- Presets Bar & Quick Selection -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Preset Quick Buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PRESETS:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Lzn.TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Style="{StaticResource PresetPillButtonStyle}" Command="{Binding ApplyPresetCommand}" CommandParameter="{x:Static tweaks:TweakPreset.Standard}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE734;" Style="{StaticResource Lzn.Icon}" Foreground="{StaticResource Lzn.AccentHover}" FontSize="10" Margin="0,0,6,0" />
                                    <TextBlock Text="Standard (Recomendado)" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PresetPillButtonStyle}" Command="{Binding ApplyPresetCommand}" CommandParameter="{x:Static tweaks:TweakPreset.Minimal}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource Lzn.Icon}" Foreground="{StaticResource Lzn.RiskLow}" FontSize="10" Margin="0,0,6,0" />
                                    <TextBlock Text="Mínimo" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PresetPillButtonStyle}" Command="{Binding ApplyPresetCommand}" CommandParameter="{x:Static tweaks:TweakPreset.Advanced}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource Lzn.Icon}" Foreground="{StaticResource Lzn.RiskWarn}" FontSize="10" Margin="0,0,6,0" />
                                    <TextBlock Text="Avançado" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PresetPillButtonStyle}" Command="{Binding ClearSelectionCommand}">
                                <TextBlock Text="✕ Limpar Seleção" />
                            </Button>
                        </StackPanel>

                        <!-- Refresh State Button -->
                        <Button Grid.Column="1" Style="{StaticResource PresetPillButtonStyle}" Command="{Binding RefreshCommand}" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↻ " FontSize="11" />
                                <TextBlock Text="Detectar Estado Real" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{StaticResource Lzn.SurfaceRaised}" Margin="0,11,0,10" />

                    <!-- Status / Summary info line -->
                    <Grid>
                        <TextBlock Text="{Binding SelectedPresetOption.Description}" Foreground="{StaticResource Lzn.TextMuted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border HorizontalAlignment="Right" Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.AccentStroke}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource Lzn.AccentText}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2-COLUMN COMPACT TWEAKS GRID -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Essential Tweaks + Advanced Tweaks -->
                <StackPanel Grid.Column="0">

                    <!-- Block 1: Essential Tweaks -->
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.AccentHover}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Essential Tweaks" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Lzn.Text}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="{StaticResource Lzn.SurfaceRaised}" CornerRadius="8" Padding="7,2">
                                    <TextBlock Text="{Binding EssentialItems.Count, StringFormat={}{0} opções}" Foreground="{StaticResource Lzn.AccentText}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding EssentialItems}" ItemTemplate="{StaticResource CompactTweakItemTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- Block 2: Advanced Tweaks - CAUTION -->
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.RiskWarn}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Advanced Tweaks" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Lzn.Text}" VerticalAlignment="Center" />
                                    <Border Background="{StaticResource Lzn.WarnSoft}" BorderBrush="{StaticResource Lzn.WarnStroke}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="CUIDADO" Foreground="{StaticResource Lzn.RiskWarn}" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="{StaticResource Lzn.SurfaceRaised}" CornerRadius="8" Padding="7,2">
                                    <TextBlock Text="{Binding AdvancedItems.Count, StringFormat={}{0} opções}" Foreground="{StaticResource Lzn.AccentText}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AdvancedItems}" ItemTemplate="{StaticResource CompactTweakItemTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: Customize Preferences + Performance Plans -->
                <StackPanel Grid.Column="2">

                    <!-- Block 3: Customize Preferences -->
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE790;" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.RiskLow}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Customize Preferences" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Lzn.Text}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="{StaticResource Lzn.SurfaceRaised}" CornerRadius="8" Padding="7,2">
                                    <TextBlock Text="{Binding PreferenceItems.Count, StringFormat={}{0} preferências}" Foreground="{StaticResource Lzn.AccentText}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PreferenceItems}" ItemTemplate="{StaticResource CompactTweakItemTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- Block 4: Performance Plans -->
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE83F;" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.AccentHover}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Performance Plans" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Lzn.Text}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="{StaticResource Lzn.SurfaceRaised}" CornerRadius="8" Padding="7,2">
                                    <TextBlock Text="{Binding PerformancePlanItems.Count, StringFormat={}{0} planos}" Foreground="{StaticResource Lzn.AccentText}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PerformancePlanItems}" ItemTemplate="{StaticResource CompactTweakItemTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Execution Logs & Real-Time Status Banner -->
            <Border Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Status da Sessão e Detecção" FontWeight="SemiBold" Foreground="{StaticResource Lzn.Text}" FontSize="12" />
                    <TextBlock Text="{Binding AvailabilityMessage}" Foreground="{StaticResource Lzn.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding OperationMessage}" Foreground="{StaticResource Lzn.AccentText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding HistoryMessage}" Foreground="{StaticResource Lzn.TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Bottom Global Actions Bar -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Abrir Proteção do Sistema" Command="{Binding OpenProtectionCommand}" HorizontalAlignment="Left" Padding="14,10" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Grid.Column="1" Content="Detalhes do Selecionado" Command="{Binding ShowDetailsCommand}" Margin="9,0,0,0" Padding="14,10" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Grid.Column="2" Content="↺ Undo Selecionados" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndoSelected}" Margin="9,0,0,0" Padding="14,10" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Grid.Column="3" Content="Executar Tweaks Selecionados" Command="{Binding RunCommand}" IsEnabled="{Binding CanApply}" Margin="9,0,0,0" Padding="18,10" />
            </Grid>

            <!-- Footer Note -->
            <TextBlock Text="{Binding UndoSummary}" Foreground="{StaticResource Lzn.TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
