<UserControl x:Class="LznTweaker.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <!-- Área de varredura numa linha: caixa, nome (selo "Sistema" quando pede administrador), uma frase e o tamanho.
             Caminho e quantidade de arquivos ficam na dica. -->
        <DataTemplate x:Key="CategoryRow">
            <Border Style="{StaticResource Lzn.SettingRow}" Padding="14,6">
                <Border.ToolTip>
                    <TextBlock>
                        <Run Text="{Binding PathSummary, Mode=OneWay}" /><LineBreak /><Run Text="{Binding StatusText, Mode=OneWay}" />
                    </TextBlock>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"
                              AutomationProperties.Name="{Binding Title}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" />
                        <Border Style="{StaticResource Lzn.Badge}" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding RequiresElevation, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                                ToolTip="Pasta do sistema: o Windows pede permissão de administrador para limpar.">
                            <TextBlock Text="Sistema" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" VerticalAlignment="Center"
                               MinWidth="90" TextAlignment="Right" Margin="16,0,0,0" Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Limpeza" Guide="{x:Static shell:CategoryGuides.Cleanup}" Status="Arquivos em uso são preservados: o que estiver aberto fica onde está.">
            <Button Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Lzn.Glyph.Search}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Varrer de novo" />
                </StackPanel>
            </Button>
        </controls:PageHeader>

        <controls:Banner Grid.Row="1" Problem="{Binding Problem}">
            <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Varrer de novo" Command="{Binding ScanCommand}" />
        </controls:Banner>

        <!-- Total encontrado, andamento e marcar/desmarcar -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding TotalFoundText}" FontSize="{StaticResource Lzn.FontSize.Title}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="podem ser liberados" Style="{StaticResource Lzn.Text.Caption}" VerticalAlignment="Bottom" Margin="10,0,0,4" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource Lzn.GhostButton}" Content="Marcar todos" Command="{Binding SelectAllCommand}" Margin="0,0,4,0" />
                    <Button Style="{StaticResource Lzn.GhostButton}" Content="Desmarcar todos" Command="{Binding SelectNoneCommand}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,8,0,4">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Lzn.Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,0,120,0" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Lzn.Text.Caption}" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar Height="3" Value="{Binding ProgressValue, Mode=OneWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border BorderBrush="{StaticResource Lzn.StrokeSubtle}" BorderThickness="0,1,0,0" Margin="0,0,0,12" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryRow}" Focusable="False" />
            </Border>
        </ScrollViewer>

        <controls:ActionBar Grid.Row="4" Summary="{Binding SelectedSizeText, StringFormat={}{0} nas áreas marcadas}" Hint="  ·  pede confirmação antes de apagar">
            <Button Style="{StaticResource Lzn.PrimaryButton}" Command="{Binding CleanCommand}" IsEnabled="{Binding CanClean}"
                    ToolTip="Marque ao menos uma área com arquivos encontrados. Pede confirmação antes de apagar." ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Lzn.Glyph.Delete}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Limpar selecionados" />
                </StackPanel>
            </Button>
        </controls:ActionBar>
    </Grid>
</UserControl>
