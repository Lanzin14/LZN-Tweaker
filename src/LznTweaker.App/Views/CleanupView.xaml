<UserControl x:Class="LznTweaker.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CategoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentStrokeBrush}" />
                    <Setter Property="Background" Value="{StaticResource Lzn.Surface}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CategoryTemplate">
            <Border Style="{StaticResource CategoryCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Selection Checkbox -->
                    <CheckBox Style="{StaticResource AccentCheckBoxStyle}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,14,0" />

                    <!-- Title and Path details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Lzn.Text}" />
                            <Border Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVis}}"
                                    Background="{StaticResource Lzn.SurfaceActive}" BorderBrush="{StaticResource Lzn.AccentStroke}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                <TextBlock Text="SISTEMA (UAC)" Foreground="{StaticResource Lzn.AccentText}" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PathSummary, StringFormat='Local: {0}'}" FontSize="10" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Size and Count Badge -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="14,0,0,0">
                        <Border Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.AccentStroke}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <TextBlock Text="{Binding SizeDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Lzn.AccentText}" HorizontalAlignment="Right" />
                        </Border>
                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{StaticResource Lzn.TextMuted}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,22,34,32">

            <!-- Title & Subtitle Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Limpeza do Sistema &amp; Cache" Style="{StaticResource Lzn.Text.Title}" />
                    <controls:CategoryInfo Guide="{x:Static shell:CategoryGuides.Cleanup}" Margin="0,6,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource Lzn.SurfaceActive}" BorderBrush="{StaticResource Lzn.AccentStroke}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <TextBlock Text="ARQUIVOS EM USO SÃO PRESERVADOS" Foreground="{StaticResource Lzn.RiskLow}" FontSize="9" FontWeight="Bold" />
                </Border>
            </Grid>

            <!-- Top Action & Space Summary Card -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ESPAÇO RECONHECIDO PARA LIBERAÇÃO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Lzn.TextMuted}" />
                        <TextBlock Text="{Binding TotalFoundText}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Lzn.Text}" Margin="0,4,0,2" />
                        <TextBlock Text="{Binding SelectedSizeText, StringFormat='{}{0} para remoção segura.'}" FontSize="12" Foreground="{StaticResource Lzn.AccentText}" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}" Margin="0,0,10,0" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Lzn.Icon}" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Iniciar Varredura" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CleanCommand}" IsEnabled="{Binding CanClean}" Padding="18,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Lzn.Icon}" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Limpar Selecionados" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress & Status Banner -->
            <Border Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{StaticResource Lzn.AccentText}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Height="5" Value="{Binding ProgressValue, Mode=OneWay}" Background="{StaticResource Lzn.SurfaceRaised}" Foreground="{StaticResource Lzn.AccentHover}" BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- Categories Selection Bar -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="ÁREAS DE VARREDURA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Lzn.TextMuted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Marcar Todos" Command="{Binding SelectAllCommand}" Padding="10,5" Margin="0,0,6,0" FontSize="11" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Desmarcar Todos" Command="{Binding SelectNoneCommand}" Padding="10,5" FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- Category Cards List -->
            <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryTemplate}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
