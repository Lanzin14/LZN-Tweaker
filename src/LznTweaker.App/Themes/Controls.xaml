<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Camada 3: estilos com chave (texto, superfícies, status, interruptor, navegação, botões e entrada). Usa Tokens.xaml. -->
    <!-- Um dicionário carregado por Source não enxerga os irmãos: as cores e a escala vêm daqui. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══ Texto ═══ -->
    <Style x:Key="Lzn.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Lzn.IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Lzn.Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
    </Style>
    <Style x:Key="Lzn.Text.Display" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="48" />
    </Style>
    <Style x:Key="Lzn.Text.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
    </Style>
    <Style x:Key="Lzn.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
    </Style>
    <Style x:Key="Lzn.Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style x:Key="Lzn.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Rótulo de grupo (sidebar, seções de painel). -->
    <Style x:Key="Lzn.Text.Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
    </Style>

    <!-- ═══ Superfícies ═══ -->
    <!-- Card interativo: degrau de tom no hover, contorno violeta discreto, sem brilho. -->
    <Style x:Key="Lzn.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Lzn.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.StrokeSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Lzn.Radius.Lg}" />
        <Setter Property="Padding" Value="{StaticResource Lzn.Padding.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Lzn.AccentStroke}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Painel estático (métricas, resumos): sem estado de hover. -->
    <Style x:Key="Lzn.Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Lzn.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.StrokeSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Lzn.Radius.Lg}" />
        <Setter Property="Padding" Value="{StaticResource Lzn.Padding.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══ Indicadores de status ═══ -->
    <Style x:Key="Lzn.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Lzn.Radius.Sm}" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.Stroke}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Lzn.Badge.Success" TargetType="Border" BasedOn="{StaticResource Lzn.Badge}">
        <Setter Property="Background" Value="{StaticResource Lzn.SuccessSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.SuccessStroke}" />
    </Style>
    <Style x:Key="Lzn.Badge.Warn" TargetType="Border" BasedOn="{StaticResource Lzn.Badge}">
        <Setter Property="Background" Value="{StaticResource Lzn.WarnSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.WarnStroke}" />
    </Style>
    <Style x:Key="Lzn.Badge.Danger" TargetType="Border" BasedOn="{StaticResource Lzn.Badge}">
        <Setter Property="Background" Value="{StaticResource Lzn.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.DangerStroke}" />
    </Style>
    <Style x:Key="Lzn.Badge.Accent" TargetType="Border" BasedOn="{StaticResource Lzn.Badge}">
        <Setter Property="Background" Value="{StaticResource Lzn.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.AccentStroke}" />
    </Style>
    <Style x:Key="Lzn.StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource Lzn.TextMuted}" />
    </Style>

    <!-- ═══ Interruptor (estilo Windows 11) ═══ -->
    <Style x:Key="Lzn.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                            Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}">
                        <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{StaticResource Lzn.TextSecondary}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbOffset" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Lzn.AccentStrong}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Lzn.AccentStrong}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Lzn.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Navegação ═══ -->
    <!-- Item da sidebar: barra violeta à esquerda quando selecionado. -->
    <Style x:Key="Lzn.NavItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisualInset}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,1">
                        <Border x:Name="Row" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="10,8" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource Lzn.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Lzn.SurfaceActive}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aba contextual (Core, Privacy, QoL...): fundo elevado e sublinhado violeta quando ativa. -->
    <Style x:Key="Lzn.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Chip" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="12,7" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="10,0" CornerRadius="1"
                                Background="{StaticResource Lzn.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Botões ═══ -->
    <!-- Neutro de barra de ferramentas (Filtro, Ordenar, Atualizar). -->
    <Style x:Key="Lzn.ToolbarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
        <Setter Property="Background" Value="{StaticResource Lzn.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.Stroke}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="{TemplateBinding Padding}" BorderThickness="1"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.StrokeStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceActive}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ação principal da página (ex.: Revisar e aplicar): roxo sólido com texto escuro; o hover clareia para Lavender. -->
    <Style x:Key="Lzn.PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextOnAccent}" />
        <Setter Property="Background" Value="{StaticResource Lzn.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.AccentStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceActive}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Nome antigo do botão principal, mantido para as Views existentes. -->
    <Style x:Key="Lzn.GlowButton" TargetType="Button" BasedOn="{StaticResource Lzn.PrimaryButton}" />

    <!-- Ação discreta sem contorno (fechar, links de rodapé). -->
    <Style x:Key="Lzn.GhostButton" TargetType="Button" BasedOn="{StaticResource Lzn.ToolbarButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- Ação destrutiva (remover, restaurar tudo). -->
    <Style x:Key="Lzn.DangerButton" TargetType="Button" BasedOn="{StaticResource Lzn.ToolbarButton}">
        <Setter Property="Background" Value="{StaticResource Lzn.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.DangerStroke}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.RiskHigh}" />
    </Style>

    <!-- Estilos legados das telas antigas, agora sobre os mesmos tokens. -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Lzn.ToolbarButton}">
        <Setter Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.BodySmall}" />
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Lzn.PrimaryButton}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.BodySmall}" />
    </Style>

    <!-- ═══ Entrada ═══ -->
    <!-- Caixa de busca com ícone e texto de exemplo (Tag). -->
    <Style x:Key="Lzn.SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Lzn.Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Lzn.Accent}" />
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource Lzn.Radius.Md}" BorderThickness="1" Padding="10,0"
                            Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.Stroke}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,0,8,0" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource Lzn.TextMuted}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Fundo transparente: o rótulo também é clicável. Grade para que rótulos longos quebrem a linha. -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckChrome" Width="18" Height="18" CornerRadius="5" VerticalAlignment="Center"
                                Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <TextBlock x:Name="CheckGlyph" Text="&#xE73E;" FontFamily="{StaticResource Lzn.IconFont}" Foreground="White" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource Lzn.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckChrome" Property="Background" Value="{StaticResource Lzn.AccentStrong}" />
                            <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource Lzn.AccentStrong}" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckChrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MinimalComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.BodySmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ComboChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Lzn.Radius.Md}">
                            <Grid>
                                <ContentPresenter Margin="9,0,30,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Lzn.IconFont}" Foreground="{StaticResource Lzn.TextMuted}" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" VerticalOffset="4"
                               PlacementTarget="{Binding ElementName=ToggleButton}" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                    Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}"
                                    BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="4">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Lzn.StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Lzn.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ComboChrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
