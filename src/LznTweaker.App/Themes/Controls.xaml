<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:LznTweaker.Controls"
                    xmlns:infra="clr-namespace:LznTweaker.Infrastructure">
    <!-- Camada 3: estilos com chave (texto, superfícies, status, interruptor, navegação, botões e entrada). Usa Tokens.xaml. -->
    <!-- Um dicionário carregado por Source não enxerga os irmãos: as cores e a escala vêm daqui. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══ Texto ═══ -->
    <Style x:Key="Lzn.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Lzn.IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Lzn.Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
    </Style>
    <!-- Título do painel de detalhe (Ajustes, Histórico, Inicialização, Programas, Remover apps): 18, sem título gigante. -->
    <Style x:Key="Lzn.Text.Display" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style x:Key="Lzn.Text.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
    </Style>
    <Style x:Key="Lzn.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
    </Style>
    <Style x:Key="Lzn.Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style x:Key="Lzn.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Rótulo de grupo (sidebar, seções de painel). -->
    <Style x:Key="Lzn.Text.Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Overline}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
    </Style>

    <!-- ═══ Cabeçalho de página ═══ -->
    <!-- Igual em todas as páginas: título = nome no menu com ⓘ ao lado, uma linha de descrição, status e ações à direita.
         O ⓘ abre o guia da página (o que permite fazer, benefício e cuidados); fechado por padrão. -->
    <Style x:Key="Lzn.InfoToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="ToolTip" Value="Sobre esta página" />
        <Setter Property="AutomationProperties.Name" Value="Sobre esta página" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Ring" Width="20" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Lzn.ControlStroke}" Background="Transparent">
                        <TextBlock x:Name="Glyph" Text="&#xE946;" Style="{StaticResource Lzn.Icon}" FontSize="11" Foreground="{StaticResource Lzn.TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Lzn.AccentHover}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Lzn.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Background" Value="{StaticResource Lzn.AccentSoft}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Lzn.AccentStroke}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Lzn.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:PageHeader">
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PageHeader">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Lzn.Text.Title}" VerticalAlignment="Center" />
                                <ToggleButton x:Name="InfoToggle" Style="{StaticResource Lzn.InfoToggle}" Margin="10,3,0,0" VerticalAlignment="Center"
                                              Visibility="{Binding Guide, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Guide.Summary, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Lzn.Text.Body}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Border Margin="0,10,0,0" Padding="14,10,14,12" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.SurfaceSunken}"
                                    DataContext="{Binding Guide, RelativeSource={RelativeSource TemplatedParent}}"
                                    Visibility="{Binding IsChecked, ElementName=InfoToggle, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                                <controls:AdaptiveGridPanel MinItemWidth="220" MaxColumns="3" Spacing="18">
                                    <StackPanel>
                                        <TextBlock Text="O que permite fazer" Style="{StaticResource Lzn.Text.Overline}" Margin="0,0,0,3" />
                                        <TextBlock Text="{Binding WhatYouCanDo}" Style="{StaticResource Lzn.Text.Body}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" LineHeight="18" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Benefício esperado" Style="{StaticResource Lzn.Text.Overline}" Margin="0,0,0,3" />
                                        <TextBlock Text="{Binding Benefit}" Style="{StaticResource Lzn.Text.Body}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" LineHeight="18" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding Care, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                                        <TextBlock Text="Cuidados" Style="{StaticResource Lzn.Text.Overline}" Foreground="{StaticResource Lzn.RiskWarn}" Margin="0,0,0,3" />
                                        <TextBlock Text="{Binding Care}" Style="{StaticResource Lzn.Text.Body}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" LineHeight="18" />
                                    </StackPanel>
                                </controls:AdaptiveGridPanel>
                            </Border>
                            <TextBlock Text="{TemplateBinding Status}" Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding Status, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Top" Margin="24,0,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Barra de ação ═══ -->
    <!-- Rodapé fixo das páginas com seleção: "N selecionados · aviso" à esquerda e os botões à direita. -->
    <Style TargetType="controls:ActionBar">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ActionBar">
                    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Lzn.Stroke}" Padding="0,12,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0">
                                <Run Text="{Binding Summary, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" FontWeight="SemiBold"
                                     FontSize="{StaticResource Lzn.FontSize.Body}" Foreground="{StaticResource Lzn.Text}" />
                                <Run Text="{Binding Hint, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" FontSize="{StaticResource Lzn.FontSize.Caption}"
                                     Foreground="{StaticResource Lzn.TextMuted}" />
                            </TextBlock>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Estados: aviso, vazio e carregando ═══ -->
    <!-- Aviso de página: cor e ícone pelo tipo; o texto técnico fica recolhido em "Detalhes técnicos". -->
    <Style TargetType="controls:Banner">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Banner">
                    <Border x:Name="Box" CornerRadius="{StaticResource Lzn.Radius.Lg}" BorderThickness="1" Padding="14,12"
                            Background="{StaticResource Lzn.WarnSoft}" BorderBrush="{StaticResource Lzn.WarnStroke}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Glyph" Text="{StaticResource Lzn.Glyph.Warning}" Style="{StaticResource Lzn.Icon}" FontSize="16"
                                       Foreground="{StaticResource Lzn.RiskWarn}" VerticalAlignment="Top" Margin="0,1,12,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Problem.Title, RelativeSource={RelativeSource TemplatedParent}}" FontSize="{StaticResource Lzn.FontSize.Body}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Problem.Message, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Lzn.Text.Caption}"
                                           Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <ToggleButton x:Name="DetailsToggle" HorizontalAlignment="Left" Margin="0,6,0,0" Cursor="Hand" FocusVisualStyle="{StaticResource Lzn.FocusVisual}"
                                              AutomationProperties.Name="Mostrar detalhes técnicos"
                                              Visibility="{Binding Problem.Details, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                                <TextBlock Text="Detalhes técnicos" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.AccentHover}" />
                                                <TextBlock x:Name="Chevron" Text="{StaticResource Lzn.Glyph.ChevronDown}" Style="{StaticResource Lzn.Icon}" FontSize="9"
                                                           Foreground="{StaticResource Lzn.AccentHover}" Margin="5,1,0,0" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="Text" Value="{StaticResource Lzn.Glyph.ChevronUp}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBox Text="{Binding Problem.Details, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="{StaticResource Lzn.MonoFont}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}"
                                         Background="{StaticResource Lzn.SurfaceSunken}" BorderThickness="0" Padding="10,8" Margin="0,6,0,0"
                                         AutomationProperties.Name="Detalhes técnicos"
                                         Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Problem.Kind, RelativeSource={RelativeSource Self}}" Value="Error">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Lzn.DangerSoft}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Lzn.DangerStroke}" />
                            <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Lzn.Glyph.Error}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Lzn.RiskHigh}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Problem.Kind, RelativeSource={RelativeSource Self}}" Value="Info">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Lzn.Surface}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Lzn.Stroke}" />
                            <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Lzn.Glyph.Info}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Problem" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Vazio: explica por que não há nada e, se houver, oferece a ação. -->
    <Style TargetType="controls:EmptyState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="24" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EmptyState">
                    <StackPanel MaxWidth="320">
                        <TextBlock Text="{TemplateBinding Glyph}" Style="{StaticResource Lzn.Icon}" FontSize="28" Foreground="{StaticResource Lzn.TextMuted}" HorizontalAlignment="Center" />
                        <TextBlock Text="{TemplateBinding Message}" Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <ContentPresenter HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Carregando: barra fina indeterminada e o que está sendo lido. -->
    <Style TargetType="controls:LoadingState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,40,0,0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:LoadingState">
                    <StackPanel Width="260">
                        <ProgressBar IsIndeterminate="True" Height="3" />
                        <TextBlock Text="{TemplateBinding Message}" Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Superfícies ═══ -->
    <!-- Card interativo: degrau de tom no hover, contorno violeta discreto, sem brilho. -->
    <Style x:Key="Lzn.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Lzn.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.StrokeSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Lzn.Radius.Md}" />
        <Setter Property="Padding" Value="{StaticResource Lzn.Padding.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Lzn.AccentStroke}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Painel estático (métricas, resumos): sem estado de hover. -->
    <Style x:Key="Lzn.Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Lzn.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.StrokeSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Lzn.Radius.Md}" />
        <Setter Property="Padding" Value="{StaticResource Lzn.Padding.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Linha de lista: altura mínima de 44 px, divisória embaixo, sem caixa em volta. Listas são linhas sobre o fundo,
         não cards dentro de cards. -->
    <Style x:Key="Lzn.SettingRow" TargetType="Border">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.StrokeSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══ Indicadores de status ═══ -->
    <Style x:Key="Lzn.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Lzn.Radius.Sm}" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.Stroke}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Lzn.Badge.Success" TargetType="Border" BasedOn="{StaticResource Lzn.Badge}">
        <Setter Property="Background" Value="{StaticResource Lzn.SuccessSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.SuccessStroke}" />
    </Style>
    <Style x:Key="Lzn.Badge.Warn" TargetType="Border" BasedOn="{StaticResource Lzn.Badge}">
        <Setter Property="Background" Value="{StaticResource Lzn.WarnSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.WarnStroke}" />
    </Style>
    <Style x:Key="Lzn.Badge.Danger" TargetType="Border" BasedOn="{StaticResource Lzn.Badge}">
        <Setter Property="Background" Value="{StaticResource Lzn.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.DangerStroke}" />
    </Style>
    <!-- Valor (recomendado, configurado, detectado): selo neutro com fonte técnica. Valor não é ação, então não usa violeta. -->
    <Style x:Key="Lzn.ValueChip" TargetType="Border" BasedOn="{StaticResource Lzn.Badge}">
        <Setter Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.StrokeSubtle}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="Lzn.ValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Lzn.MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
    </Style>
    <Style x:Key="Lzn.StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource Lzn.TextMuted}" />
    </Style>

    <!-- ═══ Interruptor (estilo Windows 11) ═══ -->
    <Style x:Key="Lzn.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                            Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.ControlStroke}">
                        <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{StaticResource Lzn.TextSecondary}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbOffset" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Lzn.AccentStrong}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Lzn.AccentStrong}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Lzn.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Navegação ═══ -->
    <!-- Item da sidebar (Eminência): tom mais claro no hover, mais escuro e marcador claro quando selecionado. -->
    <Style x:Key="Lzn.NavItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisualInset}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Sidebar.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,1">
                        <Border x:Name="Row" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="10,8" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource Lzn.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Lzn.Sidebar.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Sidebar.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Lzn.Sidebar.Active}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Sidebar.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aba contextual (Core, Privacy, QoL...): fundo elevado e sublinhado violeta quando ativa. -->
    <!-- Aba de nível 1 (seções da página): texto e sublinhado violeta, sem fundo. -->
    <Style x:Key="Lzn.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Margin" Value="0,0,22,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="0,8,0,10" />
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="1"
                                Background="{StaticResource Lzn.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Seletor segmentado (nível 2: filtros e perfis dentro de uma seção). Use num StackPanel horizontal; o primeiro
         e o último ganham cantos com Lzn.Segment.First / Lzn.Segment.Last. -->
    <Style x:Key="Lzn.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisualInset}" />
        <Setter Property="BorderThickness" Value="1,1,0,1" />
        <Setter Property="Tag" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chip" BorderBrush="{StaticResource Lzn.ControlStroke}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding Tag}" Background="Transparent" Padding="12,5">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource Lzn.AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Lzn.Segment.First" TargetType="RadioButton" BasedOn="{StaticResource Lzn.Segment}">
        <Setter Property="Tag" Value="6,0,0,6" />
    </Style>
    <Style x:Key="Lzn.Segment.Last" TargetType="RadioButton" BasedOn="{StaticResource Lzn.Segment}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Tag" Value="0,6,6,0" />
    </Style>

    <!-- ═══ Botões ═══ -->
    <!-- Neutro de barra de ferramentas (Filtro, Ordenar, Atualizar). -->
    <Style x:Key="Lzn.ToolbarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
        <Setter Property="Background" Value="{StaticResource Lzn.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.ControlStroke}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="{TemplateBinding Padding}" BorderThickness="1"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.TextMuted}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceActive}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ação principal da página (ex.: Revisar e aplicar): roxo sólido com texto escuro; o hover clareia para Lavender. -->
    <Style x:Key="Lzn.PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextOnAccent}" />
        <Setter Property="Background" Value="{StaticResource Lzn.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.AccentStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceActive}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ação discreta sem contorno (fechar, links de rodapé). -->
    <Style x:Key="Lzn.GhostButton" TargetType="Button" BasedOn="{StaticResource Lzn.ToolbarButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- Ação destrutiva (remover, restaurar tudo). -->
    <Style x:Key="Lzn.DangerButton" TargetType="Button" BasedOn="{StaticResource Lzn.ToolbarButton}">
        <Setter Property="Background" Value="{StaticResource Lzn.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.DangerStroke}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.RiskHigh}" />
    </Style>

    <!-- ═══ Entrada ═══ -->
    <!-- Caixa de busca com ícone e texto de exemplo (Tag). -->
    <Style x:Key="Lzn.SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Lzn.Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Lzn.Accent}" />
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource Lzn.Radius.Md}" BorderThickness="1" Padding="10,0"
                            Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.ControlStroke}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,0,8,0" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource Lzn.TextMuted}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentCheckBoxStyle" TargetType="CheckBox">
        <!-- Sem isto, o rótulo herda o preto padrão do Windows. -->
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Fundo transparente: o rótulo também é clicável. Grade para que rótulos longos quebrem a linha. -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckChrome" Width="18" Height="18" CornerRadius="5" VerticalAlignment="Center"
                                Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.ControlStroke}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <TextBlock x:Name="CheckGlyph" Text="&#xE73E;" FontFamily="{StaticResource Lzn.IconFont}" Foreground="White" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource Lzn.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckChrome" Property="Background" Value="{StaticResource Lzn.AccentStrong}" />
                            <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource Lzn.AccentStrong}" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckChrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MinimalComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.ControlStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.BodySmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ComboChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Lzn.Radius.Md}">
                            <Grid>
                                <ContentPresenter Margin="9,0,30,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Lzn.IconFont}" Foreground="{StaticResource Lzn.TextMuted}" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" VerticalOffset="4"
                               PlacementTarget="{Binding ElementName=ToggleButton}" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                    Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.ControlStroke}"
                                    BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="4">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Lzn.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Lzn.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ComboChrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ═══ Lista + detalhe ═══ -->
    <!-- Linha de lista: hover em grafite, selecionada em roxo suave com o marcador de 3 px à esquerda. -->
    <Style x:Key="Lzn.ListRow" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisualInset}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,1">
                        <Border x:Name="Row" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Indicator" Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource Lzn.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Lzn.AccentSoft}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Lzn.AccentStroke}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lista sem moldura própria, para usar com Lzn.ListRow. -->
    <Style x:Key="Lzn.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,0,6,16" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Lzn.ListRow}" />
    </Style>

    <!-- Rótulo e conteúdo de uma seção do detalhe. -->
    <Style x:Key="Lzn.DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource Lzn.Text.Overline}">
        <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <Style TargetType="controls:MasterDetailLayout">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MasterDetailLayout">
                    <Grid>
                        <!-- A lista ocupa o espaço livre, com traço à direita; o detalhe tem largura fixa e não sobra área vazia. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="MasterPane" BorderBrush="{StaticResource Lzn.StrokeSubtle}" BorderThickness="0,0,1,0" Padding="0,0,14,0">
                            <ContentPresenter Content="{TemplateBinding Master}" />
                        </Border>

                        <!-- Detalhe fixo -->
                        <Border x:Name="Docked" Grid.Column="1" Width="{StaticResource Lzn.Layout.DockedDetailWidth}" Background="Transparent">
                            <Grid>
                                <ScrollViewer x:Name="DockedContent" VerticalScrollBarVisibility="Auto" Padding="28,4,8,20" Focusable="False">
                                    <ContentPresenter Content="{TemplateBinding Selected}" ContentTemplate="{TemplateBinding DetailTemplate}" ContentTemplateSelector="{TemplateBinding DetailTemplateSelector}" />
                                </ScrollViewer>
                                <StackPanel x:Name="DockedEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed">
                                    <TextBlock Text="{StaticResource Lzn.Glyph.Select}" Style="{StaticResource Lzn.Icon}" FontSize="26" Foreground="{StaticResource Lzn.TextMuted}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{TemplateBinding Placeholder}" Style="{StaticResource Lzn.Text.Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Detalhe por cima da lista (janela estreita) -->
                        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed">
                            <Border Background="{StaticResource Lzn.Overlay}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border.InputBindings>
                            </Border>
                            <Border HorizontalAlignment="Right" Width="{StaticResource Lzn.Layout.DetailWidth}" Background="{StaticResource Lzn.Surface}"
                                    BorderBrush="{StaticResource Lzn.StrokeStrong}" BorderThickness="1,0,0,0">
                                <DockPanel Margin="22,16,16,18">
                                    <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Style="{StaticResource Lzn.GhostButton}" ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar detalhes"
                                            Command="{Binding CloseCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                        <TextBlock Text="{StaticResource Lzn.Glyph.Close}" Style="{StaticResource Lzn.Icon}" FontSize="11" />
                                    </Button>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Focusable="False">
                                        <ContentPresenter Content="{TemplateBinding Selected}" ContentTemplate="{TemplateBinding DetailTemplate}" ContentTemplateSelector="{TemplateBinding DetailTemplateSelector}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Selected" Value="{x:Null}">
                            <Setter TargetName="DockedContent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DockedEmpty" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDocked" Value="False">
                            <Setter TargetName="Docked" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MasterPane" Property="Width" Value="NaN" />
                            <Setter TargetName="MasterPane" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="MasterPane" Property="BorderThickness" Value="0" />
                            <Setter TargetName="MasterPane" Property="Padding" Value="0" />
                        </Trigger>
                        <Trigger Property="IsOverlayOpen" Value="True">
                            <Setter TargetName="Overlay" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
