<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Camadas 1 e 2 e escala: paleta (único lugar com hexadecimais), papéis de cor, tipografia, raios e foco de teclado. -->
    <!-- ═══ 1. Primitivos ═══ -->
    <Color x:Key="Lzn.Color.Gray950">#0A0A0D</Color>
    <Color x:Key="Lzn.Color.Gray925">#0E0E12</Color>
    <Color x:Key="Lzn.Color.Gray900">#141418</Color>
    <Color x:Key="Lzn.Color.Gray875">#18181D</Color>
    <Color x:Key="Lzn.Color.Gray850">#1C1C22</Color>
    <Color x:Key="Lzn.Color.Gray800">#222229</Color>
    <Color x:Key="Lzn.Color.Gray750">#2A2A33</Color>
    <Color x:Key="Lzn.Color.Gray700">#34343E</Color>
    <Color x:Key="Lzn.Color.Gray600">#464652</Color>
    <Color x:Key="Lzn.Color.Gray400">#8A8A96</Color>
    <Color x:Key="Lzn.Color.Gray300">#B6B6C0</Color>
    <Color x:Key="Lzn.Color.Gray50">#F5F5F7</Color>

    <Color x:Key="Lzn.Color.Violet700">#6D3FD9</Color>
    <Color x:Key="Lzn.Color.Violet600">#7C4DEB</Color>
    <Color x:Key="Lzn.Color.Violet500">#8B5CF6</Color>
    <Color x:Key="Lzn.Color.Violet400">#A78BFA</Color>
    <Color x:Key="Lzn.Color.Violet200">#DDD0FF</Color>
    <Color x:Key="Lzn.Color.VioletStroke">#4A3A7A</Color>
    <Color x:Key="Lzn.Color.VioletSoft">#1D1731</Color>

    <Color x:Key="Lzn.Color.Green300">#6EE7B7</Color>
    <Color x:Key="Lzn.Color.GreenSoft">#10251C</Color>
    <Color x:Key="Lzn.Color.GreenStroke">#1F4A37</Color>
    <Color x:Key="Lzn.Color.Amber300">#F5C46B</Color>
    <Color x:Key="Lzn.Color.AmberSoft">#2A2112</Color>
    <Color x:Key="Lzn.Color.AmberStroke">#4D3A1C</Color>
    <Color x:Key="Lzn.Color.Red400">#F87171</Color>
    <Color x:Key="Lzn.Color.RedSoft">#2A1416</Color>
    <Color x:Key="Lzn.Color.RedStroke">#5A2328</Color>
    <Color x:Key="Lzn.Color.Blue300">#7DB7FA</Color>

    <!-- Compatibilidade: ainda referenciado por efeitos antigos. -->
    <Color x:Key="Lzn.AccentColor">#8B5CF6</Color>
    <Color x:Key="Lzn.AccentGlowColor">#7C3AED</Color>

    <!-- ═══ 2. Semânticos ═══ -->
    <SolidColorBrush x:Key="Lzn.Background" Color="{StaticResource Lzn.Color.Gray950}" />
    <SolidColorBrush x:Key="Lzn.Sidebar" Color="{StaticResource Lzn.Color.Gray925}" />
    <SolidColorBrush x:Key="Lzn.SurfaceSunken" Color="{StaticResource Lzn.Color.Gray925}" />
    <SolidColorBrush x:Key="Lzn.Surface" Color="{StaticResource Lzn.Color.Gray900}" />
    <SolidColorBrush x:Key="Lzn.SurfaceHover" Color="{StaticResource Lzn.Color.Gray875}" />
    <SolidColorBrush x:Key="Lzn.SurfaceRaised" Color="{StaticResource Lzn.Color.Gray850}" />
    <SolidColorBrush x:Key="Lzn.SurfaceActive" Color="{StaticResource Lzn.Color.Gray800}" />
    <SolidColorBrush x:Key="Lzn.Stroke" Color="{StaticResource Lzn.Color.Gray800}" />
    <SolidColorBrush x:Key="Lzn.StrokeSubtle" Color="{StaticResource Lzn.Color.Gray850}" />
    <SolidColorBrush x:Key="Lzn.StrokeStrong" Color="{StaticResource Lzn.Color.Gray700}" />
    <SolidColorBrush x:Key="Lzn.Overlay" Color="#99000000" />

    <SolidColorBrush x:Key="Lzn.Text" Color="{StaticResource Lzn.Color.Gray50}" />
    <SolidColorBrush x:Key="Lzn.TextSecondary" Color="{StaticResource Lzn.Color.Gray300}" />
    <!-- Contraste ≥ 4,5:1 sobre Lzn.Surface. -->
    <SolidColorBrush x:Key="Lzn.TextMuted" Color="{StaticResource Lzn.Color.Gray400}" />
    <SolidColorBrush x:Key="Lzn.TextOnAccent" Color="White" />

    <SolidColorBrush x:Key="Lzn.Accent" Color="{StaticResource Lzn.Color.Violet500}" />
    <SolidColorBrush x:Key="Lzn.AccentStrong" Color="{StaticResource Lzn.Color.Violet600}" />
    <SolidColorBrush x:Key="Lzn.AccentPressed" Color="{StaticResource Lzn.Color.Violet700}" />
    <SolidColorBrush x:Key="Lzn.AccentHover" Color="{StaticResource Lzn.Color.Violet400}" />
    <SolidColorBrush x:Key="Lzn.AccentSoft" Color="{StaticResource Lzn.Color.VioletSoft}" />
    <SolidColorBrush x:Key="Lzn.AccentStroke" Color="{StaticResource Lzn.Color.VioletStroke}" />
    <SolidColorBrush x:Key="Lzn.AccentText" Color="{StaticResource Lzn.Color.Violet200}" />
    <SolidColorBrush x:Key="Lzn.FocusRing" Color="{StaticResource Lzn.Color.Violet400}" />

    <SolidColorBrush x:Key="Lzn.RiskLow" Color="{StaticResource Lzn.Color.Green300}" />
    <SolidColorBrush x:Key="Lzn.RiskWarn" Color="{StaticResource Lzn.Color.Amber300}" />
    <SolidColorBrush x:Key="Lzn.RiskHigh" Color="{StaticResource Lzn.Color.Red400}" />
    <SolidColorBrush x:Key="Lzn.Info" Color="{StaticResource Lzn.Color.Blue300}" />
    <SolidColorBrush x:Key="Lzn.SuccessSoft" Color="{StaticResource Lzn.Color.GreenSoft}" />
    <SolidColorBrush x:Key="Lzn.SuccessStroke" Color="{StaticResource Lzn.Color.GreenStroke}" />
    <SolidColorBrush x:Key="Lzn.WarnSoft" Color="{StaticResource Lzn.Color.AmberSoft}" />
    <SolidColorBrush x:Key="Lzn.WarnStroke" Color="{StaticResource Lzn.Color.AmberStroke}" />
    <SolidColorBrush x:Key="Lzn.DangerSoft" Color="{StaticResource Lzn.Color.RedSoft}" />
    <SolidColorBrush x:Key="Lzn.DangerStroke" Color="{StaticResource Lzn.Color.RedStroke}" />

    <!-- Nomes antigos usados pelas telas legadas, sobre a mesma paleta. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource Lzn.Color.Gray950}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource Lzn.Color.Gray925}" />
    <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource Lzn.Color.Gray950}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Lzn.Color.Gray900}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource Lzn.Color.Gray875}" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource Lzn.Color.Gray850}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource Lzn.Color.Gray800}" />
    <SolidColorBrush x:Key="StrokeSubtleBrush" Color="{StaticResource Lzn.Color.Gray850}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Lzn.Color.Gray50}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Lzn.Color.Gray300}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource Lzn.Color.Gray400}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Lzn.Color.Gray400}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Lzn.Color.Violet500}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Lzn.Color.Violet400}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource Lzn.Color.VioletSoft}" />
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="{StaticResource Lzn.Color.VioletStroke}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource Lzn.Color.Violet200}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Lzn.Color.Green300}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Lzn.Color.Amber300}" />

    <SolidColorBrush x:Key="Lzn.ScrollThumb" Color="{StaticResource Lzn.Color.Gray700}" />
    <SolidColorBrush x:Key="Lzn.ScrollThumbHover" Color="{StaticResource Lzn.Color.Gray600}" />

    <!-- ═══ 3. Componentes: escala ═══ -->
    <!-- Tipografia: seis tamanhos, bem separados. -->
    <sys:Double x:Key="Lzn.FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="Lzn.FontSize.BodySmall">12</sys:Double>
    <sys:Double x:Key="Lzn.FontSize.Body">13</sys:Double>
    <sys:Double x:Key="Lzn.FontSize.Subtitle">15</sys:Double>
    <sys:Double x:Key="Lzn.FontSize.Section">18</sys:Double>
    <sys:Double x:Key="Lzn.FontSize.Title">26</sys:Double>
    <!-- Só para títulos de apresentação (Home). -->
    <sys:Double x:Key="Lzn.FontSize.Display">40</sys:Double>
    <CornerRadius x:Key="Lzn.Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Lzn.Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="Lzn.Radius.Lg">12</CornerRadius>
    <Thickness x:Key="Lzn.Padding.Card">16,14</Thickness>
    <Thickness x:Key="Lzn.Padding.Page">28,22,28,16</Thickness>

    <FontFamily x:Key="Lzn.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Segoe Fluent Icons no Windows 11; Segoe MDL2 Assets no Windows 10. -->
    <FontFamily x:Key="Lzn.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Foco de teclado: anel violeta por fora do controle (aparece só ao navegar com Tab). -->
    <Style x:Key="Lzn.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="{StaticResource Lzn.FocusRing}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Variante interna, para itens dentro de listas que cortariam o anel externo. -->
    <Style x:Key="Lzn.FocusVisualInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="1" RadiusX="8" RadiusY="8" Stroke="{StaticResource Lzn.FocusRing}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
