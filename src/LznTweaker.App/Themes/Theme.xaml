<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Sistema visual do LznTweaker, em três camadas:
          1. Primitivos: a paleta bruta (Lzn.Color.*). Só esta camada contém códigos hexadecimais.
          2. Semânticos: o papel de cada cor (fundo, superfície, texto, destaque, estados). As Views usam estes.
          3. Componentes: tamanhos, raios e estilos reutilizáveis (cards, botões, interruptor, abas...).
        Regras: superfícies se separam por um degrau de tom; cor fica para estado e ação principal;
        nada brilha em repouso; todo controle interativo mostra foco de teclado visível.
    -->

    <!-- ═══ 1. Primitivos ═══ -->
    <Color x:Key="Lzn.Color.Gray950">#0A0A0D</Color>
    <Color x:Key="Lzn.Color.Gray925">#0E0E12</Color>
    <Color x:Key="Lzn.Color.Gray900">#141418</Color>
    <Color x:Key="Lzn.Color.Gray875">#18181D</Color>
    <Color x:Key="Lzn.Color.Gray850">#1C1C22</Color>
    <Color x:Key="Lzn.Color.Gray800">#222229</Color>
    <Color x:Key="Lzn.Color.Gray750">#2A2A33</Color>
    <Color x:Key="Lzn.Color.Gray700">#34343E</Color>
    <Color x:Key="Lzn.Color.Gray600">#464652</Color>
    <Color x:Key="Lzn.Color.Gray400">#8A8A96</Color>
    <Color x:Key="Lzn.Color.Gray300">#B6B6C0</Color>
    <Color x:Key="Lzn.Color.Gray50">#F5F5F7</Color>

    <Color x:Key="Lzn.Color.Violet700">#6D3FD9</Color>
    <Color x:Key="Lzn.Color.Violet600">#7C4DEB</Color>
    <Color x:Key="Lzn.Color.Violet500">#8B5CF6</Color>
    <Color x:Key="Lzn.Color.Violet400">#A78BFA</Color>
    <Color x:Key="Lzn.Color.Violet200">#DDD0FF</Color>
    <Color x:Key="Lzn.Color.VioletStroke">#4A3A7A</Color>
    <Color x:Key="Lzn.Color.VioletSoft">#1D1731</Color>

    <Color x:Key="Lzn.Color.Green300">#6EE7B7</Color>
    <Color x:Key="Lzn.Color.GreenSoft">#10251C</Color>
    <Color x:Key="Lzn.Color.GreenStroke">#1F4A37</Color>
    <Color x:Key="Lzn.Color.Amber300">#F5C46B</Color>
    <Color x:Key="Lzn.Color.AmberSoft">#2A2112</Color>
    <Color x:Key="Lzn.Color.AmberStroke">#4D3A1C</Color>
    <Color x:Key="Lzn.Color.Red400">#F87171</Color>
    <Color x:Key="Lzn.Color.RedSoft">#2A1416</Color>
    <Color x:Key="Lzn.Color.RedStroke">#5A2328</Color>
    <Color x:Key="Lzn.Color.Blue300">#7DB7FA</Color>

    <!-- Compatibilidade: ainda referenciado por efeitos antigos. -->
    <Color x:Key="Lzn.AccentColor">#8B5CF6</Color>
    <Color x:Key="Lzn.AccentGlowColor">#7C3AED</Color>

    <!-- ═══ 2. Semânticos ═══ -->
    <SolidColorBrush x:Key="Lzn.Background" Color="{StaticResource Lzn.Color.Gray950}" />
    <SolidColorBrush x:Key="Lzn.Sidebar" Color="{StaticResource Lzn.Color.Gray925}" />
    <SolidColorBrush x:Key="Lzn.SurfaceSunken" Color="{StaticResource Lzn.Color.Gray925}" />
    <SolidColorBrush x:Key="Lzn.Surface" Color="{StaticResource Lzn.Color.Gray900}" />
    <SolidColorBrush x:Key="Lzn.SurfaceHover" Color="{StaticResource Lzn.Color.Gray875}" />
    <SolidColorBrush x:Key="Lzn.SurfaceRaised" Color="{StaticResource Lzn.Color.Gray850}" />
    <SolidColorBrush x:Key="Lzn.SurfaceActive" Color="{StaticResource Lzn.Color.Gray800}" />
    <SolidColorBrush x:Key="Lzn.Stroke" Color="{StaticResource Lzn.Color.Gray800}" />
    <SolidColorBrush x:Key="Lzn.StrokeSubtle" Color="{StaticResource Lzn.Color.Gray850}" />
    <SolidColorBrush x:Key="Lzn.StrokeStrong" Color="{StaticResource Lzn.Color.Gray700}" />
    <SolidColorBrush x:Key="Lzn.Overlay" Color="#99000000" />

    <SolidColorBrush x:Key="Lzn.Text" Color="{StaticResource Lzn.Color.Gray50}" />
    <SolidColorBrush x:Key="Lzn.TextSecondary" Color="{StaticResource Lzn.Color.Gray300}" />
    <!-- Contraste ≥ 4,5:1 sobre Lzn.Surface. -->
    <SolidColorBrush x:Key="Lzn.TextMuted" Color="{StaticResource Lzn.Color.Gray400}" />
    <SolidColorBrush x:Key="Lzn.TextOnAccent" Color="White" />

    <SolidColorBrush x:Key="Lzn.Accent" Color="{StaticResource Lzn.Color.Violet500}" />
    <SolidColorBrush x:Key="Lzn.AccentStrong" Color="{StaticResource Lzn.Color.Violet600}" />
    <SolidColorBrush x:Key="Lzn.AccentPressed" Color="{StaticResource Lzn.Color.Violet700}" />
    <SolidColorBrush x:Key="Lzn.AccentHover" Color="{StaticResource Lzn.Color.Violet400}" />
    <SolidColorBrush x:Key="Lzn.AccentSoft" Color="{StaticResource Lzn.Color.VioletSoft}" />
    <SolidColorBrush x:Key="Lzn.AccentStroke" Color="{StaticResource Lzn.Color.VioletStroke}" />
    <SolidColorBrush x:Key="Lzn.AccentText" Color="{StaticResource Lzn.Color.Violet200}" />
    <SolidColorBrush x:Key="Lzn.FocusRing" Color="{StaticResource Lzn.Color.Violet400}" />

    <SolidColorBrush x:Key="Lzn.RiskLow" Color="{StaticResource Lzn.Color.Green300}" />
    <SolidColorBrush x:Key="Lzn.RiskWarn" Color="{StaticResource Lzn.Color.Amber300}" />
    <SolidColorBrush x:Key="Lzn.RiskHigh" Color="{StaticResource Lzn.Color.Red400}" />
    <SolidColorBrush x:Key="Lzn.Info" Color="{StaticResource Lzn.Color.Blue300}" />
    <SolidColorBrush x:Key="Lzn.SuccessSoft" Color="{StaticResource Lzn.Color.GreenSoft}" />
    <SolidColorBrush x:Key="Lzn.SuccessStroke" Color="{StaticResource Lzn.Color.GreenStroke}" />
    <SolidColorBrush x:Key="Lzn.WarnSoft" Color="{StaticResource Lzn.Color.AmberSoft}" />
    <SolidColorBrush x:Key="Lzn.WarnStroke" Color="{StaticResource Lzn.Color.AmberStroke}" />
    <SolidColorBrush x:Key="Lzn.DangerSoft" Color="{StaticResource Lzn.Color.RedSoft}" />
    <SolidColorBrush x:Key="Lzn.DangerStroke" Color="{StaticResource Lzn.Color.RedStroke}" />

    <!-- Nomes antigos usados pelas telas legadas, sobre a mesma paleta. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource Lzn.Color.Gray950}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource Lzn.Color.Gray925}" />
    <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource Lzn.Color.Gray950}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Lzn.Color.Gray900}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource Lzn.Color.Gray875}" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource Lzn.Color.Gray850}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource Lzn.Color.Gray800}" />
    <SolidColorBrush x:Key="StrokeSubtleBrush" Color="{StaticResource Lzn.Color.Gray850}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Lzn.Color.Gray50}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Lzn.Color.Gray300}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource Lzn.Color.Gray400}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Lzn.Color.Gray400}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Lzn.Color.Violet500}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Lzn.Color.Violet400}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource Lzn.Color.VioletSoft}" />
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="{StaticResource Lzn.Color.VioletStroke}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource Lzn.Color.Violet200}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Lzn.Color.Green300}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Lzn.Color.Amber300}" />

    <SolidColorBrush x:Key="Lzn.ScrollThumb" Color="{StaticResource Lzn.Color.Gray700}" />
    <SolidColorBrush x:Key="Lzn.ScrollThumbHover" Color="{StaticResource Lzn.Color.Gray600}" />

    <!-- ═══ 3. Componentes: escala ═══ -->
    <!-- Tipografia: seis tamanhos, bem separados. -->
    <sys:Double x:Key="Lzn.FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="Lzn.FontSize.BodySmall">12</sys:Double>
    <sys:Double x:Key="Lzn.FontSize.Body">13</sys:Double>
    <sys:Double x:Key="Lzn.FontSize.Subtitle">15</sys:Double>
    <sys:Double x:Key="Lzn.FontSize.Section">18</sys:Double>
    <sys:Double x:Key="Lzn.FontSize.Title">26</sys:Double>
    <!-- Só para títulos de apresentação (Home). -->
    <sys:Double x:Key="Lzn.FontSize.Display">40</sys:Double>
    <CornerRadius x:Key="Lzn.Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Lzn.Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="Lzn.Radius.Lg">12</CornerRadius>
    <Thickness x:Key="Lzn.Padding.Card">16,14</Thickness>
    <Thickness x:Key="Lzn.Padding.Page">28,22,28,16</Thickness>

    <FontFamily x:Key="Lzn.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Segoe Fluent Icons no Windows 11; Segoe MDL2 Assets no Windows 10. -->
    <FontFamily x:Key="Lzn.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Foco de teclado: anel violeta por fora do controle (aparece só ao navegar com Tab). -->
    <Style x:Key="Lzn.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="{StaticResource Lzn.FocusRing}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Variante interna, para itens dentro de listas que cortariam o anel externo. -->
    <Style x:Key="Lzn.FocusVisualInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="1" RadiusX="8" RadiusY="8" Stroke="{StaticResource Lzn.FocusRing}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Texto ═══ -->
    <Style x:Key="Lzn.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Lzn.IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Lzn.Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
    </Style>
    <Style x:Key="Lzn.Text.Display" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="48" />
    </Style>
    <Style x:Key="Lzn.Text.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
    </Style>
    <Style x:Key="Lzn.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
    </Style>
    <Style x:Key="Lzn.Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style x:Key="Lzn.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Rótulo de grupo (sidebar, seções de painel). -->
    <Style x:Key="Lzn.Text.Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
    </Style>

    <!-- ═══ Superfícies ═══ -->
    <!-- Card interativo: degrau de tom no hover, contorno violeta discreto, sem brilho. -->
    <Style x:Key="Lzn.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Lzn.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.StrokeSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Lzn.Radius.Lg}" />
        <Setter Property="Padding" Value="{StaticResource Lzn.Padding.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Lzn.AccentStroke}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Painel estático (métricas, resumos): sem estado de hover. -->
    <Style x:Key="Lzn.Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Lzn.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.StrokeSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Lzn.Radius.Lg}" />
        <Setter Property="Padding" Value="{StaticResource Lzn.Padding.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══ Indicadores de status ═══ -->
    <Style x:Key="Lzn.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Lzn.Radius.Sm}" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.Stroke}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Lzn.Badge.Success" TargetType="Border" BasedOn="{StaticResource Lzn.Badge}">
        <Setter Property="Background" Value="{StaticResource Lzn.SuccessSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.SuccessStroke}" />
    </Style>
    <Style x:Key="Lzn.Badge.Warn" TargetType="Border" BasedOn="{StaticResource Lzn.Badge}">
        <Setter Property="Background" Value="{StaticResource Lzn.WarnSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.WarnStroke}" />
    </Style>
    <Style x:Key="Lzn.Badge.Danger" TargetType="Border" BasedOn="{StaticResource Lzn.Badge}">
        <Setter Property="Background" Value="{StaticResource Lzn.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.DangerStroke}" />
    </Style>
    <Style x:Key="Lzn.Badge.Accent" TargetType="Border" BasedOn="{StaticResource Lzn.Badge}">
        <Setter Property="Background" Value="{StaticResource Lzn.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.AccentStroke}" />
    </Style>
    <Style x:Key="Lzn.StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource Lzn.TextMuted}" />
    </Style>

    <!-- ═══ Interruptor (estilo Windows 11) ═══ -->
    <Style x:Key="Lzn.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                            Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}">
                        <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{StaticResource Lzn.TextSecondary}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbOffset" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Lzn.AccentStrong}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Lzn.AccentStrong}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Lzn.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Navegação ═══ -->
    <!-- Item da sidebar: barra violeta à esquerda quando selecionado. -->
    <Style x:Key="Lzn.NavItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisualInset}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,1">
                        <Border x:Name="Row" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="10,8" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource Lzn.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Lzn.SurfaceActive}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aba contextual (Core, Privacy, QoL...): fundo elevado e sublinhado violeta quando ativa. -->
    <Style x:Key="Lzn.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Chip" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="12,7" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="10,0" CornerRadius="1"
                                Background="{StaticResource Lzn.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Botões ═══ -->
    <!-- Neutro de barra de ferramentas (Filtro, Ordenar, Atualizar). -->
    <Style x:Key="Lzn.ToolbarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
        <Setter Property="Background" Value="{StaticResource Lzn.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.Stroke}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="{TemplateBinding Padding}" BorderThickness="1"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.StrokeStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceActive}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ação principal da página (ex.: Revisar e aplicar): violeta sólido, sem brilho. -->
    <Style x:Key="Lzn.PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextOnAccent}" />
        <Setter Property="Background" Value="{StaticResource Lzn.AccentStrong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.AccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceActive}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Nome antigo do botão principal, mantido para as Views existentes. -->
    <Style x:Key="Lzn.GlowButton" TargetType="Button" BasedOn="{StaticResource Lzn.PrimaryButton}" />

    <!-- Ação discreta sem contorno (fechar, links de rodapé). -->
    <Style x:Key="Lzn.GhostButton" TargetType="Button" BasedOn="{StaticResource Lzn.ToolbarButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- Ação destrutiva (remover, restaurar tudo). -->
    <Style x:Key="Lzn.DangerButton" TargetType="Button" BasedOn="{StaticResource Lzn.ToolbarButton}">
        <Setter Property="Background" Value="{StaticResource Lzn.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.DangerStroke}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.RiskHigh}" />
    </Style>

    <!-- Estilos legados das telas antigas, agora sobre os mesmos tokens. -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Lzn.ToolbarButton}">
        <Setter Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.BodySmall}" />
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Lzn.PrimaryButton}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.BodySmall}" />
    </Style>

    <!-- ═══ Entrada ═══ -->
    <!-- Caixa de busca com ícone e texto de exemplo (Tag). -->
    <Style x:Key="Lzn.SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Lzn.Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Lzn.Accent}" />
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource Lzn.Radius.Md}" BorderThickness="1" Padding="10,0"
                            Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.Stroke}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,0,8,0" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource Lzn.TextMuted}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Fundo transparente: o rótulo também é clicável. Grade para que rótulos longos quebrem a linha. -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckChrome" Width="18" Height="18" CornerRadius="5" VerticalAlignment="Center"
                                Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <TextBlock x:Name="CheckGlyph" Text="&#xE73E;" FontFamily="{StaticResource Lzn.IconFont}" Foreground="White" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource Lzn.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckChrome" Property="Background" Value="{StaticResource Lzn.AccentStrong}" />
                            <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource Lzn.AccentStrong}" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckChrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MinimalComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.BodySmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ComboChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Lzn.Radius.Md}">
                            <Grid>
                                <ContentPresenter Margin="9,0,30,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Lzn.IconFont}" Foreground="{StaticResource Lzn.TextMuted}" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" VerticalOffset="4"
                               PlacementTarget="{Binding ElementName=ToggleButton}" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                    Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}"
                                    BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="4">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Lzn.StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Lzn.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ComboChrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Estilos implícitos (valem para todo o app) ═══ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource Lzn.Radius.Sm}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource Lzn.SurfaceActive}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource Lzn.AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Lzn.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dica: superfície elevada, quebra de linha e largura máxima legível. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lzn.StrokeStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.BodySmall}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de rolagem fina, no tom da superfície. -->
    <Style x:Key="Lzn.ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbChrome" CornerRadius="3" Background="{StaticResource Lzn.ScrollThumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource Lzn.ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource Lzn.AccentStroke}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Lzn.ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Lzn.ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Lzn.ScrollThumbStyle}" Margin="2,2" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Lzn.ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Lzn.ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Lzn.ScrollThumbStyle}" Margin="2,2" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Lzn.ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Barra de progresso arredondada (uso de CPU/RAM/disco, limpeza). -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{StaticResource Lzn.SurfaceActive}" />
        <Setter Property="Foreground" Value="{StaticResource Lzn.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
