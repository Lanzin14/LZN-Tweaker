<UserControl x:Class="LznTweaker.Features.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LznTweaker.Features.Home"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <!-- Início (docs/REESTRUTURACAO-UX.md e reformulação visual): uma linha de hardware, o que fazer agora (3 linhas com
         estado e ação), as últimas alterações e os jogos encontrados. Sem cards: listas são linhas com divisória. -->
    <UserControl.Resources>
        <Style x:Key="HwItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,24,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HwIcon" TargetType="TextBlock" BasedOn="{StaticResource Lzn.Icon}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TodoIcon" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="{StaticResource Lzn.Radius.Md}" />
            <Setter Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusCell" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="16,0" />
        </Style>
        <Style x:Key="SectionLink" TargetType="Button" BasedOn="{StaticResource Lzn.GhostButton}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,24">
            <controls:PageHeader Title="Início" Guide="{x:Static shell:CategoryGuides.Home}">
                <Button Style="{StaticResource Lzn.GhostButton}" Command="{Binding RefreshDashboardCommand}" ToolTip="Ler de novo processador, memória e disco">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Lzn.Glyph.Refresh}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Atualizar" />
                    </StackPanel>
                </Button>
            </controls:PageHeader>

            <!-- Hardware numa linha; o detalhe fica em Ferramentas › Hardware. -->
            <Border BorderBrush="{StaticResource Lzn.StrokeSubtle}" BorderThickness="0,1" Padding="0,10" Margin="0,0,0,22">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SectionLink}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:ShellPages.Hardware}">
                        <TextBlock Text="Detalhes do hardware" FontSize="{StaticResource Lzn.FontSize.BodySmall}" FontWeight="Medium" Foreground="{StaticResource Lzn.AccentHover}" />
                    </Button>
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Style="{StaticResource HwItem}" ToolTip="{Binding Dashboard.ProcessorDetail}">
                            <TextBlock Text="&#xE950;" Style="{StaticResource HwIcon}" />
                            <TextBlock Text="{Binding Dashboard.ProcessorName}" Foreground="{StaticResource Lzn.TextSecondary}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource HwItem}" ToolTip="{Binding Dashboard.GraphicsMemorySummary}">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource HwIcon}" />
                            <TextBlock Text="{Binding Dashboard.GraphicsSummary}" Foreground="{StaticResource Lzn.TextSecondary}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource HwItem}" ToolTip="{Binding Dashboard.MemoryDetail}">
                            <TextBlock Text="&#xE964;" Style="{StaticResource HwIcon}" />
                            <TextBlock Text="{Binding Dashboard.MemorySummary, StringFormat={}{0} de RAM}" Foreground="{StaticResource Lzn.TextSecondary}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource HwItem}">
                            <TextBlock Text="&#xEDA2;" Style="{StaticResource HwIcon}" />
                            <TextBlock Text="{Binding Dashboard.StorageSummary}" Foreground="{StaticResource Lzn.TextSecondary}" />
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- O que fazer agora: um botão roxo só (Revisar recomendados). -->
                    <TextBlock Text="O QUE FAZER AGORA" Style="{StaticResource Lzn.Text.Overline}" Margin="0,0,0,6" />

                    <Border Style="{StaticResource Lzn.SettingRow}" MinHeight="64" Padding="4,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource TodoIcon}">
                                <TextBlock Text="{StaticResource Lzn.Glyph.Settings}" Style="{StaticResource Lzn.Icon}" FontSize="15" Foreground="{StaticResource Lzn.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Lzn.PrimaryButton}" Content="Revisar recomendados" Command="{Binding ReviewRecommendedCommand}" VerticalAlignment="Center"
                                    ToolTip="Abre Ajustes do Windows com a seleção recomendada marcada. Nada é aplicado sem a sua revisão." />
                            <StackPanel DockPanel.Dock="Right" Style="{StaticResource StatusCell}">
                                <TextBlock Text="{Binding TweaksBadge}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="Medium" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Lzn.RiskLow}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRecommendedPending}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Lzn.RiskWarn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTweaksLoading}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ajustes recomendados" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TweaksText}" Style="{StaticResource Lzn.Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Lzn.SettingRow}" MinHeight="64" Padding="4,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource TodoIcon}">
                                <TextBlock Text="&#xEA99;" Style="{StaticResource Lzn.Icon}" FontSize="15" Foreground="{StaticResource Lzn.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Lzn.ToolbarButton}" Content="Abrir Limpeza" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:ShellPages.Cleanup}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Style="{StaticResource StatusCell}">
                                <TextBlock Text="{Binding CleanupBadge}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="Medium" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCleanupUnscanned}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Limpeza" FontWeight="SemiBold" />
                                <TextBlock Text="Temporários, caches e logs. A varredura só roda quando você abre a Limpeza." Style="{StaticResource Lzn.Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Lzn.SettingRow}" MinHeight="64" Padding="4,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource TodoIcon}">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Lzn.Icon}" FontSize="15" Foreground="{StaticResource Lzn.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Lzn.ToolbarButton}" Content="Revisar" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:ShellPages.Startup}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Style="{StaticResource StatusCell}">
                                <TextBlock Text="{Binding StartupBadge}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="Medium" Foreground="{StaticResource Lzn.TextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Inicialização" FontWeight="SemiBold" />
                                <TextBlock Text="Programas que abrem sozinhos com o Windows. Desativar não desinstala." Style="{StaticResource Lzn.Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Últimas alterações -->
                    <Grid Margin="0,28,0,6">
                        <TextBlock Text="ÚLTIMAS ALTERAÇÕES" Style="{StaticResource Lzn.Text.Overline}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource SectionLink}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:ShellPages.Backups}">
                            <TextBlock Text="Ver histórico e desfazer" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="Medium" Foreground="{StaticResource Lzn.AccentHover}" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RecentChanges}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:RecentChange}">
                                <Border Style="{StaticResource Lzn.SettingRow}" MinHeight="40" Padding="4,6" ToolTip="{Binding Outcome}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Dot" Style="{StaticResource Lzn.StatusDot}" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource Lzn.TextMuted}" FontSize="{StaticResource Lzn.FontSize.Caption}" />
                                        </TextBlock>
                                        <TextBlock x:Name="Status" Grid.Column="2" Text="{Binding StatusText}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="Medium"
                                                   Foreground="{StaticResource Lzn.TextSecondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding When}" Style="{StaticResource Lzn.Text.Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Lzn.RiskLow}" />
                                        <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Lzn.RiskLow}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nenhuma alteração registrada ainda." Style="{StaticResource Lzn.Text.Caption}" Margin="4,8,0,0"
                               Visibility="{Binding HasRecentChanges, Converter={x:Static infra:VisibilityConverter.WhenFalse}}" />
                </StackPanel>

                <!-- Jogos encontrados e o que garante a segurança -->
                <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="JOGOS ENCONTRADOS" Style="{StaticResource Lzn.Text.Overline}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource SectionLink}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:ShellPages.Games}">
                            <TextBlock Text="Abrir Jogos" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="Medium" Foreground="{StaticResource Lzn.AccentHover}" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding InstalledGames}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HomeGame}">
                                <Border Style="{StaticResource Lzn.SettingRow}" Padding="4,8">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="{StaticResource Lzn.Radius.Sm}" Background="{StaticResource Lzn.SurfaceRaised}" Margin="0,0,12,0">
                                            <Grid>
                                                <TextBlock Text="&#xE7FC;" Style="{StaticResource Lzn.Icon}" FontSize="14" Foreground="{StaticResource Lzn.TextMuted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Platform}" Style="{StaticResource Lzn.Text.Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nenhum jogo compatível encontrado." Style="{StaticResource Lzn.Text.Caption}" Margin="4,8,0,0"
                               Visibility="{Binding HasInstalledGames, Converter={x:Static infra:VisibilityConverter.WhenFalse}}" />

                    <TextBlock Text="SEGURANÇA" Style="{StaticResource Lzn.Text.Overline}" Margin="0,28,0,8" />
                    <TextBlock Text="Antes de cada alteração o app cria um ponto de restauração, e o Histórico guarda o valor anterior para desfazer."
                               Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" LineHeight="20" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
