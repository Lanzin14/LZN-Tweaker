<UserControl x:Class="LznTweaker.Features.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LznTweaker.Features.Home"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <!-- Parágrafo de apresentação: corpo maior e entrelinha ~1,6 para leitura confortável. -->
        <Style x:Key="Lead" TargetType="TextBlock" BasedOn="{StaticResource Lzn.Text.Body}">
            <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Subtitle}" />
            <Setter Property="LineHeight" Value="25" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Resources>

    <!-- Apresentação em coluna única: título, texto, princípios e uma ação. Informações de hardware ficam na página Hardware. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="56,56,56,40" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="LZN Tweaker" Style="{StaticResource Lzn.Text.Overline}" Foreground="{StaticResource Lzn.AccentHover}" Margin="0,0,0,14" />
            <TextBlock Text="Mais desempenho. Mais controle. Mais jogo." Style="{StaticResource Lzn.Text.Display}" Margin="0,0,0,28" />

            <!-- Largura limitada (~70 caracteres por linha). -->
            <StackPanel MaxWidth="660" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Lead}" Foreground="{StaticResource Lzn.Text}"
                           Text="O LZN Tweaker reúne ferramentas e ajustes para ajudar você a otimizar o Windows e configurar seu PC para jogar." />
                <TextBlock Style="{StaticResource Lead}"
                           Text="Desenvolvido com foco em jogadores competitivos, o aplicativo prioriza desempenho, praticidade e transparência, com explicações claras sobre cada ajuste e seus possíveis efeitos." />
                <TextBlock Style="{StaticResource Lead}"
                           Text="A proposta não é prometer milagres ou FPS garantido, mas oferecer ferramentas úteis para você ter mais controle sobre o seu sistema." />
                <TextBlock FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource Lzn.AccentText}">
                    <Run Text="LZN Tweaker" /><Run Text=" — otimize seu PC. Foque no jogo." Foreground="{StaticResource Lzn.TextSecondary}" FontWeight="Normal" />
                </TextBlock>
            </StackPanel>

            <Button Style="{StaticResource Lzn.PrimaryButton}" HorizontalAlignment="Left" Margin="0,32,0,0"
                    Command="{Binding NavigateCommand}" CommandParameter="general">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Conhecer os ajustes" FontSize="{StaticResource Lzn.FontSize.Body}" />
                    <TextBlock Text="&#xE72A;" Style="{StaticResource Lzn.Icon}" FontSize="12" Margin="10,0,0,0" />
                </StackPanel>
            </Button>

            <!-- Confiança e transparência: uma faixa discreta com três princípios, sem cards individuais. -->
            <Border Style="{StaticResource Lzn.Panel}" Margin="0,48,0,0" Padding="24,22">
                <ItemsControl ItemsSource="{Binding Principles}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="200" MaxColumns="3" Spacing="28" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:HomePrinciple}">
                            <StackPanel>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" FontSize="18" Foreground="{StaticResource Lzn.AccentHover}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Subtitle}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Lzn.Text.Body}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" LineHeight="18" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Sobre: logo, nome e versão lida do assembly. Links oficiais entram aqui quando existirem. -->
            <Grid Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/LznTweaker;component/Assets/Brand/lzn-logo-mark.png" Height="34" Stretch="Uniform" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logo do LZN Tweaker" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Sobre o LZN Tweaker" Style="{StaticResource Lzn.Text.Overline}" />
                    <TextBlock Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,3,0,0">
                        <Run Text="Versão " /><Run Text="{Binding AppVersion, Mode=OneWay}" /><Run Text=" · para Windows 10 e 11" />
                    </TextBlock>
                    <TextBlock Text="Site e canais oficiais ainda não foram publicados." Style="{StaticResource Lzn.Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
