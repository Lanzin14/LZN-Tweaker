<UserControl x:Class="LznTweaker.Features.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LznTweaker.Features.Home"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <!-- Componente do PC: rótulo, valor e uma linha de detalhe -->
        <Style x:Key="Spec" TargetType="Border" BasedOn="{StaticResource Lzn.Panel}">
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="SpecValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Ação rápida: título com selo de número, uma frase e um botão -->
        <Style x:Key="Quick" TargetType="Border" BasedOn="{StaticResource Lzn.Panel}">
            <Setter Property="Padding" Value="18,16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,24">
            <controls:PageHeader Title="Início" Guide="{x:Static shell:CategoryGuides.Home}">
                <Button Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding RefreshDashboardCommand}" ToolTip="Ler de novo processador, memória e disco">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Lzn.Glyph.Refresh}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Atualizar" />
                    </StackPanel>
                </Button>
            </controls:PageHeader>

            <!-- Seu PC -->
            <controls:AdaptiveGridPanel MinItemWidth="200" MaxColumns="4" Spacing="12">
                <Border Style="{StaticResource Spec}">
                    <StackPanel>
                        <TextBlock Text="PROCESSADOR" Style="{StaticResource Lzn.Text.Overline}" />
                        <TextBlock Text="{Binding Dashboard.ProcessorDetail}" Style="{StaticResource SpecValue}" ToolTip="{Binding Dashboard.ProcessorDetail}" />
                        <TextBlock Text="{Binding Dashboard.CpuUsageText, StringFormat=Uso {0}}" Style="{StaticResource Lzn.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Spec}">
                    <StackPanel>
                        <TextBlock Text="PLACA DE VÍDEO" Style="{StaticResource Lzn.Text.Overline}" />
                        <TextBlock Text="{Binding Dashboard.GraphicsSummary}" Style="{StaticResource SpecValue}" ToolTip="{Binding Dashboard.GraphicsSummary}" />
                        <TextBlock Text="{Binding Dashboard.GraphicsMemorySummary}" Style="{StaticResource Lzn.Text.Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Spec}">
                    <StackPanel>
                        <TextBlock Text="MEMÓRIA" Style="{StaticResource Lzn.Text.Overline}" />
                        <TextBlock Text="{Binding Dashboard.MemorySummary}" Style="{StaticResource SpecValue}" />
                        <TextBlock Text="{Binding Dashboard.MemoryDetail}" Style="{StaticResource Lzn.Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Dashboard.MemoryDetail}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Spec}">
                    <StackPanel>
                        <TextBlock Text="ARMAZENAMENTO" Style="{StaticResource Lzn.Text.Overline}" />
                        <TextBlock Text="{Binding Dashboard.StorageSummary}" Style="{StaticResource SpecValue}" ToolTip="{Binding Dashboard.StorageSummary}" />
                        <Button Style="{StaticResource Lzn.GhostButton}" HorizontalAlignment="Left" Padding="0,2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:ShellPages.Hardware}">
                            <TextBlock Text="Ver hardware →" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.AccentHover}" />
                        </Button>
                    </StackPanel>
                </Border>
            </controls:AdaptiveGridPanel>

            <!-- Ações rápidas -->
            <TextBlock Text="AÇÕES RÁPIDAS" Style="{StaticResource Lzn.Text.Overline}" Margin="2,22,0,10" />
            <controls:AdaptiveGridPanel MinItemWidth="260" MaxColumns="3" Spacing="12">
                <Border Style="{StaticResource Quick}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Ajustes recomendados" FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="SemiBold" />
                            <Border Style="{StaticResource Lzn.Badge.Accent}" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TweaksBadge}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.AccentText}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TweaksText}" Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,14" MinHeight="32" />
                        <Button Style="{StaticResource Lzn.PrimaryButton}" HorizontalAlignment="Left" Content="Revisar recomendados" Command="{Binding ReviewRecommendedCommand}"
                                ToolTip="Abre Ajustes do Windows com a seleção recomendada marcada. Nada é aplicado sem a sua revisão." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Quick}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Limpeza" FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="SemiBold" />
                            <Border Style="{StaticResource Lzn.Badge.Success}" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding CleanupBadge}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.RiskLow}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="Temporários, caches e logs que podem ser apagados. Arquivos em uso ficam onde estão." Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,14" MinHeight="32" />
                        <Button Style="{StaticResource Lzn.ToolbarButton}" HorizontalAlignment="Left" Content="Ver e limpar" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:ShellPages.Cleanup}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Quick}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Inicialização" FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="SemiBold" />
                            <Border Style="{StaticResource Lzn.Badge.Warn}" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding StartupBadge}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.RiskWarn}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="Programas que abrem sozinhos com o Windows. Desativar não desinstala." Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,14" MinHeight="32" />
                        <Button Style="{StaticResource Lzn.ToolbarButton}" HorizontalAlignment="Left" Content="Revisar" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:ShellPages.Startup}" />
                    </StackPanel>
                </Border>
            </controls:AdaptiveGridPanel>

            <!-- Últimas alterações e jogos -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Lzn.Panel}" Padding="0">
                    <StackPanel>
                        <Grid Margin="16,14,12,6">
                            <TextBlock Text="ÚLTIMAS ALTERAÇÕES" Style="{StaticResource Lzn.Text.Overline}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource Lzn.GhostButton}" HorizontalAlignment="Right" Padding="6,2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:ShellPages.Backups}">
                                <TextBlock Text="Ver histórico e desfazer →" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.AccentHover}" />
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RecentChanges}" Focusable="False" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:RecentChange}">
                                    <Grid Margin="16,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource Lzn.TextMuted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " Foreground="{StaticResource Lzn.TextMuted}" /><Run Text="{Binding Area, Mode=OneWay}" Foreground="{StaticResource Lzn.TextMuted}" FontSize="{StaticResource Lzn.FontSize.Caption}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource Lzn.Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="{Binding Outcome}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Lzn.RiskLow}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Nenhuma alteração registrada ainda." Style="{StaticResource Lzn.Text.Caption}" Margin="16,0,16,16"
                                   Visibility="{Binding HasRecentChanges, Converter={x:Static infra:VisibilityConverter.WhenFalse}}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Lzn.Panel}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="JOGOS ENCONTRADOS" Style="{StaticResource Lzn.Text.Overline}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding InstalledGames}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,3" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Nenhum jogo compatível encontrado." Style="{StaticResource Lzn.Text.Caption}"
                                   Visibility="{Binding HasInstalledGames, Converter={x:Static infra:VisibilityConverter.WhenFalse}}" />
                        <Button Style="{StaticResource Lzn.ToolbarButton}" HorizontalAlignment="Stretch" Margin="0,12,0,0" Content="Abrir Jogos"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:ShellPages.Games}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Sobre, discreto no rodapé -->
            <StackPanel Orientation="Horizontal" Margin="2,26,0,0">
                <Image Source="pack://application:,,,/LznTweaker;component/Assets/Brand/lzn-logo-mark.png" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logo do LZN Tweaker" />
                <TextBlock Style="{StaticResource Lzn.Text.Caption}" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Run Text="LZN Tweaker " /><Run Text="{Binding AppVersion, Mode=OneWay}" /><Run Text=" · ajustes com base técnica, reversíveis e registrados no Histórico · em desenvolvimento" />
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
