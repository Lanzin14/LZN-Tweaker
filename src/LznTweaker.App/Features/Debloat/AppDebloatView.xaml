<UserControl x:Class="LznTweaker.Features.Debloat.AppDebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:local="clr-namespace:LznTweaker.Features.Debloat"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <!-- Selo da categoria (cor de estado: patrocinado = seguro, sistema = atenção) -->
        <DataTemplate x:Key="CategoryBadge" DataType="{x:Type local:AppxItemViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="6" Height="6" Fill="{Binding BadgeBrush}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" />
            </StackPanel>
        </DataTemplate>

        <!-- Linha: caixa para marcar a remoção, nome, pacote e categoria -->
        <DataTemplate x:Key="AppRow" DataType="{x:Type local:AppxItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding IsQueued}" VerticalAlignment="Center" Margin="0,0,12,0"
                          ToolTip="Marcar para remover" AutomationProperties.Name="{Binding Title, StringFormat=Marcar {0} para remover}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FriendlyName}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Lzn.MonoFont}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource CategoryBadge}" Margin="14,0,0,0" />
            </Grid>
        </DataTemplate>

        <!-- Detalhe: se é seguro remover, pacote, versão e observações -->
        <DataTemplate x:Key="AppDetail" DataType="{x:Type local:AppxItemViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding FriendlyName}" Style="{StaticResource Lzn.Text.Section}" TextWrapping="Wrap" />
                <Border Style="{StaticResource Lzn.Badge}" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CategoryBadge}" />
                </Border>

                <TextBlock Text="É seguro remover?" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Text="{Binding SafetyText}" Style="{StaticResource Lzn.Text.Body}" TextWrapping="Wrap" />

                <StackPanel Visibility="{Binding Note, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                    <TextBlock Text="Observação" Style="{StaticResource Lzn.DetailLabel}" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Lzn.Text.Body}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="Como voltar" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Style="{StaticResource Lzn.Text.Body}" TextWrapping="Wrap"
                           Text="Em &quot;Removidos pelo LZN Tweaker&quot;, abaixo: o app é re-registrado quando os arquivos ainda existem; se não existirem, a volta é pela Microsoft Store." />
                <TextBlock Text="{Binding ProvisionedText}" Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding ProvisionedText, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />

                <TextBlock Text="Pacote" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBox Text="{Binding Name, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Lzn.MonoFont}" FontSize="{StaticResource Lzn.FontSize.Caption}"
                         Foreground="{StaticResource Lzn.TextSecondary}" Background="{StaticResource Lzn.SurfaceSunken}" BorderThickness="0" Padding="10,8"
                         AutomationProperties.Name="Nome do pacote" />
                <TextBlock Text="{Binding Version, StringFormat=Versão {0}}" Style="{StaticResource Lzn.Text.Caption}" Margin="0,6,0,0" />

                <Border BorderBrush="{StaticResource Lzn.Stroke}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,18,0,0">
                    <CheckBox Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding IsQueued}">
                        <TextBlock Text="Marcar para remover" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.Text}" />
                    </CheckBox>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Remover apps" Guide="{x:Static shell:CategoryGuides.Debloat}" Status="{Binding StatusText}">
            <Button Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Lzn.Glyph.Refresh}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Atualizar" FontSize="12" /></StackPanel>
            </Button>
        </controls:PageHeader>

        <StackPanel Grid.Row="1">
            <controls:Banner Problem="{Binding Problem}">
                <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Tentar de novo" Command="{Binding RefreshCommand}" />
            </controls:Banner>
            <controls:Banner Problem="{Binding AccountProblem}" />
        </StackPanel>

        <!-- Busca e seleção rápida -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource Lzn.SearchBox}" Height="36" Tag="Buscar app…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar app" />
            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding AddAllSponsoredCommand}"
                    ToolTip="Marca todos os apps patrocinados e pré-instalados da lista curada. Nada é removido até você confirmar.">
                <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Lzn.Glyph.Check}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Marcar patrocinados" FontSize="12" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Lzn.GhostButton}" Content="Desmarcar todos" Command="{Binding ClearQueueCommand}" Padding="10,6" />
            <CheckBox Grid.Column="3" Margin="12,0,0,0" Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding ShowOnlyQueued}" VerticalAlignment="Center">
                <TextBlock Text="Mostrar só os marcados" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.TextSecondary}" />
            </CheckBox>
            <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Lzn.Text.Caption}"
                       Text="{Binding Installed.Count, StringFormat={}{0} apps}" />
        </Grid>

        <controls:MasterDetailLayout Grid.Row="3" Selected="{Binding SelectedApp}" DetailTemplate="{StaticResource AppDetail}" CloseCommand="{Binding ClearSelectionCommand}"
                                     Placeholder="Selecione um app para ver se é seguro remover e como voltar.">
            <controls:MasterDetailLayout.Master>
                <Grid>
                    <ListBox x:Name="AppList" Style="{StaticResource Lzn.List}" ItemsSource="{Binding InstalledView}" SelectedItem="{Binding SelectedApp}"
                             ItemTemplate="{StaticResource AppRow}" AutomationProperties.Name="Aplicativos instalados"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Lzn.Text.Subtitle}" Margin="4,12,0,6" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                    <controls:EmptyState Glyph="{StaticResource Lzn.Glyph.Search}" Message="Nenhum app nesta lista. Se a leitura falhou, use Tentar de novo; se há filtro ou busca, limpe-os."
                                         Visibility="{Binding HasItems, ElementName=AppList, Converter={x:Static infra:VisibilityConverter.WhenFalse}}" />
                </Grid>
            </controls:MasterDetailLayout.Master>
        </controls:MasterDetailLayout>

        <!-- Lote: escopo, resumo e ação destrutiva -->
        <Border Grid.Row="4" Style="{StaticResource Lzn.Panel}" Padding="16,12" Margin="0,4,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding QueueSummary}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <CheckBox Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding RemoveForAllUsers}" Margin="0,8,0,0">
                        <TextBlock FontSize="{StaticResource Lzn.FontSize.Caption}" TextWrapping="Wrap" Foreground="{StaticResource Lzn.TextSecondary}">
                            Remover para todos os usuários <Run Text="(apaga os arquivos: a volta só é possível pela Microsoft Store)" Foreground="{StaticResource Lzn.RiskWarn}" />
                        </TextBlock>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Um ponto de restauração é criado antes de cada lote (obrigatório). Ele protege o restante do sistema, mas não reinstala apps da Store." />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Lzn.DangerButton}" Command="{Binding RemoveSelectedCommand}" VerticalAlignment="Center" Margin="16,0,0,0" Padding="16,9"
                        ToolTip="Marque ao menos um app. Pede confirmação e cria o ponto de restauração antes." ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Lzn.Glyph.Delete}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Remover marcados" /></StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Removidos pelo LZN Tweaker (lidos do histórico) -->
        <Border Grid.Row="5" Style="{StaticResource Lzn.Panel}" Padding="16,12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Removidos pelo LZN Tweaker" Style="{StaticResource Lzn.Text.Subtitle}" />
                        <TextBlock Text="Lidos do histórico. Marque os que deseja restaurar." Style="{StaticResource Lzn.Text.Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding RestoreCommand}"
                            ToolTip="Nenhum app removido pelo LZN Tweaker está pendente." ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Restaurar apps removidos" FontSize="12" /></StackPanel>
                    </Button>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="Nenhum app removido pelo LZN Tweaker está pendente." Style="{StaticResource Lzn.Text.Caption}"
                           Visibility="{Binding Removed.Count, Converter={x:Static infra:VisibilityConverter.WhenZero}}" />
                <ItemsControl ItemsSource="{Binding Removed}" MaxHeight="140" Focusable="False">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:RemovedAppxItemViewModel}">
                            <CheckBox Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding IsSelected}" Margin="0,3">
                                <StackPanel Margin="2,0,0,0">
                                    <TextBlock Text="{Binding FriendlyName}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.Text}" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Lzn.Text.Caption}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
