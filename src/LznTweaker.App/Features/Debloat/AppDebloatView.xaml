<UserControl x:Class="LznTweaker.Features.Debloat.AppDebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:local="clr-namespace:LznTweaker.Features.Debloat"
             Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <!-- Lista com aparência Windows 11: itens arredondados, seleção em destaque, rolagem interna. -->
        <Style x:Key="AppListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="10,7" BorderThickness="1" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentStrokeBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransferButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Linha de app com selo de categoria e InfoTip. -->
        <DataTemplate x:Key="AppRowTemplate" DataType="{x:Type local:AppxItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding FriendlyName}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding BadgeText}" Foreground="{Binding BadgeBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,8,0" />
                <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}" BorderThickness="1"
                        VerticalAlignment="Center" Cursor="Help" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="30000">
                    <Border.ToolTip>
                        <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                            <Border Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.AccentStroke}" BorderThickness="1" CornerRadius="10" Padding="12" MaxWidth="380">
                                <TextBlock Text="{Binding InfoTip}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" LineHeight="16" />
                            </Border>
                        </ToolTip>
                    </Border.ToolTip>
                    <TextBlock Text="{Binding IsSystem, Converter={x:Static local:InfoGlyphConverter.Instance}}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="Bold"
                               Foreground="{StaticResource Lzn.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <controls:PageHeader Title="Remover apps" Guide="{x:Static shell:CategoryGuides.Debloat}" Margin="0,0,0,14">
            <Button Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Lzn.Glyph.Refresh}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Atualizar" FontSize="12" /></StackPanel>
            </Button>
        </controls:PageHeader>

        <!-- Status e aviso de conta -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Background="{StaticResource Lzn.DangerSoft}" BorderBrush="{StaticResource Lzn.DangerStroke}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8"
                    Visibility="{Binding AccountWarning, Converter={x:Static local:NotNullToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding AccountWarning}" Foreground="{StaticResource Lzn.RiskHigh}" FontSize="12" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Painel de transferência -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Esquerda: instalados, agrupados por categoria -->
            <Border Style="{StaticResource CardStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Aplicativos instalados" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Installed.Count, StringFormat={}{0} apps}" />
                    </Grid>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="Buscar app…" Foreground="{StaticResource TextMutedBrush}" FontSize="12" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={x:Static local:EmptyToVisibilityConverter.Instance}}" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}" FontSize="12" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="InstalledList" Style="{StaticResource AppListStyle}" ItemsSource="{Binding InstalledView}"
                             ItemTemplate="{StaticResource AppRowTemplate}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="4,10,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Meio: setas de transferência -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                <Button Style="{StaticResource TransferButtonStyle}" Content="→" ToolTip="Mover selecionados para remoção"
                        Command="{Binding AddToQueueCommand}" CommandParameter="{Binding SelectedItems, ElementName=InstalledList}" />
                <Button Style="{StaticResource TransferButtonStyle}" Content="⇉" ToolTip="Mover todos os patrocinados" Command="{Binding AddAllSponsoredCommand}" />
                <Button Style="{StaticResource TransferButtonStyle}" Content="←" ToolTip="Devolver selecionados à lista de instalados"
                        Command="{Binding RemoveFromQueueCommand}" CommandParameter="{Binding SelectedItems, ElementName=QueueList}" />
                <Button Style="{StaticResource TransferButtonStyle}" Content="⇇" ToolTip="Esvaziar a lista de remoção" Command="{Binding ClearQueueCommand}" />
            </StackPanel>

            <!-- Direita: fila de remoção -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentStrokeBrush}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Selecionados para remoção" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Queue.Count, StringFormat={}{0} apps}" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <CheckBox Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding RemoveForAllUsers}" Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                Remover para todos os usuários <Run Text="(apaga os arquivos: a volta só é possível pela Microsoft Store)" Foreground="{StaticResource WarningBrush}" />
                            </TextBlock>
                        </CheckBox>
                        <TextBlock Text="{Binding QueueSummary}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox x:Name="QueueList" Style="{StaticResource AppListStyle}" ItemsSource="{Binding Queue}" ItemTemplate="{StaticResource AppRowTemplate}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Ação principal -->
        <Grid Grid.Row="3" Margin="0,14,0,14">
            <TextBlock Text="Um ponto de restauração é criado antes de cada lote (obrigatório). Ele protege o restante do sistema, mas não reinstala apps da Store."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,260,0" />
            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Remover selecionados"
                    Command="{Binding RemoveSelectedCommand}" Padding="18,10" />
        </Grid>

        <!-- Removidos pelo LznTweaker (lidos do histórico) -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Background="{StaticResource Lzn.Surface}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Removidos pelo LznTweaker" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Lidos do histórico. Marque os que deseja restaurar."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"
                            Content="Restaurar apps removidos" Command="{Binding RestoreCommand}" Padding="14,8" />
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="Nenhum app removido pelo LznTweaker está pendente." FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding Removed.Count, Converter={x:Static local:ZeroToVisibilityConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding Removed}" MaxHeight="160">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:RemovedAppxItemViewModel}">
                            <CheckBox Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding IsSelected}" Margin="0,3">
                                <StackPanel Margin="2,0,0,0">
                                    <TextBlock Text="{Binding FriendlyName}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Details}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
