<UserControl x:Class="LznTweaker.Features.Gpu.GpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:local="clr-namespace:LznTweaker.Features.Gpu"
             xmlns:core="clr-namespace:LznTweaker.Core.Gpu;assembly=LznTweaker.Core"
             xmlns:tabs="clr-namespace:LznTweaker.Features.TweakCards"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Lzn.Text.Overline}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Body}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="GuideLabel" TargetType="TextBlock" BasedOn="{StaticResource Lzn.Text.Overline}">
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="GuideText" TargetType="TextBlock" BasedOn="{StaticResource Lzn.Text.Body}">
            <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.BodySmall}" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <!-- Seção visível só quando a aba correspondente está ativa (Tag = propriedade booleana do ViewModel). -->
        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Linha de configuração do driver: nome, valor recomendado, estado e explicação expansível. -->
        <DataTemplate DataType="{x:Type local:DriverSettingViewModel}">
            <Border Background="Transparent" Padding="0,12" BorderBrush="{StaticResource Lzn.StrokeSubtle}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ManualPath}" Style="{StaticResource Lzn.Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <!-- Valor recomendado -->
                        <Border Grid.Column="1" Style="{StaticResource Lzn.Badge.Accent}" Margin="0,0,14,0" MaxWidth="240" ToolTip="{Binding RecommendedValue}">
                            <TextBlock Text="{Binding RecommendedValue}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.AccentText}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="6" Height="6" Fill="{Binding StateBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" TextWrapping="Wrap" MaxWidth="170" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Lzn.GhostButton}" ToolTip="O que faz, efeitos e como restaurar" AutomationProperties.Name="Detalhes"
                                    Command="{Binding DataContext.ToggleDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <TextBlock Text="&#xE946;" Style="{StaticResource Lzn.Icon}" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Explicação expandida -->
                    <Border Margin="0,10,0,0" Padding="14,4,14,12" Background="{StaticResource Lzn.SurfaceSunken}" CornerRadius="{StaticResource Lzn.Radius.Md}"
                            Visibility="{Binding IsExpanded, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                        <controls:AdaptiveGridPanel MinItemWidth="260" MaxColumns="2" Spacing="18">
                            <StackPanel>
                                <TextBlock Text="O que faz" Style="{StaticResource GuideLabel}" />
                                <TextBlock Text="{Binding Guide.WhatItDoes}" Style="{StaticResource GuideText}" />
                                <TextBlock Text="Benefício esperado" Style="{StaticResource GuideLabel}" />
                                <TextBlock Text="{Binding Guide.Benefit}" Style="{StaticResource GuideText}" />
                                <TextBlock Text="Possíveis desvantagens" Style="{StaticResource GuideLabel}" />
                                <TextBlock Text="{Binding Guide.Downsides}" Style="{StaticResource GuideText}" />
                                <TextBlock Text="Quando usar" Style="{StaticResource GuideLabel}" />
                                <TextBlock Text="{Binding Guide.WhenToUse}" Style="{StaticResource GuideText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Compatibilidade" Style="{StaticResource GuideLabel}" />
                                <TextBlock Text="{Binding Guide.Compatibility}" Style="{StaticResource GuideText}" />
                                <TextBlock Text="Forma de aplicação" Style="{StaticResource GuideLabel}" />
                                <TextBlock Style="{StaticResource GuideText}"><Run Text="{Binding MethodText, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding ManualPath, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="Como restaurar" Style="{StaticResource GuideLabel}" />
                                <TextBlock Text="{Binding Guide.HowToRestore}" Style="{StaticResource GuideText}" />
                                <TextBlock Text="Valor atual" Style="{StaticResource GuideLabel}" />
                                <TextBlock Text="{Binding CurrentValueText}" Style="{StaticResource GuideText}" />
                                <TextBlock Text="{Binding Caution}" Style="{StaticResource GuideText}" Foreground="{StaticResource Lzn.RiskWarn}" Margin="0,10,0,0"
                                           Visibility="{Binding Caution, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                            </StackPanel>
                        </controls:AdaptiveGridPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Ícone do jogo: arte local do Steam ou monograma. -->
        <DataTemplate x:Key="GameIcon" DataType="{x:Type local:GpuGameViewModel}">
            <Grid Width="36" Height="36">
                <Border CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.AccentSoft}"
                        Visibility="{Binding HasIcon, Converter={x:Static infra:VisibilityConverter.WhenFalse}}">
                    <TextBlock Text="{Binding ShortName}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="Bold" Foreground="{StaticResource Lzn.AccentText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- Cantos arredondados por recorte: um ImageBrush ficaria fora da árvore visual e geraria erro de binding. -->
                <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasIcon, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                    <Image.Clip><RectangleGeometry Rect="0,0,36,36" RadiusX="8" RadiusY="8" /></Image.Clip>
                </Image>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28">
            <!-- Cabeçalho -->
            <Grid Margin="0,0,0,16">
                <StackPanel Margin="0,0,360,0">
                    <TextBlock Text="Placa de Vídeo" Style="{StaticResource Lzn.Text.Title}" />
                    <controls:CategoryInfo Guide="{x:Static shell:CategoryGuides.Gpu}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding DetectCommand}" Margin="0,0,8,0" ToolTip="Ler novamente a placa, o driver e o monitor">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Atualizar detecção" FontSize="{StaticResource Lzn.FontSize.BodySmall}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Lzn.ToolbarButton}" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Não há o que restaurar: o LZN Tweaker ainda não alterou nenhuma configuração de GPU. Os ajustes desta página são feitos por você no driver ou no jogo; cada item explica como voltar ao valor anterior.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Restaurar alterações" FontSize="{StaticResource Lzn.FontSize.BodySmall}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Placa detectada: modelo e estado; detalhes técnicos em "Saiba mais" (começa recolhido) -->
            <Border Style="{StaticResource Lzn.Panel}" Padding="18,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.AccentSoft}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Lzn.Icon}" FontSize="16" Foreground="{StaticResource Lzn.AccentHover}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding ModelText}" FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" ToolTip="{Binding ModelText}" />
                        <Border Grid.Column="2" Style="{StaticResource Lzn.Badge}" Margin="12,0,10,0" VerticalAlignment="Center" ToolTip="Estado da detecção da placa de vídeo">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="7" Height="7" Fill="{Binding DetectionBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding DetectionText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{Binding DetectionBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="3" Style="{StaticResource Lzn.GhostButton}" Command="{Binding ToggleOverviewCommand}" VerticalAlignment="Center"
                                AutomationProperties.Name="Saiba mais sobre a placa de vídeo">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Saiba mais" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.AccentText}" />
                                <TextBlock FontSize="10" Foreground="{StaticResource Lzn.AccentText}" Margin="7,1,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Lzn.Icon}">
                                            <Setter Property="Text" Value="&#xE70D;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverviewExpanded}" Value="True">
                                                    <Setter Property="Text" Value="&#xE70E;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel Margin="0,14,0,2" Visibility="{Binding IsOverviewExpanded, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                        <Border Height="1" Background="{StaticResource Lzn.StrokeSubtle}" Margin="0,0,0,14" />
                        <controls:AdaptiveGridPanel MinItemWidth="190" MaxColumns="4" Spacing="16">
                            <StackPanel><TextBlock Text="Fabricante" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding VendorText}" Style="{StaticResource FieldValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="Driver instalado" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding DriverPackageText}" Style="{StaticResource FieldValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="Versão do driver" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding DriverVersionText}" Style="{StaticResource FieldValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="Data do driver" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding DriverDateText}" Style="{StaticResource FieldValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="Memória dedicada" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding MemoryText}" Style="{StaticResource FieldValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="Taxa de atualização" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding RefreshRateText}" Style="{StaticResource FieldValue}" /></StackPanel>
                        </controls:AdaptiveGridPanel>
                        <TextBlock Text="{Binding DetectionDetail}" Style="{StaticResource Lzn.Text.Caption}" Margin="0,12,0,0"
                                   Visibility="{Binding DetectionDetail, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                        <TextBlock Text="{Binding AutomationNote}" Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,12,0,0" MaxWidth="900" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Abas -->
            <ItemsControl ItemsSource="{Binding Tabs}" Margin="0,18,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type tabs:CardTabViewModel}">
                        <RadioButton Style="{StaticResource Lzn.Tab}" GroupName="GpuTabs" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,7,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Body}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding SelectedTabDescription}" Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" Margin="4,8,0,0"
                       Visibility="{Binding SelectedTabDescription, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
            <Border Height="12" />

            <!-- NVIDIA -->
            <StackPanel Style="{StaticResource Section}" Visibility="{Binding IsNvidiaTab, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                <TextBlock Text="{Binding NvidiaBanner}" Style="{StaticResource Lzn.Text.Body}" Margin="0,0,0,10" />
                <Border Style="{StaticResource Lzn.Panel}" Padding="18,4">
                    <ItemsControl ItemsSource="{Binding NvidiaSettings}" Focusable="False" />
                </Border>
            </StackPanel>

            <!-- AMD -->
            <StackPanel Style="{StaticResource Section}" Visibility="{Binding IsAmdTab, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                <TextBlock Text="{Binding AmdBanner}" Style="{StaticResource Lzn.Text.Body}" Margin="0,0,0,10" />
                <Border Style="{StaticResource Lzn.Panel}" Padding="18,4">
                    <ItemsControl ItemsSource="{Binding AmdSettings}" Focusable="False" />
                </Border>
            </StackPanel>

            <!-- Perfis por jogo -->
            <Grid Visibility="{Binding IsGamesTab, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Games}" Focusable="False" Margin="0,0,14,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:GpuGameViewModel}">
                            <Button Margin="0,0,0,8" HorizontalContentAlignment="Stretch" Padding="10,8" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Lzn.ToolbarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Lzn.AccentSoft}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Lzn.AccentStroke}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GameIcon}" />
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" Foreground="{StaticResource Lzn.Text}" />
                                        <TextBlock Text="{Binding InstalledText}" Style="{StaticResource Lzn.Text.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Column="1" Style="{StaticResource Lzn.Panel}" Padding="20,18" DataContext="{Binding SelectedGame}"
                        Visibility="{Binding Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GameIcon}" />
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Lzn.Text.Section}" />
                                    <TextBlock Text="{Binding InstalledText}" Style="{StaticResource Lzn.Text.Caption}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Aplicar perfil" IsEnabled="False" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Aplicação automática não suportada: o LZN Tweaker não altera arquivos do jogo nem do driver. Configure pelo menu do jogo usando a tabela abaixo." />
                                <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Restaurar" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Nada a restaurar: nenhuma configuração deste jogo foi alterada pelo app. Para voltar, use o preset padrão no menu do jogo." />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,14,0,0">
                            <Border Style="{StaticResource Lzn.Badge}" Margin="0,0,8,6">
                                <TextBlock FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}">
                                    <Run Text="GPU: " /><Run Text="{Binding DataContext.VendorText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Lzn.Badge}" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="6" Height="6" Fill="{Binding StateBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding StateText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{Binding StateBrush}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Driver -->
                        <TextBlock Text="Recomendações do driver" Style="{StaticResource Lzn.Text.Subtitle}" Margin="0,16,0,8" />
                        <ItemsControl ItemsSource="{Binding VendorAdvice}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:VendorAdviceRow}">
                                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.SurfaceSunken}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0.7" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDetectedVendor}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock FontSize="{StaticResource Lzn.FontSize.BodySmall}" TextWrapping="Wrap">
                                                <Run Text="{Binding Vendor, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{StaticResource Lzn.TextMuted}" /><Run Text="{Binding Recommendation, Mode=OneWay}" Foreground="{StaticResource Lzn.AccentText}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource GuideText}" Margin="0,4,0,0" />
                                            <TextBlock Text="Apenas consulta: não se aplica à GPU instalada." Style="{StaticResource Lzn.Text.Caption}" Margin="0,4,0,0"
                                                       Visibility="{Binding IsDetectedVendor, Converter={x:Static infra:VisibilityConverter.WhenFalse}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Opções do jogo -->
                        <Grid Margin="0,16,0,6">
                            <StackPanel>
                                <TextBlock Text="Opções gráficas no jogo" Style="{StaticResource Lzn.Text.Subtitle}" />
                                <TextBlock Text="{Binding MenuPath}" Style="{StaticResource Lzn.Text.Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource Lzn.ToggleSwitch}" IsChecked="{Binding KeepVisibility}" AutomationProperties.Name="Priorizar visibilidade" />
                                <TextBlock Text="Priorizar visibilidade" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           ToolTip="Mantém em qualidade maior as opções que ajudam a enxergar inimigos; as demais continuam no LOW." />
                            </StackPanel>
                        </Grid>
                        <Border CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.SurfaceSunken}" Padding="12,4" Grid.IsSharedSizeScope="True">
                            <ItemsControl ItemsSource="{Binding Settings}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:GameSettingRow}">
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingName" MinWidth="200" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingValue" MinWidth="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                <TextBlock Text="&#xE890;" Style="{StaticResource Lzn.Icon}" FontSize="11" Foreground="{StaticResource Lzn.Info}" Margin="0,0,6,0" ToolTip="Mantido em qualidade maior pela visibilidade"
                                                           Visibility="{Binding KeepsQualityForVisibility, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" />
                                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" FontWeight="SemiBold" Foreground="{StaticResource Lzn.AccentText}" Margin="0,0,16,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource Lzn.Text.Caption}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="Limite de FPS" Style="{StaticResource GuideLabel}" Margin="0,16,0,2" />
                        <TextBlock Text="{Binding FpsCapAdvice}" Style="{StaticResource GuideText}" />
                        <TextBlock Text="Como testar" Style="{StaticResource GuideLabel}" />
                        <TextBlock Text="{Binding TestAdvice}" Style="{StaticResource GuideText}" />
                        <TextBlock Text="{Binding Caveat}" Style="{StaticResource GuideText}" Foreground="{StaticResource Lzn.RiskWarn}" Margin="0,10,0,0"
                                   Visibility="{Binding Caveat, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Monitor e Latência -->
            <StackPanel Style="{StaticResource Section}" Visibility="{Binding IsMonitorTab, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                <Border Style="{StaticResource Lzn.Panel}" Padding="18,16">
                    <StackPanel>
                        <controls:AdaptiveGridPanel MinItemWidth="260" MaxColumns="2" Spacing="18">
                            <StackPanel>
                                <TextBlock Text="Taxa de atualização" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding RefreshRateText}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="G-SYNC / FreeSync (VRR)" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="O Windows não informa com segurança se o VRR está ativo. Confirme você:" Style="{StaticResource Lzn.Text.Caption}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource Lzn.Tab}" GroupName="Vrr" IsChecked="{Binding VrrAvailable, Mode=OneWay}" Command="{Binding SetVrrCommand}" CommandParameter="Available" Content="Tenho e uso VRR" />
                                    <RadioButton Style="{StaticResource Lzn.Tab}" GroupName="Vrr" IsChecked="{Binding VrrNotAvailable, Mode=OneWay}" Command="{Binding SetVrrCommand}" CommandParameter="NotAvailable" Content="Não tenho ou não uso" />
                                    <RadioButton Style="{StaticResource Lzn.Tab}" GroupName="Vrr" IsChecked="{Binding VrrNotAnswered, Mode=OneWay}" Command="{Binding SetVrrCommand}" CommandParameter="NotAnswered" Content="Não sei" />
                                </WrapPanel>
                            </StackPanel>
                        </controls:AdaptiveGridPanel>
                        <TextBlock Text="{Binding CapAdvice}" Style="{StaticResource Lzn.Text.Body}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Scenarios}" Margin="0,12,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="320" MaxColumns="2" Spacing="12" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:GpuLatencyScenario}">
                            <Border Style="{StaticResource Lzn.Panel}" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Subtitle}" />
                                    <TextBlock Text="{Binding Goal}" Style="{StaticResource GuideText}" Margin="0,4,0,8" />
                                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Ellipse Width="4" Height="4" Fill="{StaticResource Lzn.AccentHover}" VerticalAlignment="Top" Margin="0,7,0,0" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource GuideText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Tradeoff}" Style="{StaticResource Lzn.Text.Caption}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
