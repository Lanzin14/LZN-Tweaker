<UserControl x:Class="LznTweaker.Features.GameProfiles.DeadlockTuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LznTweaker.Features.GameProfiles"
             Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Card de perfil selecionável (RadioButton com aparência de cartão, estilo Windows 11). -->
        <Style x:Key="ProfileCardStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="18" Height="18" CornerRadius="9" BorderThickness="2"
                                        BorderBrush="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,12,0">
                                    <Ellipse x:Name="DotFill" Width="8" Height="8" Fill="{StaticResource AccentHoverBrush}" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="DotFill" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ícone "?" com tooltip detalhado. -->
        <Style x:Key="InfoTipStyle" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#251F33" />
            <Setter Property="BorderBrush" Value="#382E4D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="120" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,32,32" MaxWidth="980" HorizontalAlignment="Left">

            <!-- Cabeçalho -->
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="PERFIS DE JOGOS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="Deadlock" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="Substitui o gameinfo.gi do jogo por um perfil do OptimizationLock, guardando o original para o Desfazer."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <TextBlock Text="ARQUIVO DO JOGO · REVERSÍVEL" Foreground="{StaticResource AccentTextBrush}" FontSize="9" FontWeight="Bold" />
                </Border>
            </Grid>

            <!-- Instalação -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Instalação" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding InstallationText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Installation.GameInfoPath, StringFormat=Arquivo: {0}}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding IsInstallationFound, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="↻ Detectar" Command="{Binding DetectCommand}" Padding="12,8" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="📁 Escolher pasta" Command="{Binding BrowseCommand}" Padding="12,8" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Estado atual -->
            <Border Style="{StaticResource CardStyle}" Background="#161220">
                <StackPanel>
                    <TextBlock Text="Estado da configuração" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastResultText}" Foreground="{StaticResource AccentTextBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Perfis -->
            <TextBlock Text="PERFIS DE OTIMIZAÇÃO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="2,4,0,10" />
            <ItemsControl ItemsSource="{Binding Profiles}" IsEnabled="{Binding IsInstallationFound}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:DeadlockProfileOption}">
                        <RadioButton Style="{StaticResource ProfileCardStyle}" GroupName="DeadlockProfiles" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Border Background="#13261C" BorderBrush="#234837" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0"
                                                VerticalAlignment="Center" Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="APLICADO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Warning, StringFormat=⚠ {0}}" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,5,0,0"
                                               TextWrapping="Wrap" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource LinkButtonStyle}" Content="Ver arquivo no GitHub ↗" HorizontalAlignment="Left" Margin="0,7,0,0"
                                            Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding RiskText}" Foreground="{Binding RiskBrush}" FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Border Style="{StaticResource InfoTipStyle}">
                                        <Border.ToolTip>
                                            <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                                                <Border Background="#161220" BorderBrush="#3D3056" BorderThickness="1" CornerRadius="10" Padding="14" MaxWidth="420">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                                        <TextBlock Text="{Binding InfoTip}" FontSize="11" Foreground="#C8BFD7" TextWrapping="Wrap" LineHeight="16" />
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="11" FontWeight="Bold" Foreground="#BFAEDF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Avisos -->
            <Border Style="{StaticResource CardStyle}" Background="#1F192D" BorderBrush="#362A50" Margin="0,4,0,14">
                <StackPanel>
                    <TextBlock Text="Antes de aplicar" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentTextBrush}" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0">
                        • Feche o Deadlock. Toda atualização grande do jogo reinstala o gameinfo.gi; depois de um patch, reaplique o perfil.<LineBreak />
                        • O jogo exibe um aviso de que pode bloquear o matchmaking com ConVars alteradas no gameinfo.gi; segundo o autor, isso ainda não é aplicado.<LineBreak />
                        • Os perfis são do projeto OptimizationLock (GPL-3.0) e são baixados do GitHub do autor no momento da aplicação. Ganhos de FPS variam por hardware e não são garantidos.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Ações -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource LinkButtonStyle}" Content="Projeto OptimizationLock ↗" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Command="{Binding OpenSourceCommand}" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="↺ Desfazer" Command="{Binding UndoCommand}" Padding="16,10" Margin="0,0,9,0" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="⚡ Aplicar perfil selecionado" Command="{Binding ApplyCommand}" Padding="18,10" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
