<UserControl x:Class="LznTweaker.Features.GameProfiles.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:local="clr-namespace:LznTweaker.Features.GameProfiles"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{DynamicResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisualInset}" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Row" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="10,7" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="2" Background="{DynamicResource Lzn.Accent}" Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Lzn.SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Lzn.Sidebar.Active}" />
                                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Logotipo do Windows desenhado em vetor (quatro painéis), na cor do texto atual. -->
        <Geometry x:Key="WindowsLogo">M0,0 H7.4 V7.4 H0 Z M8.6,0 H16 V7.4 H8.6 Z M0,8.6 H7.4 V16 H0 Z M8.6,8.6 H16 V16 H8.6 Z</Geometry>

        <Style x:Key="TabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Lzn.TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,22,12" Background="Transparent" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" Margin="0,8,0,10" TextElement.FontWeight="Medium" />
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="1" Background="{DynamicResource Lzn.Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Lzn.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.ColumnSpan="2">
        <controls:PageHeader Title="Jogos" Guide="{x:Static shell:CategoryGuides.Games}" Status="{Binding StatusText}" Margin="0,0,0,14">
            <Button Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Lzn.Glyph.Refresh}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Atualizar" FontSize="12" /></StackPanel>
            </Button>
        </controls:PageHeader>
        <controls:Banner Problem="{Binding Problem}" Margin="0,0,0,14">
            <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Tentar de novo" Command="{Binding RefreshCommand}" />
        </controls:Banner>
        </StackPanel>

        <!-- Seções -->
        <ListBox Grid.Row="1" Style="{StaticResource SectionListStyle}" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:LibrarySection}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Ícone: arte local do jogo, logotipo do Windows, monograma ou glifo -->
                        <Grid Width="36" Height="36" VerticalAlignment="Center">
                            <!-- Cantos arredondados por recorte: um ImageBrush ficaria fora da árvore visual e geraria erro de binding. -->
                            <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                                <Image.Clip><RectangleGeometry Rect="0,0,36,36" RadiusX="8" RadiusY="8" /></Image.Clip>
                            </Image>
                            <Border CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{DynamicResource Lzn.SurfaceRaised}"
                                    Visibility="{Binding ShowsWindowsLogo, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                                <Path Data="{StaticResource WindowsLogo}" Fill="{DynamicResource Lzn.Info}" Width="16" Height="16" Stretch="Uniform" />
                            </Border>
                            <Border CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{DynamicResource Lzn.SurfaceRaised}"
                                    Visibility="{Binding ShowsMonogram, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                                <TextBlock Text="&#xE7FC;" Style="{StaticResource Lzn.Icon}" FontSize="16" Foreground="{DynamicResource Lzn.TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{DynamicResource Lzn.SurfaceRaised}"
                                    Visibility="{Binding ShowsGlyph, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" FontSize="16" Foreground="{DynamicResource Lzn.AccentHover}" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="Medium" Foreground="{DynamicResource Lzn.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Lzn.Text.Caption}"
                                       Visibility="{Binding Subtitle, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                        </StackPanel>
                        <!-- Plataformas compatíveis, lado a lado e com o mesmo tamanho -->
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Platforms}" VerticalAlignment="Center" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PlatformBadge}">
                                    <Grid Width="18" Height="18" Margin="4,0,0,0" ToolTip="{Binding Name}" Background="Transparent" AutomationProperties.Name="{Binding Name}">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" />
                                        <Path Data="{StaticResource WindowsLogo}" Fill="{DynamicResource Lzn.TextSecondary}" Width="13" Height="13" Stretch="Uniform"
                                              Visibility="{Binding IsWindows, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" />
                                        <Border CornerRadius="4" Background="{DynamicResource Lzn.SurfaceActive}"
                                                Visibility="{Binding ShowsInitial, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                                            <TextBlock Text="{Binding Initial}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="Bold" Foreground="{DynamicResource Lzn.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Página genérica (Windows, Steam, CS2, VALORANT, Overwatch 2, Hardware) -->
        <local:GameOptimizationPageView Grid.Row="1" Grid.Column="1" Margin="20,0,0,0" DataContext="{Binding SelectedSection.Page}"
                                        Visibility="{Binding DataContext.SelectedSection.IsDeadlock, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}" />

        <!-- Deadlock: a página existente do gameinfo.gi é preservada como primeira aba -->
        <TabControl Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" Background="Transparent" BorderThickness="0" Padding="0"
                    Visibility="{Binding SelectedSection.IsDeadlock, Converter={StaticResource BoolToVisibility}}">
            <TabItem Header="Perfil gameinfo.gi" Style="{StaticResource TabStyle}">
                <ContentControl x:Name="DeadlockProfileHost" />
            </TabItem>
            <TabItem Header="Ajustes compartilhados" Style="{StaticResource TabStyle}">
                <local:GameOptimizationPageView DataContext="{Binding SelectedSection.Page}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
