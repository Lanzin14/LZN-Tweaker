<UserControl x:Class="LznTweaker.Features.GameProfiles.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LznTweaker.Features.GameProfiles"
             Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" CornerRadius="9" Padding="11,9" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#1F192C" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentStrokeBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Padding="14,7" Margin="0,0,6,10" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource StrokeBrush}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentStrokeBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.ColumnSpan="2" Margin="0,0,0,14">
            <StackPanel Margin="0,0,140,0">
                <TextBlock Text="OTIMIZAÇÃO POR JOGO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="Biblioteca de jogos" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SecondaryButtonStyle}" Content="↻ Atualizar"
                    Command="{Binding RefreshCommand}" Padding="12,8" />
        </Grid>

        <!-- Seções -->
        <ListBox Grid.Row="1" Style="{StaticResource SectionListStyle}" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:LibrarySection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" FontSize="15" Width="26" VerticalAlignment="Center" Foreground="{StaticResource AccentHoverBrush}" />
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Página genérica (Windows, Steam, CS2, VALORANT, Overwatch 2, Hardware) -->
        <local:GameOptimizationPageView Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" DataContext="{Binding SelectedSection.Page}"
                                        Visibility="{Binding DataContext.SelectedSection.IsDeadlock, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}" />

        <!-- Deadlock: a página existente do gameinfo.gi é preservada como primeira aba -->
        <TabControl Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" Background="Transparent" BorderThickness="0" Padding="0"
                    Visibility="{Binding SelectedSection.IsDeadlock, Converter={StaticResource BoolToVisibility}}">
            <TabItem Header="Perfil gameinfo.gi" Style="{StaticResource TabStyle}">
                <ContentControl x:Name="DeadlockProfileHost" />
            </TabItem>
            <TabItem Header="Ajustes compartilhados" Style="{StaticResource TabStyle}">
                <local:GameOptimizationPageView DataContext="{Binding SelectedSection.Page}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
