<UserControl x:Class="LznTweaker.Features.GameProfiles.GameOptimizationPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LznTweaker.Features.GameProfiles"
             xmlns:core="clr-namespace:LznTweaker.Core.GameOptimization;assembly=LznTweaker.Core"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- Título de seção da página do jogo: mesmo estilo dos cabeçalhos de grupo das outras páginas. -->
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Lzn.Text.Subtitle}">
            <Setter Property="Margin" Value="2,18,0,8" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource Lzn.StrokeStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,6,6,0" />
        </Style>
        <!-- Linha de configuração do Fortnite: nome, valor, função curta, observação e origem. -->
        <DataTemplate DataType="{x:Type local:RecommendedSettingViewModel}">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FnName" MinWidth="200" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FnValue" MinWidth="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FnEvidence" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Top" TextWrapping="Wrap" MaxWidth="220" />
                <Border Grid.Column="1" Style="{StaticResource Lzn.Badge.Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,14,0" MaxWidth="220">
                    <TextBlock Text="{Binding Value}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.AccentText}" TextWrapping="Wrap" />
                </Border>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Purpose}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Lzn.Text.Caption}" Margin="0,2,0,0"
                               Visibility="{Binding Note, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                </StackPanel>
                <Border Grid.Column="3" VerticalAlignment="Top" HorizontalAlignment="Right" CornerRadius="4" Padding="6,1" BorderThickness="1" BorderBrush="{Binding EvidenceBrush}">
                    <TextBlock Text="{Binding EvidenceText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{Binding EvidenceBrush}" />
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FnNoteTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" Style="{StaticResource Lzn.Icon}" FontSize="11" Foreground="{StaticResource Lzn.Info}" VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0,12,24">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Section}" />
            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DetectionText}" Foreground="{StaticResource AccentTextBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />

            <!-- Configurações recomendadas (CS2): instruções manuais, nada é aplicado pelo app -->
            <StackPanel Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVisibility}}" Margin="0,18,0,4">
                <Grid>
                    <TextBlock Text="Configurações recomendadas" Style="{StaticResource Lzn.Text.Subtitle}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Lzn.Badge.Warn}" HorizontalAlignment="Right">
                        <TextBlock Text="Instruções manuais" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.RiskWarn}" />
                    </Border>
                </Grid>
                <TextBlock Text="Siga os passos na ordem. O LZN Tweaker não aplica nem verifica estes ajustes." Style="{StaticResource Lzn.Text.Caption}" Margin="0,3,0,0" />

                <!-- 1. Gerenciador de Tarefas -->
                <Border Style="{StaticResource Lzn.Panel}" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Lzn.AccentSoft}" Margin="0,0,10,0">
                                <TextBlock Text="1" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" Foreground="{StaticResource Lzn.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Gerenciador de Tarefas" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TaskManagerSteps}" Focusable="False" Margin="32,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ProcedureView}">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" FontWeight="SemiBold" Foreground="{StaticResource Lzn.Text}" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:NumberedStep}">
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Number, StringFormat={}{0}.}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.AccentHover}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,8,0,0" Visibility="{Binding Warning, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Lzn.Icon}" FontSize="12" Foreground="{StaticResource Lzn.RiskWarn}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Warning}" Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.RiskWarn}" LineHeight="16" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 2. Vídeo e desempenho -->
                <Border Style="{StaticResource Lzn.Panel}" Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Lzn.AccentSoft}" Margin="0,0,10,0">
                                <TextBlock Text="2" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" Foreground="{StaticResource Lzn.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Vídeo e desempenho" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Lzn.Text.Caption}" Margin="32,4,0,6">
                            <Run Text="Onde: " /><Run Text="{Binding VideoMenuPath, Mode=OneWay}" Foreground="{StaticResource Lzn.TextSecondary}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding VideoSettings}" Focusable="False" Margin="32,0,0,0" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:InGameSetting}">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Cs2Name" MinWidth="210" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Cs2Value" MinWidth="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Top" />
                                        <Border Grid.Column="1" Style="{StaticResource Lzn.Badge.Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Value}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.AccentText}" />
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Purpose}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Dependency}" Style="{StaticResource Lzn.Text.Caption}" Margin="0,2,0,0"
                                                       Visibility="{Binding Dependency, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 3. Avisos e compatibilidade -->
                <ItemsControl ItemsSource="{Binding RecommendationNotes}" Focusable="False" Margin="4,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE946;" Style="{StaticResource Lzn.Icon}" FontSize="11" Foreground="{StaticResource Lzn.Info}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Fortnite: instruções manuais. Perfil de vídeo e fabricante da placa escolhidos pelo usuário (nada é detectado nem aplicado). -->
            <StackPanel Visibility="{Binding IsFortnite, Converter={StaticResource BoolToVisibility}}" Margin="0,18,0,4">
                <Grid>
                    <TextBlock Text="Configurações recomendadas" Style="{StaticResource Lzn.Text.Subtitle}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Lzn.Badge.Warn}" HorizontalAlignment="Right">
                        <TextBlock Text="Instruções manuais" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.RiskWarn}" />
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource Lzn.Text.Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="O LZN Tweaker não aplica nem verifica estes ajustes. Origem de cada linha: Oficial (Epic, NVIDIA ou AMD), Técnica, Comunidade ou Experimental (teste e volte se piorar)." />

                <!-- 1. Configurações gerais (vídeo do jogo) -->
                <Border Style="{StaticResource Lzn.Panel}" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Lzn.AccentSoft}" Margin="0,0,10,0">
                                <TextBlock Text="1" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" Foreground="{StaticResource Lzn.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Configurações gerais: vídeo do jogo" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Lzn.Text.Caption}" Margin="32,4,0,0" TextWrapping="Wrap">
                            <Run Text="Onde: " /><Run Text="{Binding FortniteVideoMenuPath, Mode=OneWay}" Foreground="{StaticResource Lzn.TextSecondary}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="32,10,0,0">
                            <RadioButton Style="{StaticResource Lzn.Tab}" GroupName="FnProfile" IsChecked="{Binding UsesPerformanceMode}" AutomationProperties.Name="Perfil competitivo, Modo Desempenho">
                                <TextBlock Text="Competitivo · Modo Desempenho" FontSize="{StaticResource Lzn.FontSize.BodySmall}" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource Lzn.Tab}" GroupName="FnProfile" IsChecked="{Binding UsesDirectX12}" AutomationProperties.Name="Perfil alternativo, DirectX 12">
                                <TextBlock Text="Alternativo · DirectX 12" FontSize="{StaticResource Lzn.FontSize.BodySmall}" />
                            </RadioButton>
                        </StackPanel>
                        <TextBlock Text="{Binding FortniteProfileSummary}" Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" Margin="32,8,0,4" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding FortniteVideoSettings}" Focusable="False" Margin="32,0,0,0" Grid.IsSharedSizeScope="True" />
                        <ItemsControl ItemsSource="{Binding FortniteVideoNotes}" ItemTemplate="{StaticResource FnNoteTemplate}" Focusable="False" Margin="32,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 2. Placa de vídeo: NVIDIA ou AMD, escolha manual -->
                <Border Style="{StaticResource Lzn.Panel}" Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Lzn.AccentSoft}" Margin="0,0,10,0">
                                <TextBlock Text="2" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" Foreground="{StaticResource Lzn.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Placa de vídeo: escolha a fabricante" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="32,10,0,0">
                            <RadioButton Style="{StaticResource Lzn.Tab}" GroupName="FnVendor" IsChecked="{Binding IsNvidiaChosen}" AutomationProperties.Name="Placa NVIDIA">
                                <TextBlock Text="NVIDIA" FontSize="{StaticResource Lzn.FontSize.BodySmall}" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource Lzn.Tab}" GroupName="FnVendor" IsChecked="{Binding IsAmdChosen}" AutomationProperties.Name="Placa AMD">
                                <TextBlock Text="AMD" FontSize="{StaticResource Lzn.FontSize.BodySmall}" />
                            </RadioButton>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding FortniteGpuNotes}" ItemTemplate="{StaticResource FnNoteTemplate}" Focusable="False" Margin="32,8,0,0" />
                        <StackPanel Visibility="{Binding HasGpuChoice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Lzn.Text.Caption}" Margin="32,8,0,4" TextWrapping="Wrap">
                                <Run Text="Onde: " /><Run Text="{Binding GpuMenuPath, Mode=OneWay}" Foreground="{StaticResource Lzn.TextSecondary}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding GpuSettings}" Focusable="False" Margin="32,0,0,0" Grid.IsSharedSizeScope="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Lzn.Text.Caption}" Margin="4,10,0,0" TextWrapping="Wrap"
                           Text="3. Argumentos de inicialização, texturas de alta resolução, segundo plano, travadas e rede ficam em Orientações, no fim da página." />
            </StackPanel>

            <!-- Ações automáticas -->
            <StackPanel Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Ações: marque e clique em Executar selecionados" />
                <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:OptimizationActionViewModel}">
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding State}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Risk, StringFormat=Risco {0}}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" /></Border>
                                            <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding GamesAffected, StringFormat=Afeta: {0}}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" /></Border>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                                            <Run Text="{Binding Prerequisites, Mode=OneWay, StringFormat=Antes: {0}}" /><Run Text=" · " /><Run Text="{Binding Reversibility, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,4,0,0">
                    <TextBlock Text="{Binding RunSummary}" Foreground="{StaticResource AccentTextBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,220,0" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource Lzn.PrimaryButton}" Content="Executar selecionados" Command="{Binding RunCommand}" />
                </Grid>
            </StackPanel>

            <!-- Backups -->
            <StackPanel Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Backups feitos pelo app" />
                <ItemsControl ItemsSource="{Binding Backups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:BackupItemViewModel}">
                            <Border Style="{StaticResource CardStyle}" Background="{StaticResource Lzn.Surface}">
                                <Grid>
                                    <StackPanel Margin="0,0,120,0">
                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Content="Restaurar" Padding="12,7"
                                            Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding RunSummary}" Foreground="{StaticResource AccentTextBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" TextWrapping="Wrap"
                           Visibility="{Binding HasActions, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}" />
            </StackPanel>

            <!-- Diagnóstico -->
            <StackPanel Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Diagnóstico (somente leitura)" />
                <ItemsControl ItemsSource="{Binding Diagnostics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:DiagnosticItemViewModel}">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="0,0,90,0" TextWrapping="Wrap" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4" Padding="7,2" BorderThickness="1" BorderBrush="{Binding StatusBrush}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="Bold" Foreground="{Binding StatusBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding CurrentState, StringFormat=Estado atual: {0}}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource AccentTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Recommendation}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="16" />
                                    <TextBlock Text="{Binding Details}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Orientações manuais -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Orientações (o app não aplica)" />
            <ItemsControl ItemsSource="{Binding Guidance}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:GuidanceItemViewModel}">
                        <Border Style="{StaticResource CardStyle}" Background="{StaticResource Lzn.Surface}">
                            <Expander Foreground="{StaticResource TextPrimaryBrush}">
                                <Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding TitleBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="24,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat=• {0}}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Details}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
