<UserControl x:Class="LznTweaker.Features.GameProfiles.GameOptimizationPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LznTweaker.Features.GameProfiles"
             Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="2,14,0,8" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#1D1A26" />
            <Setter Property="BorderBrush" Value="#302B3D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,6,6,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0,12,24">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DetectionText}" Foreground="{StaticResource AccentTextBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />

            <!-- Ações automáticas -->
            <StackPanel Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="AÇÕES (MARQUE E CLIQUE EM EXECUTAR)" />
                <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:OptimizationActionViewModel}">
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding State}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Risk, StringFormat=Risco: {0}}" FontSize="10" Foreground="#E0BF80" /></Border>
                                            <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding GamesAffected, StringFormat=Afeta: {0}}" FontSize="10" Foreground="#C9B9F2" /></Border>
                                            <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Prerequisites, StringFormat=Requisitos: {0}}" FontSize="10" Foreground="#91BFB0" TextWrapping="Wrap" /></Border>
                                            <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Reversibility}" FontSize="10" Foreground="#D9B17B" TextWrapping="Wrap" /></Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,4,0,0">
                    <TextBlock Text="{Binding RunSummary}" Foreground="{StaticResource AccentTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,220,0" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Content="▶ Executar selecionados" Command="{Binding RunCommand}" Padding="16,9" />
                </Grid>
            </StackPanel>

            <!-- Backups -->
            <StackPanel Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="BACKUPS FEITOS PELO APP" />
                <ItemsControl ItemsSource="{Binding Backups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:BackupItemViewModel}">
                            <Border Style="{StaticResource CardStyle}" Background="#161220">
                                <Grid>
                                    <StackPanel Margin="0,0,120,0">
                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Content="↺ Restaurar" Padding="12,7"
                                            Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding RunSummary}" Foreground="{StaticResource AccentTextBrush}" FontSize="11" TextWrapping="Wrap"
                           Visibility="{Binding HasActions, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}" />
            </StackPanel>

            <!-- Diagnóstico -->
            <StackPanel Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="DIAGNÓSTICO (SOMENTE LEITURA)" />
                <ItemsControl ItemsSource="{Binding Diagnostics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:DiagnosticItemViewModel}">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="0,0,90,0" TextWrapping="Wrap" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4" Padding="7,2" BorderThickness="1" BorderBrush="{Binding StatusBrush}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding CurrentState, StringFormat=Estado atual: {0}}" FontSize="11" Foreground="{StaticResource AccentTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Recommendation}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="16" />
                                    <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Orientações manuais -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="ORIENTAÇÕES (O APP NÃO APLICA)" />
            <ItemsControl ItemsSource="{Binding Guidance}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:GuidanceItemViewModel}">
                        <Border Style="{StaticResource CardStyle}" Background="#161220">
                            <Expander Foreground="{StaticResource TextPrimaryBrush}">
                                <Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding TitleBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="24,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat=• {0}}" FontSize="11" Foreground="#C8BFD7" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
