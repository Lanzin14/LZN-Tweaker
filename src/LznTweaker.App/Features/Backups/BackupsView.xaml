<UserControl x:Class="LznTweaker.Features.Backups.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:local="clr-namespace:LznTweaker.Features.Backups"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <Grid Margin="28,22,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Histórico" Guide="{x:Static shell:CategoryGuides.Backups}" Status="{Binding Summary}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Lzn.Glyph.Refresh}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Atualizar" FontSize="12" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Lzn.GlowButton}" Command="{Binding RestoreSelectedCommand}" ToolTip="Restaura em lote os ajustes marcados que têm valor anterior registrado">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Restaurar selecionados" FontSize="12" /></StackPanel>
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource Lzn.SearchBox}" Height="36" Tag="Pesquisar no histórico…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="9" BorderThickness="1" Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.Stroke}" Padding="10,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71C;" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,0,4,0" />
                    <ComboBox Style="{StaticResource MinimalComboBoxStyle}" ItemsSource="{Binding OutcomeOptions}" SelectedItem="{Binding OutcomeFilter}" MinWidth="170" BorderThickness="0" Background="Transparent" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}"
                       Text="{Binding VisibleCount, StringFormat={}{0} registro(s)}" />
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding EntriesView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:HistoryEntryViewModel}">
                            <Border Style="{StaticResource Lzn.Card}" Margin="0,0,6,8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,10,0"
                                              Visibility="{Binding CanRestoreHere, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" AutomationProperties.Name="{Binding Title}" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Area}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.AccentHover}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0">
                                            <Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PreviousState, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding RestoreHint, Mode=OneWay}" Foreground="{StaticResource Lzn.AccentText}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Outcome}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" Foreground="{Binding OutcomeBrush}" HorizontalAlignment="Right" />
                                        <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Restaurar" FontSize="{StaticResource Lzn.FontSize.Caption}" Margin="0,6,0,0" HorizontalAlignment="Right"
                                                Visibility="{Binding CanRestoreHere, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                                                Command="{Binding DataContext.RestoreOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Abrir origem" FontSize="{StaticResource Lzn.FontSize.Caption}" Margin="0,6,0,0" HorizontalAlignment="Right"
                                                Visibility="{Binding HasRestoreElsewhere, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                                                Command="{Binding DataContext.OpenOriginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                        Visibility="{Binding VisibleCount, Converter={x:Static infra:VisibilityConverter.WhenZero}}">
                <TextBlock Text="&#xE81C;" Style="{StaticResource Lzn.Icon}" FontSize="28" Foreground="{StaticResource Lzn.TextMuted}" HorizontalAlignment="Center" />
                <TextBlock Text="Nenhum registro encontrado." FontSize="13" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
