<UserControl x:Class="LznTweaker.Features.Backups.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:local="clr-namespace:LznTweaker.Features.Backups"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <!-- Linha: caixa de marcar (só restauráveis), operação, área, quando e resultado -->
        <DataTemplate x:Key="HistoryRow" DataType="{x:Type local:HistoryEntryViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                          Visibility="{Binding CanRestoreHere, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                          ToolTip="Marcar para restaurar em lote" AutomationProperties.Name="{Binding Title, StringFormat=Marcar {0} para restaurar}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                    <TextBlock FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                        <Run Text="{Binding Area, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding When, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="6" Height="6" Fill="{Binding OutcomeBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Outcome}" Foreground="{Binding OutcomeBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Detalhe: o que aconteceu, valor anterior e como restaurar -->
        <DataTemplate x:Key="HistoryDetail" DataType="{x:Type local:HistoryEntryViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Display}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Style="{StaticResource Lzn.Badge}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="6" Height="6" Fill="{Binding OutcomeBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Outcome}" Foreground="{Binding OutcomeBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Lzn.Badge}" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Area}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" />
                    </Border>
                </StackPanel>

                <TextBlock Text="Quando" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Text="{Binding When}" Style="{StaticResource Lzn.Text.Body}" />

                <TextBlock Text="O que aconteceu" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Lzn.Text.Body}" TextWrapping="Wrap" />

                <TextBlock Text="Valor anterior" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBox Text="{Binding PreviousValue, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Lzn.MonoFont}" FontSize="{StaticResource Lzn.FontSize.Caption}"
                         Foreground="{StaticResource Lzn.TextSecondary}" Background="{StaticResource Lzn.SurfaceSunken}" BorderThickness="0" Padding="10,8"
                         AutomationProperties.Name="Valor anterior" />

                <TextBlock Text="Restauração" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Text="{Binding RestoreHint}" Style="{StaticResource Lzn.Text.Body}" TextWrapping="Wrap"
                           Visibility="{Binding RestoreHint, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                <TextBlock Text="Este registro não tem valor anterior para restaurar." Style="{StaticResource Lzn.Text.Body}" TextWrapping="Wrap"
                           Visibility="{Binding RestoreHint, Converter={x:Static infra:VisibilityConverter.WhenNull}}" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource Lzn.PrimaryButton}" Margin="0,0,8,0"
                            Visibility="{Binding CanRestoreHere, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                            Command="{Binding DataContext.RestoreOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Restaurar este" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Abrir página de origem"
                            Visibility="{Binding HasRestoreElsewhere, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                            Command="{Binding DataContext.OpenOriginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Histórico" Guide="{x:Static shell:CategoryGuides.Backups}" Status="{Binding Summary}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Lzn.Glyph.Refresh}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Atualizar" FontSize="12" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Lzn.PrimaryButton}" Command="{Binding RestoreSelectedCommand}" ToolTip="Restaura em lote os ajustes marcados que têm valor anterior registrado. Marque ao menos um para habilitar." ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Restaurar selecionados" FontSize="12" /></StackPanel>
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <controls:Banner Grid.Row="1" Problem="{Binding Problem}">
            <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Tentar de novo" Command="{Binding RefreshCommand}" />
        </controls:Banner>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource Lzn.SearchBox}" Height="36" Tag="Pesquisar no histórico…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Pesquisar no histórico" />
            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="{StaticResource Lzn.Radius.Md}" BorderThickness="1" Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.Stroke}" Padding="10,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Lzn.Glyph.Filter}" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,0,4,0" />
                    <ComboBox Style="{StaticResource MinimalComboBoxStyle}" ItemsSource="{Binding OutcomeOptions}" SelectedItem="{Binding OutcomeFilter}" MinWidth="170"
                              BorderThickness="0" Background="Transparent" AutomationProperties.Name="Filtrar por resultado" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Lzn.Text.Caption}"
                       Text="{Binding VisibleCount, StringFormat={}{0} registro(s)}" />
        </Grid>

        <controls:MasterDetailLayout Grid.Row="3" Selected="{Binding SelectedEntry}" DetailTemplate="{StaticResource HistoryDetail}" CloseCommand="{Binding ClearSelectionCommand}"
                                     Placeholder="Selecione um registro para ver o que aconteceu, o valor anterior e como restaurar.">
            <controls:MasterDetailLayout.Master>
                <Grid>
                    <ListBox Style="{StaticResource Lzn.List}" ItemsSource="{Binding EntriesView}" SelectedItem="{Binding SelectedEntry}"
                             ItemTemplate="{StaticResource HistoryRow}" AutomationProperties.Name="Registros do histórico" />
                    <controls:EmptyState Glyph="&#xE81C;" Message="Nenhum registro corresponde à busca ou ao filtro. Tudo o que o LZN Tweaker alterar aparece aqui."
                                         Visibility="{Binding VisibleCount, Converter={x:Static infra:VisibilityConverter.WhenZero}}" />
                </Grid>
            </controls:MasterDetailLayout.Master>
        </controls:MasterDetailLayout>
    </Grid>
</UserControl>
