<UserControl x:Class="LznTweaker.Features.Programs.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LznTweaker.Features.Programs"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Lzn.Text.Body}">
            <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.BodySmall}" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <!-- Lista com marcador, reutilizada em funcionalidades, passos e cuidados. -->
        <DataTemplate x:Key="Bullet">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="4" Height="4" Fill="{StaticResource Lzn.TextMuted}" VerticalAlignment="Top" Margin="0,8,0,0" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Small}" />
            </Grid>
        </DataTemplate>

        <!-- Logotipo oficial ou monograma -->
        <DataTemplate x:Key="ProgramLogo" DataType="{x:Type local:ProgramCardViewModel}">
            <Grid Width="36" Height="36">
                <Border CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.SurfaceActive}" />
                <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasIcon, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" AutomationProperties.Name="{Binding Name}" />
                <TextBlock Text="{Binding Monogram}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="Bold" Foreground="{StaticResource Lzn.TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasIcon, Converter={x:Static infra:VisibilityConverter.WhenFalse}}" />
            </Grid>
        </DataTemplate>

        <!-- Selo de segurança (cor de estado) -->
        <DataTemplate x:Key="SafetyBadge" DataType="{x:Type local:ProgramCardViewModel}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding SafetyTooltip}" VerticalAlignment="Center">
                <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="6" Height="6" Fill="{Binding SafetyBrush}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding SafetyText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{Binding SafetyBrush}" />
            </StackPanel>
        </DataTemplate>

        <!-- Linha: logo, nome, finalidade e segurança -->
        <DataTemplate x:Key="ProgramRow" DataType="{x:Type local:ProgramCardViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProgramLogo}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Purpose}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource SafetyBadge}" Margin="14,0,0,0" />
            </Grid>
        </DataTemplate>

        <!-- Detalhe: o que é, para que serve, valores de referência, cuidados e fontes -->
        <DataTemplate x:Key="ProgramDetail" DataType="{x:Type local:ProgramCardViewModel}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProgramLogo}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Lzn.Text.Display}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Developer}" Style="{StaticResource Lzn.Text.Caption}" />
                    </StackPanel>
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                    <Border Style="{StaticResource Lzn.Badge}" Margin="0,0,6,4">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SafetyBadge}" />
                    </Border>
                    <Border Style="{StaticResource Lzn.Badge}" Margin="0,0,6,4">
                        <TextBlock Text="{Binding LicenseText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" />
                    </Border>
                </WrapPanel>
                <Button Style="{StaticResource Lzn.ToolbarButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                        ToolTip="{Binding OfficialHost, StringFormat=Abre {0} no navegador. Nada é baixado pelo LZN Tweaker.}"
                        AutomationProperties.Name="{Binding Name, StringFormat=Site oficial do {0}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding OfficialHost, StringFormat=Site oficial · {0}}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" />
                        <TextBlock Text="{StaticResource Lzn.Glyph.OpenExternal}" Style="{StaticResource Lzn.Icon}" FontSize="12" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>

                <TextBlock Text="O que é" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Lzn.Text.Body}" TextWrapping="Wrap" />
                <TextBlock Text="Finalidade" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Text="{Binding Purpose}" Style="{StaticResource Small}" TextWrapping="Wrap" />

                <TextBlock Text="Principais funcionalidades" Style="{StaticResource Lzn.DetailLabel}" />
                <ItemsControl ItemsSource="{Binding Features}" ItemTemplate="{StaticResource Bullet}" Focusable="False" />

                <StackPanel Visibility="{Binding HasSettings, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                    <TextBlock Text="Configurações recomendadas" Style="{StaticResource Lzn.DetailLabel}" />
                    <ItemsControl ItemsSource="{Binding Settings}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ProgramSettingRow}">
                                <Border Background="{StaticResource Lzn.SurfaceSunken}" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="12,9" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Lzn.MonoFont}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.Text}" />
                                        </Grid>
                                        <TextBlock Text="{Binding EvidenceText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{Binding EvidenceBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding Note, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding HasSteps, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                    <TextBlock Text="Como usar" Style="{StaticResource Lzn.DetailLabel}" />
                    <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource Bullet}" Focusable="False" />
                </StackPanel>

                <TextBlock Text="Benefícios possíveis" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Text="{Binding Benefits}" Style="{StaticResource Small}" TextWrapping="Wrap" />
                <TextBlock Text="Limitações" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Text="{Binding Limitations}" Style="{StaticResource Small}" TextWrapping="Wrap" />

                <TextBlock Text="Cuidados" Style="{StaticResource Lzn.DetailLabel}" Foreground="{StaticResource Lzn.RiskWarn}" />
                <ItemsControl ItemsSource="{Binding Cautions}" ItemTemplate="{StaticResource Bullet}" Focusable="False" />

                <TextBlock Text="Integração futura no LZN Tweaker" Style="{StaticResource Lzn.DetailLabel}" />
                <TextBlock Text="{Binding FutureIntegration}" Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" />

                <TextBlock Text="Fontes e referências" Style="{StaticResource Lzn.DetailLabel}" />
                <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ProgramSourceRow}">
                            <Button Style="{StaticResource Lzn.GhostButton}" HorizontalAlignment="Left" Padding="4,3" ToolTip="{Binding Url}"
                                    Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <TextBlock FontSize="{StaticResource Lzn.FontSize.Caption}" TextWrapping="Wrap">
                                    <Run Text="{StaticResource Lzn.Glyph.OpenExternal}" FontFamily="{StaticResource Lzn.IconFont}" Foreground="{StaticResource Lzn.AccentHover}" /><Run Text="  " /><Run Text="{Binding Title, Mode=OneWay}" Foreground="{StaticResource Lzn.TextSecondary}" /><Run Text=" · " Foreground="{StaticResource Lzn.TextMuted}" /><Run Text="{Binding KindText, Mode=OneWay}" Foreground="{StaticResource Lzn.TextMuted}" />
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Recomendação, não obrigação: o aviso fica na linha de status do cabeçalho -->
        <controls:PageHeader Title="Programas" Guide="{x:Static shell:CategoryGuides.Programs}"
                             Status="Todos são opcionais. O LZN Tweaker não baixa, instala nem executa estes programas, e nenhum módulo depende deles. Nada garante mais FPS ou menos latência: meça antes e depois." />

        <!-- Filtros por finalidade -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Filters}" Margin="0,0,0,10" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ProgramFilterOption}">
                    <RadioButton Style="{StaticResource Lzn.Tab}" GroupName="ProgramFilters" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource Lzn.SearchBox}" Height="36" Tag="Pesquisar programa por nome…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Pesquisar programa" />
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Lzn.Text.Caption}"
                       Text="{Binding VisibleCount, StringFormat={}{0} programa(s)}" />
        </Grid>

        <controls:MasterDetailLayout Grid.Row="3" Selected="{Binding SelectedProgram}" DetailTemplate="{StaticResource ProgramDetail}" CloseCommand="{Binding ClearSelectionCommand}"
                                     Placeholder="Selecione um programa para ver o que faz, as configurações recomendadas e o site oficial.">
            <controls:MasterDetailLayout.Master>
                <Grid>
                    <ListBox Style="{StaticResource Lzn.List}" ItemsSource="{Binding ProgramsView}" SelectedItem="{Binding SelectedProgram}"
                             ItemTemplate="{StaticResource ProgramRow}" AutomationProperties.Name="Programas recomendados">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Lzn.ListRow}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <controls:EmptyState Glyph="{StaticResource Lzn.Glyph.Search}" Message="Nenhum programa corresponde à busca ou ao filtro."
                                         Visibility="{Binding VisibleCount, Converter={x:Static infra:VisibilityConverter.WhenZero}}">
                        <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Limpar busca e filtro" Command="{Binding ClearFiltersCommand}" />
                    </controls:EmptyState>
                </Grid>
            </controls:MasterDetailLayout.Master>
        </controls:MasterDetailLayout>
    </Grid>
</UserControl>
