<UserControl x:Class="LznTweaker.Features.Hardware.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:games="clr-namespace:LznTweaker.Features.GameProfiles"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Lzn.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Lzn.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Status: resultado da leitura (concluída, parcial ou com falha). -->
        <controls:PageHeader Title="Hardware" Guide="{x:Static shell:CategoryGuides.Hardware}" Status="{Binding Dashboard.StatusMessage}" Margin="0,0,0,14" />

        <controls:AdaptiveGridPanel Grid.Row="1" MinItemWidth="200" MaxColumns="5" Spacing="10" Margin="0,0,8,12" DataContext="{Binding Dashboard}">
            <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="CPU" Style="{StaticResource Label}" /><TextBlock Text="{Binding ProcessorDetail}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding CpuUsageText, StringFormat=Uso: {0}}" FontSize="11" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,4,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="GPU" Style="{StaticResource Label}" /><TextBlock Text="{Binding GraphicsSummary}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding GraphicsMemorySummary}" FontSize="10" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="RAM" Style="{StaticResource Label}" /><TextBlock Text="{Binding MemorySummary}" FontSize="12" Margin="0,8,0,0" /><TextBlock Text="{Binding MemoryDetail}" FontSize="11" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="ARMAZENAMENTO" Style="{StaticResource Label}" /><TextBlock Text="{Binding StorageSummary}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding DiskActivitySummary}" FontSize="10" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="PLACA-MÃE" Style="{StaticResource Label}" /><TextBlock Text="{Binding MotherboardSummary}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" /><TextBlock Text="Temperaturas: não lidas (exigem driver de kernel; veja HWiNFO nas orientações)." FontSize="10" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border>
        </controls:AdaptiveGridPanel>

        <!-- Diagnóstico de hardware: mesma página da biblioteca de jogos (mesma instância e estado) -->
        <games:GameOptimizationPageView x:Name="DiagnosticsHost" Grid.Row="2" />
    </Grid>
</UserControl>
