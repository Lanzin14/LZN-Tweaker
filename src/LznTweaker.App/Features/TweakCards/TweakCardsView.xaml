<UserControl x:Class="LznTweaker.Features.TweakCards.TweakCardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:local="clr-namespace:LznTweaker.Features.TweakCards"
             xmlns:tweaks="clr-namespace:LznTweaker.Core.Tweaks;assembly=LznTweaker.Core"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <!-- Selo de risco: ícone + texto, explicação no hover -->
        <DataTemplate x:Key="RiskBadge" DataType="{x:Type local:CardViewModel}">
            <Border Style="{StaticResource Lzn.Badge}" HorizontalAlignment="Left" ToolTip="{Binding RiskTooltip}" ToolTipService.InitialShowDelay="150">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RiskGlyph}" Style="{StaticResource Lzn.Icon}" FontSize="11" Foreground="{Binding RiskBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding RiskText}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" Foreground="{Binding RiskBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Categoria do card (ex.: Privacidade), útil quando a busca mistura grupos; some quando a aba não tem categorias -->
        <DataTemplate x:Key="CategoryChip" DataType="{x:Type local:CardViewModel}">
            <Border Style="{StaticResource Lzn.Badge}" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="Categoria"
                    Visibility="{Binding Category, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Category.Glyph, FallbackValue=''}" Style="{StaticResource Lzn.Icon}" FontSize="10" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding Category.Title, FallbackValue=''}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Cabeçalho de grupo: ícone da categoria, nome, quantidade visível e descrição. Ícones neutros: o roxo fica para ação e seleção. -->
        <DataTemplate x:Key="GroupHeader">
            <StackPanel Margin="2,4,0,10" Visibility="{Binding Name, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name.Glyph, FallbackValue=''}" Style="{StaticResource Lzn.Icon}" FontSize="16" Foreground="{StaticResource Lzn.Text}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name.Title, FallbackValue=''}" Style="{StaticResource Lzn.Text.Subtitle}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Lzn.Badge}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ItemCount}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Name.Description, FallbackValue=''}" Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" Margin="23,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="InfoButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Width="28" Height="28" CornerRadius="{StaticResource Lzn.Radius.Sm}" Background="Transparent">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
                                <Setter Property="Foreground" Value="{StaticResource Lzn.AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card de ajuste do catálogo -->
        <DataTemplate DataType="{x:Type local:TweakCardViewModel}">
            <Border Style="{StaticResource Lzn.Card}" MinHeight="148">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.SurfaceActive}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" FontSize="14" Foreground="{StaticResource Lzn.TextSecondary}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding Title}" />
                        <Button Grid.Column="2" Style="{StaticResource InfoButton}" ToolTip="Detalhes, efeitos e restauração"
                                Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RiskBadge}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,12,0" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="6" Height="6" Fill="{Binding StateBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Lzn.ToggleSwitch}" IsChecked="{Binding IsOn}" IsEnabled="{Binding IsSwitchEnabled}"
                                  ToolTip="{Binding SwitchTooltip}" ToolTipService.ShowOnDisabled="True"
                                  Visibility="{Binding IsToggle, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                                  AutomationProperties.Name="{Binding Title}" />
                        <Button Grid.Column="2" Style="{StaticResource Lzn.ToolbarButton}" Content="{Binding ActionButtonText}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Padding="12,6"
                                Visibility="{Binding IsAction, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                                ToolTip="Ação pontual: entra na fila e é executada ao revisar e aplicar."
                                Command="{Binding DataContext.ToggleQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18" Margin="0,10,0,0" />
                        <WrapPanel Margin="0,6,0,0">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CategoryChip}" Margin="0,0,8,0" />
                            <Border Style="{StaticResource Lzn.ValueChip}" Margin="0,0,8,0"
                                    Visibility="{Binding IsRecommended, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                                <TextBlock Text="Recomendado" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" />
                            </Border>
                            <TextBlock Text="{Binding RestartText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Card de ação imediata -->
        <DataTemplate DataType="{x:Type local:QuickActionCardViewModel}">
            <Border Style="{StaticResource Lzn.Card}" MinHeight="148">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.SurfaceActive}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" FontSize="14" Foreground="{StaticResource Lzn.TextSecondary}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                        <Button Grid.Column="2" Style="{StaticResource InfoButton}" ToolTip="Detalhes"
                                Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RiskBadge}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,12,0" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="6" Height="6" Fill="{Binding StateBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Lzn.ToolbarButton}" Content="{Binding ButtonText}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Padding="12,6"
                                IsEnabled="{Binding IsRunning, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                                Command="{Binding DataContext.RunQuickActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding Note}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.RiskWarn}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Note, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CategoryChip}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Estado recomendado de uma configuração manual -->
        <DataTemplate x:Key="RecommendationBadge" DataType="{x:Type local:GuideCardViewModel}">
            <Border Style="{StaticResource Lzn.Badge}" HorizontalAlignment="Left" ToolTip="{Binding RiskTooltip}" ToolTipService.InitialShowDelay="150">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RecommendationGlyph}" Style="{StaticResource Lzn.Icon}" FontSize="10" Foreground="{Binding RecommendationBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding RecommendationText}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" Foreground="{Binding RecommendationBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Card de configuração manual (hoje, só os guias do Discord: o ícone é o símbolo oficial) -->
        <DataTemplate DataType="{x:Type local:GuideCardViewModel}">
            <Border Style="{StaticResource Lzn.Card}" MinHeight="148">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.DiscordSoft}" Margin="0,0,12,0">
                            <Path Data="{StaticResource Lzn.Brand.DiscordSymbol}" Fill="{StaticResource Lzn.Discord}" Stretch="Uniform" Width="18" Height="14" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RecommendationBadge}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource Lzn.ToolbarButton}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Padding="12,6"
                                ToolTip="Passo a passo dentro do Discord"
                                Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource Lzn.Icon}" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Como configurar" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0" />
                        <TextBlock Text="Caminho" Style="{StaticResource Lzn.Text.Overline}" Margin="0,10,0,4" />
                        <TextBlock Text="{Binding PathText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.AccentText}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Detalhes de ajuste -->
        <DataTemplate x:Key="TweakDetails" DataType="{x:Type local:TweakCardViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Section}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RiskBadge}" />
                    <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="O que faz" Style="{StaticResource Lzn.Text.Overline}" Margin="0,18,0,6" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Lzn.Text.Body}" />
                <TextBlock Text="Como e efeitos esperados" Style="{StaticResource Lzn.Text.Overline}" Margin="0,14,0,6" />
                <TextBlock Text="{Binding Definition.TechnicalReason}" Style="{StaticResource Lzn.Text.Body}" />
                <TextBlock Text="Limitações e compatibilidade" Style="{StaticResource Lzn.Text.Overline}" Margin="0,14,0,6" />
                <TextBlock Text="{Binding Definition.Compatibility}" Style="{StaticResource Lzn.Text.Body}" />
                <TextBlock Text="Restauração" Style="{StaticResource Lzn.Text.Overline}" Margin="0,14,0,6" />
                <TextBlock Text="{Binding RollbackText}" FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" />
                <TextBlock FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0">
                    <Run Text="{Binding RestartText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding AdministratorText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="Estado detectado" Style="{StaticResource Lzn.Text.Overline}" Margin="0,14,0,6" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SwitchTooltip}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.AccentText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Definition.SourceUrl, StringFormat=Referência: {0}}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding Definition.SourceUrl, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ActionDetails" DataType="{x:Type local:QuickActionCardViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Section}" TextWrapping="Wrap" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RiskBadge}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                <TextBlock Text="O que faz" Style="{StaticResource Lzn.Text.Overline}" Margin="0,18,0,6" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Lzn.Text.Body}" />
                <TextBlock Text="{Binding Definition.Confirmation}" Style="{StaticResource Lzn.Text.Body}" Margin="0,10,0,0"
                           Visibility="{Binding Definition.Confirmation, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource Lzn.RiskWarn}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding Note, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                <TextBlock Text="A execução é registrada em Backups. O app só executa a ferramenta desta lista fixa; nenhum comando digitado é aceito."
                           FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GuideDetails" DataType="{x:Type local:GuideCardViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Section}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RecommendationBadge}" />
                    <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Benefício" Style="{StaticResource Lzn.Text.Overline}" Margin="0,18,0,6" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Lzn.Text.Body}" />
                <TextBlock Text="Caminho no Discord" Style="{StaticResource Lzn.Text.Overline}" Margin="0,14,0,6" />
                <TextBlock Text="{Binding PathText}" FontSize="12" Foreground="{StaticResource Lzn.AccentText}" TextWrapping="Wrap" />
                <TextBlock Text="Como configurar" Style="{StaticResource Lzn.Text.Overline}" Margin="0,14,0,6" />
                <ItemsControl ItemsSource="{Binding NumberedSteps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Lzn.Text.Body}" Margin="0,0,0,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{StaticResource Lzn.WarnSoft}" BorderBrush="{StaticResource Lzn.WarnStroke}" BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="12,10" Margin="0,6,0,0"
                        Visibility="{Binding Note, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                    <StackPanel>
                        <TextBlock Text="Pode variar conforme a versão" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" Foreground="{StaticResource Lzn.RiskWarn}" />
                        <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="O LZN Tweaker não abre nem altera o Discord. Se uma opção não estiver no lugar indicado, o Discord pode ter mudado o menu na sua versão."
                           FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" TextWrapping="Wrap" Margin="0,14,0,0" />
                <TextBlock Text="{Binding Guide.SourceUrl, StringFormat=Referência: {0}}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- ═══ Layout Foco (docs/REDESIGN-OBSIDIAN.md, Fase 3b) ═══ -->
        <!-- Linha limpa: ponto de estado, nome e estado. A ação fica no detalhe. -->
        <DataTemplate x:Key="FocusRow" DataType="{x:Type local:CardViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" Margin="2,0,14,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Linha de guia (Discord): símbolo oficial no lugar do ponto e a recomendação à direita -->
        <DataTemplate x:Key="FocusGuideRow" DataType="{x:Type local:GuideCardViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource Lzn.Brand.DiscordSymbol}" Fill="{StaticResource Lzn.Discord}" Stretch="Uniform" Width="13" Height="10" Margin="0,0,11,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                <TextBlock Grid.Column="2" Text="{Binding RecommendationText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{Binding RecommendationBrush}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Linha de ajuste: o interruptor muda o estado desejado ali mesmo (fica pendente até "Revisar e aplicar");
             ações de uma vez usam caixa de seleção (entram na fila). -->
        <DataTemplate x:Key="FocusTweakRow" DataType="{x:Type local:TweakCardViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="40" Margin="0,0,10,0" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource Lzn.ToggleSwitch}" IsChecked="{Binding IsOn}" IsEnabled="{Binding IsSwitchEnabled}" ToolTip="{Binding SwitchTooltip}"
                              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Title}" HorizontalAlignment="Left"
                              Visibility="{Binding IsToggle, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" />
                    <CheckBox Style="{StaticResource AccentCheckBoxStyle}" IsChecked="{Binding IsQueued}" ToolTip="Marcar para executar no próximo lote"
                              AutomationProperties.Name="{Binding Title}" HorizontalAlignment="Left"
                              Visibility="{Binding IsAction, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{Binding StateBrush}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <local:FocusRowSelector x:Key="FocusRowSelector" Card="{StaticResource FocusRow}" Tweak="{StaticResource FocusTweakRow}" Guide="{StaticResource FocusGuideRow}" />

        <!-- Rótulo de grupo: ícone da categoria e nome em maiúsculas -->
        <DataTemplate x:Key="FocusGroupHeader">
            <StackPanel Orientation="Horizontal" Margin="6,18,0,8" Visibility="{Binding Name, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                <TextBlock Text="{Binding Name.Glyph, FallbackValue=''}" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,0,9,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name.Title, FallbackValue='', Converter={x:Static infra:UpperCaseConverter.Instance}}" Style="{StaticResource Lzn.Text.Overline}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ItemCount}" Style="{StaticResource Lzn.Text.Overline}" Foreground="{StaticResource Lzn.TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Categoria como rótulo acima do título (o violeta fica para ação e seleção) -->
        <DataTemplate x:Key="FocusCategoryChip" DataType="{x:Type local:CardViewModel}">
            <TextBlock Text="{Binding Category.Title, FallbackValue='', Converter={x:Static infra:UpperCaseConverter.Instance}}" Style="{StaticResource Lzn.Text.Overline}"
                       Margin="0,0,0,6" Visibility="{Binding Category, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
        </DataTemplate>
        <Style x:Key="FactLabel" TargetType="TextBlock" BasedOn="{StaticResource Lzn.Text.Caption}">
            <Setter Property="Margin" Value="0,0,12,8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="FactValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Lzn.TextSecondary}" />
            <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.BodySmall}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Quadro do detalhe: rótulo e texto -->
        <Style x:Key="FocusCard" TargetType="Border" BasedOn="{StaticResource Lzn.Panel}">
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style x:Key="FocusCardLabel" TargetType="TextBlock" BasedOn="{StaticResource Lzn.Text.Caption}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FocusCardText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Lzn.FontSize.Body}" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Detalhe de ajuste: selos, título grande, descrição, quadros e "O que será alterado" -->
        <DataTemplate x:Key="FocusTweakDetail" DataType="{x:Type local:TweakCardViewModel}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FocusCategoryChip}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Section}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <WrapPanel Margin="0,12,0,0">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RiskBadge}" Margin="0,0,8,6" />
                    <Border Style="{StaticResource Lzn.Badge}" Margin="0,0,8,6">
                        <TextBlock Text="{Binding RestartText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" />
                    </Border>
                </WrapPanel>
                <TextBlock Text="{Binding Description}" Style="{StaticResource FocusCardText}" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,8,0,0" />

                <!-- O que importa antes de decidir: estado agora, como voltar, permissão e compatibilidade -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Agora" Style="{StaticResource FactLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Style="{StaticResource Lzn.StatusDot}" Fill="{Binding StateBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Para voltar" Style="{StaticResource FactLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RollbackText}" Style="{StaticResource FactValue}" />
                    <TextBlock Grid.Row="2" Text="Permissão" Style="{StaticResource FactLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AdministratorText}" Style="{StaticResource FactValue}" />
                    <TextBlock Grid.Row="3" Text="Compatível" Style="{StaticResource FactLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Definition.Compatibility}" Style="{StaticResource FactValue}" />
                </Grid>

                <ToggleButton x:Name="HowToggle" HorizontalAlignment="Left" Margin="0,10,0,0" Cursor="Hand" FocusVisualStyle="{StaticResource Lzn.FocusVisual}"
                              AutomationProperties.Name="Detalhes técnicos">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <TextBlock Text="Detalhes técnicos" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.AccentHover}" />
                                <TextBlock x:Name="Chevron" Text="{StaticResource Lzn.Glyph.ChevronDown}" Style="{StaticResource Lzn.Icon}" FontSize="10" Foreground="{StaticResource Lzn.AccentHover}" Margin="6,2,0,0" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron" Property="Text" Value="{StaticResource Lzn.Glyph.ChevronUp}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsChecked, ElementName=HowToggle, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                    <TextBlock Text="{Binding Definition.TechnicalReason}" Style="{StaticResource Lzn.Text.Body}" TextWrapping="Wrap" />
                    <Border Style="{StaticResource FocusCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="O que será alterado" Style="{StaticResource FocusCardLabel}" />
                            <TextBox Text="{Binding ChangesText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                                     FontFamily="{StaticResource Lzn.MonoFont}" FontSize="13" Foreground="{StaticResource Lzn.TextSecondary}" AutomationProperties.Name="O que será alterado" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Estado detectado" Style="{StaticResource Lzn.DetailLabel}" Margin="0,16,0,6" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Lzn.Text.Body}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Definition.SourceUrl, StringFormat=Referência: {0}}" Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding Definition.SourceUrl, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Detalhe de ferramenta ou atalho -->
        <DataTemplate x:Key="FocusActionDetail" DataType="{x:Type local:QuickActionCardViewModel}">
            <StackPanel>
                <WrapPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FocusCategoryChip}" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RiskBadge}" Margin="0,0,8,6" />
                </WrapPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Display}" TextWrapping="Wrap" Margin="0,14,0,0" />
                <TextBlock Text="{Binding Description}" FontSize="16" LineHeight="25" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="820" HorizontalAlignment="Left" />
                <Border Style="{StaticResource FocusCard}" Margin="0,26,0,0" Visibility="{Binding ConfirmationNotice, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                    <StackPanel>
                        <TextBlock Text="Antes de executar" Style="{StaticResource FocusCardLabel}" />
                        <TextBlock Text="{Binding ConfirmationNotice}" Style="{StaticResource FocusCardText}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Note}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.RiskWarn}" TextWrapping="Wrap" Margin="2,14,0,0"
                           Visibility="{Binding Note, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                <TextBlock Text="A execução é registrada no Histórico. O app só executa a ferramenta desta lista fixa; nenhum comando digitado é aceito."
                           Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="2,16,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Detalhe de guia (Discord) -->
        <DataTemplate x:Key="FocusGuideDetail" DataType="{x:Type local:GuideCardViewModel}">
            <StackPanel>
                <WrapPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RecommendationBadge}" Margin="0,0,8,6" />
                    <Border Style="{StaticResource Lzn.Badge}" Margin="0,0,8,6">
                        <TextBlock Text="{Binding StateText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" />
                    </Border>
                </WrapPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Display}" TextWrapping="Wrap" Margin="0,14,0,0" />
                <TextBlock Text="{Binding Description}" FontSize="16" LineHeight="25" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="820" HorizontalAlignment="Left" />
                <Border Style="{StaticResource FocusCard}" Margin="0,26,0,0">
                    <StackPanel>
                        <TextBlock Text="Caminho no Discord" Style="{StaticResource FocusCardLabel}" />
                        <TextBlock Text="{Binding PathText}" Style="{StaticResource FocusCardText}" Foreground="{StaticResource Lzn.AccentText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FocusCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Como configurar" Style="{StaticResource FocusCardLabel}" />
                        <ItemsControl ItemsSource="{Binding NumberedSteps}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource FocusCardText}" Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Lzn.WarnSoft}" BorderBrush="{StaticResource Lzn.WarnStroke}" BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Lg}" Padding="16,12" Margin="0,14,0,0"
                        Visibility="{Binding Note, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                    <StackPanel>
                        <TextBlock Text="Pode variar conforme a versão" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" Foreground="{StaticResource Lzn.RiskWarn}" />
                        <TextBlock Text="{Binding Note}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="O LZN Tweaker não abre nem altera o Discord. Se uma opção não estiver no lugar indicado, o Discord pode ter mudado o menu na sua versão."
                           Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="2,16,0,0" />
                <TextBlock Text="{Binding Guide.SourceUrl, StringFormat=Referência: {0}}" Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="2,8,0,0" />
            </StackPanel>
        </DataTemplate>

        <local:DetailsTemplateSelector x:Key="FocusDetailsSelector" Tweak="{StaticResource FocusTweakDetail}" Action="{StaticResource FocusActionDetail}" Guide="{StaticResource FocusGuideDetail}" />

        <!-- Painel de detalhe (página): conteúdo rolável e a barra de ação no rodapé -->
        <DataTemplate x:Key="FocusDetailPanel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,24,16" Focusable="False">
                    <ContentControl Content="{Binding SelectedCard}" ContentTemplateSelector="{StaticResource FocusDetailsSelector}" Focusable="False" />
                </ScrollViewer>
                <Border Grid.Row="1" BorderBrush="{StaticResource Lzn.StrokeSubtle}" BorderThickness="0,1,0,0" Padding="28,14,24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Ação do detalhe sempre secundária: só marca ou desmarca. O único botão roxo da tela é "Revisar e aplicar",
                             na barra do rodapé, que aparece quando há algo marcado. -->
                        <Button Style="{StaticResource Lzn.ToolbarButton}" Padding="16,10" Margin="0,0,10,0"
                                Content="{Binding SelectedCard.PrimaryActionText}" Command="{Binding PrimaryActionCommand}" CommandParameter="{Binding SelectedCard}"
                                IsEnabled="{Binding SelectedCard.CanPrimaryAction}" ToolTip="{Binding SelectedCard.PrimaryActionTooltip}" ToolTipService.ShowOnDisabled="True"
                                Visibility="{Binding SelectedCard.PrimaryActionText, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                        <Button Grid.Column="1" Style="{StaticResource Lzn.ToolbarButton}" Padding="16,10" Command="{Binding RefreshCommand}"
                                ToolTip="Ler novamente o estado real dos ajustes" Visibility="{Binding HasTweaks, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Lzn.Glyph.Refresh}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Verificar estado" FontSize="{StaticResource Lzn.FontSize.BodySmall}" /></StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Barra de alterações pendentes (mesma nos dois layouts) -->
        <DataTemplate x:Key="PendingBar">
            <controls:ActionBar Summary="{Binding PendingSummary}" Hint="  ·  revisão e ponto de restauração antes de aplicar"
                                Visibility="{Binding HasPending, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Descartar" Margin="0,0,8,0" Command="{Binding DiscardCommand}" />
                    <Button Style="{StaticResource Lzn.PrimaryButton}" Command="{Binding ApplyCommand}" ToolTip="Mostra o resumo e pede confirmação; cria o ponto de restauração antes de aplicar.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Lzn.Glyph.Check}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Revisar e aplicar" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:ActionBar>
        </DataTemplate>

        <local:DetailsTemplateSelector x:Key="DetailsSelector" Tweak="{StaticResource TweakDetails}" Action="{StaticResource ActionDetails}" Guide="{StaticResource GuideDetails}" />
    </UserControl.Resources>

    <Grid>
        <!-- Lista ocupa o espaço livre; detalhe com largura fixa à direita (em janela estreita, abre por cima) -->
        <Grid Visibility="{Binding UsesListLayout, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Lista -->
            <Border BorderBrush="{StaticResource Lzn.StrokeSubtle}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDetailDocked}" Value="False">
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel Margin="28,24,18,0">
                    <!-- Título, contagem e "Saiba mais" -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Title}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding CountText}" FontSize="{StaticResource Lzn.FontSize.Body}" Foreground="{StaticResource Lzn.TextMuted}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </WrapPanel>
                        <ToggleButton x:Name="FocusInfoToggle" Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" FocusVisualStyle="{StaticResource Lzn.FocusVisual}"
                                      ToolTip="Sobre esta página" AutomationProperties.Name="Sobre esta página">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" Width="32" Height="32" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="Transparent">
                                        <TextBlock Text="{StaticResource Lzn.Glyph.Info}" Style="{StaticResource Lzn.Icon}" FontSize="15" Foreground="{StaticResource Lzn.TextMuted}" HorizontalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" /></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.AccentSoft}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=FocusInfoToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=FocusInfoToggle, Mode=TwoWay}" VerticalOffset="6" HorizontalOffset="-300">
                            <Border Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}" BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Lg}" Padding="16" Width="560">
                                <StackPanel>
                                    <controls:CategoryInfo Guide="{Binding Guide}" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Abas -->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" Margin="-4,14,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CardTabViewModel}">
                                <RadioButton Style="{StaticResource Lzn.Tab}" GroupName="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Foco{0}}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Perfis prontos (marcam vários ajustes; nada é aplicado sem revisão) -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,12,0,0" Visibility="{Binding ShowsPresetBar, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                        <TextBlock Text="Perfis" Style="{StaticResource Lzn.Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Style="{StaticResource Lzn.ToolbarButton}" Padding="10,6" Margin="0,0,6,0" Command="{Binding ApplyPresetCommand}" CommandParameter="{x:Static tweaks:TweakPreset.Standard}"
                                ToolTip="Marca a seleção recomendada: telemetria, histórico de atividades, localização, Consumer Features e Finalizar tarefa. Só marca: nada é aplicado sem revisão.">
                            <TextBlock Text="Recomendado" FontSize="{StaticResource Lzn.FontSize.Caption}" />
                        </Button>
                        <Button Style="{StaticResource Lzn.ToolbarButton}" Padding="10,6" Margin="0,0,6,0" Command="{Binding ApplyPresetCommand}" CommandParameter="{x:Static tweaks:TweakPreset.Minimal}"
                                ToolTip="Marca só Telemetria e Consumer Features.">
                            <TextBlock Text="Mínimo" FontSize="{StaticResource Lzn.FontSize.Caption}" />
                        </Button>
                        <Button Style="{StaticResource Lzn.ToolbarButton}" Padding="10,6" Margin="0,0,6,0" Command="{Binding ApplyPresetCommand}" CommandParameter="{x:Static tweaks:TweakPreset.Advanced}"
                                ToolTip="Recomendado mais Recall e Copilot desativados.">
                            <TextBlock Text="Avançado" FontSize="{StaticResource Lzn.FontSize.Caption}" />
                        </Button>
                        <Button Style="{StaticResource Lzn.GhostButton}" Padding="8,6" Command="{Binding DiscardCommand}" ToolTip="Desmarca tudo o que está pendente">
                            <TextBlock Text="Limpar" FontSize="{StaticResource Lzn.FontSize.Caption}" />
                        </Button>
                    </WrapPanel>

                    <!-- Aviso em destaque da aba (Discord) -->
                    <Border DockPanel.Dock="Top" Margin="0,12,0,0" Background="{StaticResource Lzn.DiscordSoft}" BorderBrush="{StaticResource Lzn.DiscordStroke}" BorderThickness="1"
                            CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="12,10"
                            Visibility="{Binding SelectedTabHighlight, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}"
                            ToolTip="Nada é alterado automaticamente. Os nomes seguem a versão atual do Discord em português e podem mudar entre versões.">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Lzn.Brand.DiscordSymbol}" Fill="{StaticResource Lzn.Discord}" Stretch="Uniform" Width="20" Height="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedTabHighlight}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Busca e filtros -->
                    <Grid DockPanel.Dock="Top" Margin="0,14,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Lzn.SearchBox}" Height="40" Tag="Pesquisar ajustes…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Pesquisar ajustes" />
                        <ToggleButton x:Name="FocusFilterToggle" Grid.Column="1" Margin="8,0,0,0" Cursor="Hand" FocusVisualStyle="{StaticResource Lzn.FocusVisual}"
                                      ToolTip="Filtros e ordenação" AutomationProperties.Name="Filtros e ordenação">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" Width="40" Height="40" CornerRadius="{StaticResource Lzn.Radius.Md}" BorderThickness="1" Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.Stroke}">
                                        <Grid>
                                            <TextBlock Text="{StaticResource Lzn.Glyph.Filter}" Style="{StaticResource Lzn.Icon}" FontSize="14" Foreground="{StaticResource Lzn.TextSecondary}" HorizontalAlignment="Center" />
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource Lzn.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"
                                                     Visibility="{Binding HasFilters, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" /></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.AccentSoft}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.AccentStroke}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup Grid.Column="1" PlacementTarget="{Binding ElementName=FocusFilterToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=FocusFilterToggle, Mode=TwoWay}" VerticalOffset="6">
                            <Border Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}" BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Lg}" Padding="14" Width="260">
                                <StackPanel>
                                    <TextBlock Text="Risco" Style="{StaticResource Lzn.Text.Overline}" Margin="0,0,0,6" />
                                    <ComboBox Style="{StaticResource MinimalComboBoxStyle}" ItemsSource="{Binding RiskOptions}" SelectedItem="{Binding RiskFilter}" AutomationProperties.Name="Filtrar por risco" />
                                    <TextBlock Text="Estado" Style="{StaticResource Lzn.Text.Overline}" Margin="0,12,0,6" />
                                    <ComboBox Style="{StaticResource MinimalComboBoxStyle}" ItemsSource="{Binding StateOptions}" SelectedItem="{Binding StateFilter}" AutomationProperties.Name="Filtrar por estado" />
                                    <TextBlock Text="Ordenar" Style="{StaticResource Lzn.Text.Overline}" Margin="0,12,0,6" />
                                    <ComboBox Style="{StaticResource MinimalComboBoxStyle}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortMode}" AutomationProperties.Name="Ordenar" />
                                    <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Limpar filtros" FontSize="{StaticResource Lzn.FontSize.Caption}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Command="{Binding ClearFiltersCommand}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <controls:Banner DockPanel.Dock="Top" Problem="{Binding LoadError}" Margin="0,8,0,4">
                        <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Tentar de novo" Command="{Binding RefreshCommand}" />
                    </controls:Banner>

                    <!-- Itens -->
                    <Grid>
                        <ListBox x:Name="FocusList" Style="{StaticResource Lzn.List}" ItemsSource="{Binding CardsView}" SelectedItem="{Binding SelectedCard}"
                                 ItemTemplateSelector="{StaticResource FocusRowSelector}" AutomationProperties.Name="Itens da página" Padding="0,0,4,18">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Lzn.ListRow}">
                                    <Setter Property="Padding" Value="14,13" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource FocusGroupHeader}" />
                            </ListBox.GroupStyle>
                        </ListBox>
                        <controls:LoadingState Message="Lendo o estado atual dos ajustes…" Visibility="{Binding IsLoading, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" />
                        <controls:EmptyState Glyph="{StaticResource Lzn.Glyph.Search}" Message="Nenhum item corresponde à busca ou aos filtros."
                                             Visibility="{Binding VisibleCount, Converter={x:Static infra:VisibilityConverter.WhenZero}}">
                            <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Limpar busca e filtros" Command="{Binding ClearFiltersCommand}" />
                        </controls:EmptyState>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Detalhe fixo -->
            <Grid Grid.Column="1" Width="{StaticResource Lzn.Layout.DockedDetailWidth}" Visibility="{Binding IsDetailDocked, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FocusDetailPanel}" Focusable="False"
                                Visibility="{Binding SelectedCard, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                <controls:EmptyState Glyph="{StaticResource Lzn.Glyph.Select}" Message="Selecione um item da lista para ver o que ele faz, o que muda no sistema e como desfazer."
                                     Visibility="{Binding SelectedCard, Converter={x:Static infra:VisibilityConverter.WhenNull}}" />
            </Grid>

            <!-- Alterações pendentes -->
            <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Content="{Binding}" ContentTemplate="{StaticResource PendingBar}" Margin="28,0,28,0" Focusable="False" />
        </Grid>

        <!-- Grade de cards (páginas sem ListLayout) -->
        <Grid Margin="28,22,28,0" Visibility="{Binding UsesListLayout, Converter={x:Static infra:VisibilityConverter.WhenFalse}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <controls:PageHeader Title="{Binding Title}" Guide="{Binding Guide}" Status="{Binding StatusText}">
                <Button Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding RefreshCommand}" ToolTip="Ler novamente o estado real dos ajustes">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Lzn.Glyph.Refresh}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Verificar estado" FontSize="12" /></StackPanel>
                </Button>
            </controls:PageHeader>

            <!-- Abas contextuais -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CardTabViewModel}">
                        <RadioButton Style="{StaticResource Lzn.Tab}" GroupName="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,7,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding SelectedTabDescription}" Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" Margin="4,8,0,0"
                       Visibility="{Binding SelectedTabDescription, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
            <!-- Aviso em destaque da aba (hoje, só a aba Discord) -->
            <Border Margin="0,12,0,0" Background="{StaticResource Lzn.DiscordSoft}" BorderBrush="{StaticResource Lzn.DiscordStroke}" BorderThickness="1"
                    CornerRadius="{StaticResource Lzn.Radius.Lg}" Padding="16,12"
                    Visibility="{Binding SelectedTabHighlight, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource Lzn.Brand.DiscordSymbol}" Fill="{StaticResource Lzn.Discord}" Stretch="Uniform" Width="30" Height="23" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedTabHighlight}" FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="Bold" Foreground="{StaticResource Lzn.Text}" />
                        <TextBlock Text="Nada é alterado automaticamente. Os nomes seguem a versão atual do Discord em português e podem mudar entre versões; cada card avisa o que pode variar."
                                   Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>

            <!-- Pesquisa, filtros e ordenação -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource Lzn.SearchBox}" Height="36" Tag="Pesquisar ajustes…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Pesquisar ajustes" />
                <ToggleButton x:Name="FilterToggle" Grid.Column="1" Margin="8,0,0,0" Cursor="Hand" FocusVisualStyle="{StaticResource Lzn.FocusVisual}" AutomationProperties.Name="Filtros">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="12,8" BorderThickness="1" Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.Stroke}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.StrokeStrong}" /></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.AccentSoft}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.AccentStroke}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" Foreground="{StaticResource Lzn.TextSecondary}" />
                        <TextBlock Text="Filtros" FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" />
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Lzn.Accent}" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding HasFilters, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" />
                    </StackPanel>
                </ToggleButton>
                <Popup Grid.Column="1" PlacementTarget="{Binding ElementName=FilterToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsChecked, ElementName=FilterToggle, Mode=TwoWay}" VerticalOffset="6">
                    <Border Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}" BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Lg}" Padding="14" Width="260">
                        <StackPanel>
                            <TextBlock Text="Risco" Style="{StaticResource Lzn.Text.Overline}" Margin="0,0,0,6" />
                            <ComboBox Style="{StaticResource MinimalComboBoxStyle}" ItemsSource="{Binding RiskOptions}" SelectedItem="{Binding RiskFilter}" />
                            <TextBlock Text="Estado" Style="{StaticResource Lzn.Text.Overline}" Margin="0,12,0,6" />
                            <ComboBox Style="{StaticResource MinimalComboBoxStyle}" ItemsSource="{Binding StateOptions}" SelectedItem="{Binding StateFilter}" />
                            <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Limpar filtros" FontSize="{StaticResource Lzn.FontSize.Caption}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Command="{Binding ClearFiltersCommand}" />
                        </StackPanel>
                    </Border>
                </Popup>
                <Border Grid.Column="2" Margin="8,0,0,0" CornerRadius="{StaticResource Lzn.Radius.Md}" BorderThickness="1" Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.Stroke}" Padding="10,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,0,4,0" />
                        <ComboBox Style="{StaticResource MinimalComboBoxStyle}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortMode}" MinWidth="120"
                                  BorderThickness="0" Background="Transparent" AutomationProperties.Name="Ordenar" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}"
                           Text="{Binding VisibleCount, StringFormat={}{0} item(ns)}" />
            </Grid>

            <!-- Grade de cards -->
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0"
                              Visibility="{Binding UsesListLayout, Converter={x:Static infra:VisibilityConverter.WhenFalse}}">
                    <ItemsControl ItemsSource="{Binding CardsView}" Margin="0,0,0,18" KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveGridPanel MinItemWidth="280" MaxColumns="3" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource GroupHeader}">
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Margin" Value="0,0,0,22" />
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Estados de carregamento, vazio e falha -->
                <controls:LoadingState Message="Lendo o estado atual dos ajustes…" Visibility="{Binding IsLoading, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                            Visibility="{Binding VisibleCount, Converter={x:Static infra:VisibilityConverter.WhenZero}}">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Lzn.Icon}" FontSize="28" Foreground="{StaticResource Lzn.TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nenhum item corresponde à busca ou aos filtros." FontSize="13" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,10,0,0" />
                    <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Limpar busca e filtros" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
                <controls:Banner Problem="{Binding LoadError}" VerticalAlignment="Top">
                    <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Tentar de novo" Command="{Binding RefreshCommand}" />
                </controls:Banner>
            </Grid>

            <!-- Barra de alterações pendentes -->
            <ContentControl Grid.Row="4" Content="{Binding}" ContentTemplate="{StaticResource PendingBar}" Margin="0,0,0,16" Focusable="False" />
        </Grid>

        <!-- Painel de detalhes -->
        <Grid Visibility="{Binding IsDetailOverlayOpen, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
            <Border Background="{StaticResource Lzn.Overlay}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDetailsCommand}" />
                </Border.InputBindings>
            </Border>
            <Border HorizontalAlignment="Right" Width="560" Background="{StaticResource Lzn.Background}" BorderBrush="{StaticResource Lzn.StrokeStrong}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,14,18,0" Style="{StaticResource Lzn.GhostButton}" Command="{Binding CloseDetailsCommand}" ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar detalhes">
                        <TextBlock Text="{StaticResource Lzn.Glyph.Close}" Style="{StaticResource Lzn.Icon}" FontSize="11" />
                    </Button>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FocusDetailPanel}" Focusable="False" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
