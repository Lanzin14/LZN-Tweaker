<UserControl x:Class="LznTweaker.Features.TweakCards.TweakCardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:LznTweaker.Shell"
             xmlns:local="clr-namespace:LznTweaker.Features.TweakCards"
             xmlns:controls="clr-namespace:LznTweaker.Controls"
             xmlns:infra="clr-namespace:LznTweaker.Infrastructure"
             Background="Transparent" Foreground="{StaticResource Lzn.Text}" FontFamily="{StaticResource Lzn.Font}">
    <UserControl.Resources>
        <!-- Selo de risco: ícone + texto, explicação no hover -->
        <DataTemplate x:Key="RiskBadge" DataType="{x:Type local:CardViewModel}">
            <Border Style="{StaticResource Lzn.Badge}" HorizontalAlignment="Left" ToolTip="{Binding RiskTooltip}" ToolTipService.InitialShowDelay="150">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RiskGlyph}" Style="{StaticResource Lzn.Icon}" FontSize="11" Foreground="{Binding RiskBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding RiskText}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" Foreground="{Binding RiskBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Categoria do card (ex.: Privacidade), útil quando a busca mistura grupos; some quando a aba não tem categorias -->
        <DataTemplate x:Key="CategoryChip" DataType="{x:Type local:CardViewModel}">
            <Border Style="{StaticResource Lzn.Badge}" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="Categoria"
                    Visibility="{Binding Category, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Category.Glyph, FallbackValue=''}" Style="{StaticResource Lzn.Icon}" FontSize="10" Foreground="{StaticResource Lzn.TextMuted}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding Category.Title, FallbackValue=''}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Cabeçalho de grupo: ícone, nome, quantidade visível e descrição da categoria -->
        <DataTemplate x:Key="GroupHeader">
            <StackPanel Margin="2,4,0,10" Visibility="{Binding Name, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name.Glyph, FallbackValue=''}" Style="{StaticResource Lzn.Icon}" FontSize="14" Foreground="{StaticResource Lzn.AccentHover}" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name.Title, FallbackValue=''}" Style="{StaticResource Lzn.Text.Subtitle}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Lzn.Badge}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ItemCount}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Name.Description, FallbackValue=''}" Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" Margin="23,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="InfoButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Lzn.TextMuted}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Width="28" Height="28" CornerRadius="{StaticResource Lzn.Radius.Sm}" Background="Transparent">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceRaised}" />
                                <Setter Property="Foreground" Value="{StaticResource Lzn.AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card de ajuste do catálogo -->
        <DataTemplate DataType="{x:Type local:TweakCardViewModel}">
            <Border Style="{StaticResource Lzn.Card}" MinHeight="148">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.AccentSoft}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" FontSize="15" Foreground="{StaticResource Lzn.AccentHover}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding Title}" />
                        <Button Grid.Column="2" Style="{StaticResource InfoButton}" ToolTip="Detalhes, efeitos e restauração"
                                Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RiskBadge}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,12,0" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="6" Height="6" Fill="{Binding StateBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Lzn.ToggleSwitch}" IsChecked="{Binding IsOn}" IsEnabled="{Binding IsSwitchEnabled}"
                                  ToolTip="{Binding SwitchTooltip}" ToolTipService.ShowOnDisabled="True"
                                  Visibility="{Binding IsToggle, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                                  AutomationProperties.Name="{Binding Title}" />
                        <Button Grid.Column="2" Style="{StaticResource Lzn.ToolbarButton}" Content="{Binding ActionButtonText}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Padding="12,6"
                                Visibility="{Binding IsAction, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                                ToolTip="Ação pontual: entra na fila e é executada ao revisar e aplicar."
                                Command="{Binding DataContext.ToggleQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18" Margin="0,10,0,0" />
                        <WrapPanel Margin="0,6,0,0">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CategoryChip}" Margin="0,0,8,0" />
                            <Border Style="{StaticResource Lzn.Badge.Accent}" Margin="0,0,8,0"
                                    Visibility="{Binding IsRecommended, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                                <TextBlock Text="Recomendado" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.AccentText}" />
                            </Border>
                            <TextBlock Text="{Binding RestartText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Card de ação imediata -->
        <DataTemplate DataType="{x:Type local:QuickActionCardViewModel}">
            <Border Style="{StaticResource Lzn.Card}" MinHeight="148">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.AccentSoft}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" FontSize="15" Foreground="{StaticResource Lzn.AccentHover}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                        <Button Grid.Column="2" Style="{StaticResource InfoButton}" ToolTip="Detalhes"
                                Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RiskBadge}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,12,0" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="6" Height="6" Fill="{Binding StateBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Lzn.ToolbarButton}" Content="{Binding ButtonText}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Padding="12,6"
                                IsEnabled="{Binding IsRunning, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                                Command="{Binding DataContext.RunQuickActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding Note}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.RiskWarn}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Note, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CategoryChip}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Estado recomendado de uma configuração manual -->
        <DataTemplate x:Key="RecommendationBadge" DataType="{x:Type local:GuideCardViewModel}">
            <Border Style="{StaticResource Lzn.Badge}" HorizontalAlignment="Left" ToolTip="{Binding RiskTooltip}" ToolTipService.InitialShowDelay="150">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RecommendationGlyph}" Style="{StaticResource Lzn.Icon}" FontSize="10" Foreground="{Binding RecommendationBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding RecommendationText}" FontSize="{StaticResource Lzn.FontSize.Caption}" FontWeight="SemiBold" Foreground="{Binding RecommendationBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Card de configuração manual (hoje, só os guias do Discord: o ícone é o símbolo oficial) -->
        <DataTemplate DataType="{x:Type local:GuideCardViewModel}">
            <Border Style="{StaticResource Lzn.Card}" MinHeight="148">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.DiscordSoft}" Margin="0,0,12,0">
                            <Path Data="{StaticResource Lzn.Brand.DiscordSymbol}" Fill="{StaticResource Lzn.Discord}" Stretch="Uniform" Width="18" Height="14" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RecommendationBadge}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource Lzn.ToolbarButton}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Padding="12,6"
                                ToolTip="Passo a passo dentro do Discord"
                                Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource Lzn.Icon}" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Como configurar" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0" />
                        <TextBlock Text="Caminho" Style="{StaticResource Lzn.Text.Overline}" Margin="0,10,0,4" />
                        <TextBlock Text="{Binding PathText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.AccentText}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Detalhes de ajuste -->
        <DataTemplate x:Key="TweakDetails" DataType="{x:Type local:TweakCardViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Section}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RiskBadge}" />
                    <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="O que faz" Style="{StaticResource Lzn.Text.Overline}" Margin="0,18,0,6" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Lzn.Text.Body}" />
                <TextBlock Text="Como e efeitos esperados" Style="{StaticResource Lzn.Text.Overline}" Margin="0,14,0,6" />
                <TextBlock Text="{Binding Definition.TechnicalReason}" Style="{StaticResource Lzn.Text.Body}" />
                <TextBlock Text="Limitações e compatibilidade" Style="{StaticResource Lzn.Text.Overline}" Margin="0,14,0,6" />
                <TextBlock Text="{Binding Definition.Compatibility}" Style="{StaticResource Lzn.Text.Body}" />
                <TextBlock Text="Restauração" Style="{StaticResource Lzn.Text.Overline}" Margin="0,14,0,6" />
                <TextBlock Text="{Binding RollbackText}" FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" />
                <TextBlock FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0">
                    <Run Text="{Binding RestartText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding AdministratorText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="Estado detectado" Style="{StaticResource Lzn.Text.Overline}" Margin="0,14,0,6" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SwitchTooltip}" FontSize="11" Foreground="{StaticResource Lzn.AccentText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Definition.SourceUrl, StringFormat=Referência: {0}}" FontSize="10" Foreground="{StaticResource Lzn.TextMuted}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding Definition.SourceUrl, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ActionDetails" DataType="{x:Type local:QuickActionCardViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Section}" TextWrapping="Wrap" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RiskBadge}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                <TextBlock Text="O que faz" Style="{StaticResource Lzn.Text.Overline}" Margin="0,18,0,6" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Lzn.Text.Body}" />
                <TextBlock Text="{Binding Definition.Confirmation}" Style="{StaticResource Lzn.Text.Body}" Margin="0,10,0,0"
                           Visibility="{Binding Definition.Confirmation, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource Lzn.RiskWarn}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding Note, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
                <TextBlock Text="A execução é registrada em Backups. O app só executa a ferramenta desta lista fixa; nenhum comando digitado é aceito."
                           FontSize="11" Foreground="{StaticResource Lzn.TextMuted}" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GuideDetails" DataType="{x:Type local:GuideCardViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Section}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RecommendationBadge}" />
                    <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Benefício" Style="{StaticResource Lzn.Text.Overline}" Margin="0,18,0,6" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Lzn.Text.Body}" />
                <TextBlock Text="Caminho no Discord" Style="{StaticResource Lzn.Text.Overline}" Margin="0,14,0,6" />
                <TextBlock Text="{Binding PathText}" FontSize="12" Foreground="{StaticResource Lzn.AccentText}" TextWrapping="Wrap" />
                <TextBlock Text="Como configurar" Style="{StaticResource Lzn.Text.Overline}" Margin="0,14,0,6" />
                <ItemsControl ItemsSource="{Binding NumberedSteps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Lzn.Text.Body}" Margin="0,0,0,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{StaticResource Lzn.WarnSoft}" BorderBrush="{StaticResource Lzn.WarnStroke}" BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="12,10" Margin="0,6,0,0"
                        Visibility="{Binding Note, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                    <StackPanel>
                        <TextBlock Text="Pode variar conforme a versão" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Lzn.RiskWarn}" />
                        <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="O LZN Tweaker não abre nem altera o Discord. Se uma opção não estiver no lugar indicado, o Discord pode ter mudado o menu na sua versão."
                           FontSize="11" Foreground="{StaticResource Lzn.TextMuted}" TextWrapping="Wrap" Margin="0,14,0,0" />
                <TextBlock Text="{Binding Guide.SourceUrl, StringFormat=Referência: {0}}" FontSize="10" Foreground="{StaticResource Lzn.TextMuted}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Linha da lista compacta: hover em grafite, selecionada em roxo suave com marcador à esquerda -->
        <Style x:Key="CardRow" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Lzn.FocusVisualInset}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource Lzn.Text}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1">
                            <Border x:Name="Row" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="12,9" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Indicator" Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource Lzn.Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Lzn.AccentSoft}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Lzn.AccentStroke}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:DetailsTemplateSelector x:Key="DetailsSelector" Tweak="{StaticResource TweakDetails}" Action="{StaticResource ActionDetails}" Guide="{StaticResource GuideDetails}" />
    </UserControl.Resources>

    <Grid>
        <Grid Margin="28,22,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Margin="0,0,0,16">
                <StackPanel Margin="0,0,220,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Lzn.Text.Title}" />
                    <controls:CategoryInfo Guide="{Binding Guide}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Lzn.Text.Caption}" Margin="0,6,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Lzn.ToolbarButton}" Command="{Binding RefreshCommand}"
                        ToolTip="Ler novamente o estado real dos ajustes">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Verificar estado" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Abas contextuais -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CardTabViewModel}">
                        <RadioButton Style="{StaticResource Lzn.Tab}" GroupName="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,7,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding SelectedTabDescription}" Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" Margin="4,8,0,0"
                       Visibility="{Binding SelectedTabDescription, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}" />
            <!-- Aviso em destaque da aba (hoje, só a aba Discord) -->
            <Border Margin="0,12,0,0" Background="{StaticResource Lzn.DiscordSoft}" BorderBrush="{StaticResource Lzn.DiscordStroke}" BorderThickness="1"
                    CornerRadius="{StaticResource Lzn.Radius.Lg}" Padding="16,12"
                    Visibility="{Binding SelectedTabHighlight, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource Lzn.Brand.DiscordSymbol}" Fill="{StaticResource Lzn.Discord}" Stretch="Uniform" Width="30" Height="23" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedTabHighlight}" FontSize="{StaticResource Lzn.FontSize.Subtitle}" FontWeight="Bold" Foreground="{StaticResource Lzn.Text}" />
                        <TextBlock Text="Nada é alterado automaticamente. Os nomes seguem a versão atual do Discord em português e podem mudar entre versões; cada card avisa o que pode variar."
                                   Style="{StaticResource Lzn.Text.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>

            <!-- Pesquisa, filtros e ordenação -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource Lzn.SearchBox}" Height="36" Tag="Pesquisar ajustes…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Pesquisar ajustes" />
                <ToggleButton x:Name="FilterToggle" Grid.Column="1" Margin="8,0,0,0" Cursor="Hand" FocusVisualStyle="{StaticResource Lzn.FocusVisual}" AutomationProperties.Name="Filtros">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome" CornerRadius="{StaticResource Lzn.Radius.Md}" Padding="12,8" BorderThickness="1" Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.Stroke}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.SurfaceHover}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.StrokeStrong}" /></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lzn.AccentSoft}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Lzn.AccentStroke}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" Foreground="{StaticResource Lzn.TextSecondary}" />
                        <TextBlock Text="Filtros" FontSize="12" Foreground="{StaticResource Lzn.TextSecondary}" />
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Lzn.Accent}" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding HasFilters, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" />
                    </StackPanel>
                </ToggleButton>
                <Popup Grid.Column="1" PlacementTarget="{Binding ElementName=FilterToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsChecked, ElementName=FilterToggle, Mode=TwoWay}" VerticalOffset="6">
                    <Border Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}" BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Lg}" Padding="14" Width="260">
                        <StackPanel>
                            <TextBlock Text="Risco" Style="{StaticResource Lzn.Text.Overline}" Margin="0,0,0,6" />
                            <ComboBox Style="{StaticResource MinimalComboBoxStyle}" ItemsSource="{Binding RiskOptions}" SelectedItem="{Binding RiskFilter}" />
                            <TextBlock Text="Estado" Style="{StaticResource Lzn.Text.Overline}" Margin="0,12,0,6" />
                            <ComboBox Style="{StaticResource MinimalComboBoxStyle}" ItemsSource="{Binding StateOptions}" SelectedItem="{Binding StateFilter}" />
                            <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Limpar filtros" FontSize="11" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Command="{Binding ClearFiltersCommand}" />
                        </StackPanel>
                    </Border>
                </Popup>
                <Border Grid.Column="2" Margin="8,0,0,0" CornerRadius="{StaticResource Lzn.Radius.Md}" BorderThickness="1" Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.Stroke}" Padding="10,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,0,4,0" />
                        <ComboBox Style="{StaticResource MinimalComboBoxStyle}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortMode}" MinWidth="120"
                                  BorderThickness="0" Background="Transparent" AutomationProperties.Name="Ordenar" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Lzn.TextMuted}"
                           Text="{Binding VisibleCount, StringFormat={}{0} item(ns)}" />
            </Grid>

            <!-- Grade de cards -->
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0"
                              Visibility="{Binding UsesListLayout, Converter={x:Static infra:VisibilityConverter.WhenFalse}}">
                    <ItemsControl ItemsSource="{Binding CardsView}" Margin="0,0,0,18" KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveGridPanel MinItemWidth="280" MaxColumns="3" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource GroupHeader}">
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Margin" Value="0,0,0,22" />
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Lista compacta + detalhe fixo (página Geral). Selecionar uma linha mostra o detalhe; o interruptor só marca
                     a alteração como pendente, que continua passando por "Revisar e aplicar" (com ponto de restauração). -->
                <Grid Visibility="{Binding UsesListLayout, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="CardList" ItemsSource="{Binding CardsView}" SelectedItem="{Binding SelectedCard}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,18" ItemContainerStyle="{StaticResource CardRow}"
                             AutomationProperties.Name="Ajustes" KeyboardNavigation.TabNavigation="Once">
                        <ListBox.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource GroupHeader}">
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Margin" Value="0,0,0,16" />
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.Resources>
                            <!-- Linha de ajuste: ícone, nome, descrição curta, estado e interruptor (ou fila, para ações pontuais) -->
                            <DataTemplate DataType="{x:Type local:TweakCardViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" FontSize="14" Foreground="{StaticResource Lzn.AccentHover}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource Lzn.StatusDot}" Width="6" Height="6" Fill="{Binding StateBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Lzn.FontSize.Caption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="3" Style="{StaticResource Lzn.ToggleSwitch}" IsChecked="{Binding IsOn}" IsEnabled="{Binding IsSwitchEnabled}" VerticalAlignment="Center"
                                              ToolTip="{Binding SwitchTooltip}" ToolTipService.ShowOnDisabled="True"
                                              Visibility="{Binding IsToggle, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                                              AutomationProperties.Name="{Binding Title}" />
                                    <Button Grid.Column="3" Style="{StaticResource Lzn.ToolbarButton}" Content="{Binding ActionButtonText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Padding="10,5"
                                            Visibility="{Binding IsAction, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                                            ToolTip="Ação pontual: entra na fila e é executada ao revisar e aplicar."
                                            Command="{Binding DataContext.ToggleQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type local:QuickActionCardViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" FontSize="14" Foreground="{StaticResource Lzn.AccentHover}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource Lzn.ToolbarButton}" Content="{Binding ButtonText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Padding="10,5" Margin="12,0,0,0"
                                            IsEnabled="{Binding IsRunning, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                                            Command="{Binding DataContext.RunQuickActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type local:GuideCardViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="{StaticResource Lzn.Radius.Md}" Background="{StaticResource Lzn.DiscordSoft}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Lzn.Brand.DiscordSymbol}" Fill="{StaticResource Lzn.Discord}" Stretch="Uniform" Width="16" Height="12" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PathText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource RecommendationBadge}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>

                    <!-- Detalhe fixo -->
                    <Border Grid.Column="1" Width="420" Margin="16,0,0,16" Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.StrokeSubtle}" BorderThickness="1"
                            CornerRadius="{StaticResource Lzn.Radius.Lg}"
                            Visibility="{Binding IsDetailDocked, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                        <Grid>
                            <DockPanel Margin="22,20,22,18" Visibility="{Binding SelectedCard, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                                <!-- Ação do item selecionado, no rodapé do detalhe -->
                                <ContentControl DockPanel.Dock="Bottom" Content="{Binding SelectedCard}" Focusable="False" Margin="0,14,0,0">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type local:TweakCardViewModel}">
                                            <Border BorderBrush="{StaticResource Lzn.Stroke}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Style="{StaticResource Lzn.StatusDot}" Fill="{Binding StateBrush}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource Lzn.ToggleSwitch}" IsChecked="{Binding IsOn}" IsEnabled="{Binding IsSwitchEnabled}"
                                                              ToolTip="{Binding SwitchTooltip}" ToolTipService.ShowOnDisabled="True"
                                                              Visibility="{Binding IsToggle, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                                                              AutomationProperties.Name="{Binding Title}" />
                                                    <Button Grid.Column="1" Style="{StaticResource Lzn.ToolbarButton}" Content="{Binding ActionButtonText}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" Padding="12,6"
                                                            Visibility="{Binding IsAction, Converter={x:Static infra:VisibilityConverter.WhenTrue}}"
                                                            ToolTip="Ação pontual: entra na fila e é executada ao revisar e aplicar."
                                                            Command="{Binding DataContext.ToggleQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type local:QuickActionCardViewModel}">
                                            <Border BorderBrush="{StaticResource Lzn.Stroke}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                                <Button Style="{StaticResource Lzn.PrimaryButton}" Content="{Binding ButtonText}" HorizontalAlignment="Left"
                                                        IsEnabled="{Binding IsRunning, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                                                        Command="{Binding DataContext.RunQuickActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type local:GuideCardViewModel}">
                                            <TextBlock Text="Configuração manual: siga os passos acima dentro do Discord." Style="{StaticResource Lzn.Text.Caption}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ContentControl Content="{Binding SelectedCard}" ContentTemplateSelector="{StaticResource DetailsSelector}" Focusable="False" />
                                </ScrollViewer>
                            </DockPanel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                        Visibility="{Binding SelectedCard, Converter={x:Static infra:VisibilityConverter.WhenNull}}">
                                <TextBlock Text="&#xE8A9;" Style="{StaticResource Lzn.Icon}" FontSize="26" Foreground="{StaticResource Lzn.TextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Text="Selecione um item da lista para ver o que ele faz, os efeitos e como desfazer." Style="{StaticResource Lzn.Text.Caption}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Estados de carregamento, vazio e falha -->
                <TextBlock Text="Lendo o estado atual dos ajustes…" FontSize="13" Foreground="{StaticResource Lzn.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                           Visibility="{Binding IsLoading, Converter={x:Static infra:VisibilityConverter.WhenTrue}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                            Visibility="{Binding VisibleCount, Converter={x:Static infra:VisibilityConverter.WhenZero}}">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Lzn.Icon}" FontSize="28" Foreground="{StaticResource Lzn.TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nenhum item corresponde à busca ou aos filtros." FontSize="13" Foreground="{StaticResource Lzn.TextSecondary}" Margin="0,10,0,0" />
                    <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Limpar busca e filtros" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
                <Border VerticalAlignment="Top" Background="{StaticResource Lzn.DangerSoft}" BorderBrush="{StaticResource Lzn.DangerStroke}" BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Lg}" Padding="12"
                        Visibility="{Binding LoadError, Converter={x:Static infra:VisibilityConverter.WhenNotNull}}">
                    <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource Lzn.RiskHigh}" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <!-- Barra de alterações pendentes -->
            <Border Grid.Row="4" Margin="0,0,0,16" Background="{StaticResource Lzn.AccentSoft}" BorderBrush="{StaticResource Lzn.AccentStroke}" BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Lg}" Padding="16,12"
                    Visibility="{Binding HasPending, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,280,0">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Lzn.Icon}" FontSize="14" Foreground="{StaticResource Lzn.RiskWarn}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding PendingSummary}" FontSize="{StaticResource Lzn.FontSize.Body}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Lzn.ToolbarButton}" Content="Descartar" FontSize="12" Margin="0,0,8,0" Command="{Binding DiscardCommand}" />
                        <Button Style="{StaticResource Lzn.GlowButton}" Command="{Binding ApplyCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Lzn.Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Revisar e aplicar" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Painel de detalhes -->
        <Grid Visibility="{Binding IsDetailOverlayOpen, Converter={x:Static infra:VisibilityConverter.WhenTrue}}">
            <Border Background="{StaticResource Lzn.Overlay}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDetailsCommand}" />
                </Border.InputBindings>
            </Border>
            <Border HorizontalAlignment="Right" Width="420" Background="{StaticResource Lzn.Surface}" BorderBrush="{StaticResource Lzn.StrokeStrong}" BorderThickness="1,0,0,0">
                <DockPanel Margin="22,20,22,20">
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Style="{StaticResource Lzn.GhostButton}" Command="{Binding CloseDetailsCommand}" ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar detalhes">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Lzn.Icon}" FontSize="11" />
                    </Button>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <ContentControl Content="{Binding SelectedCard}" ContentTemplateSelector="{StaticResource DetailsSelector}" Focusable="False" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
