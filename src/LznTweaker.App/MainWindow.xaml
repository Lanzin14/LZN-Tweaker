<Window x:Class="LznTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:LznTweaker.Shell"
        Title="LZN Tweaker" Icon="pack://application:,,,/LznTweaker;component/app.ico" Height="880" Width="1400"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Lzn.Background}" Foreground="{StaticResource Lzn.Text}"
        FontFamily="{StaticResource Lzn.Font}" FontSize="{StaticResource Lzn.FontSize.Body}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Partes da sidebar que só aparecem expandida (nomes, cabeçalhos de seção, rodapé completo). -->
        <Style x:Key="ExpandedOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CollapsedOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Recolhida, cada página mostra o nome na dica ao lado do ícone. -->
        <Style x:Key="SidebarNavItem" TargetType="ListBoxItem" BasedOn="{StaticResource Lzn.NavItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding Title}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Lzn.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar expansível: 208 px com nomes ou 68 px só com ícones -->
        <Border BorderBrush="{StaticResource Lzn.StrokeSubtle}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Lzn.Sidebar}" />
                    <Setter Property="Width" Value="208" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter Property="Width" Value="68" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="12,18,12,12">
                <!-- Cabeçalho: logo oficial (símbolo + LZN; o "Tweaker" escuro da arte não aparece sobre fundo escuro) e versão.
                     Recolhida, só o símbolo: a mesma arte, menor e cortada à esquerda. -->
                <StackPanel DockPanel.Dock="Top" Margin="6,2,0,12" Style="{StaticResource ExpandedOnly}">
                    <Image Source="pack://application:,,,/LznTweaker;component/Assets/Brand/lzn-logo-mark.png" Height="42" Stretch="Uniform" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="LZN Tweaker" ToolTip="LZN Tweaker" />
                    <DockPanel Margin="2,4,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Lzn.GhostButton}" Padding="7,5" Command="{Binding ToggleSidebarCommand}"
                                ToolTip="{Binding SidebarToggleText}" AutomationProperties.Name="{Binding SidebarToggleText}">
                            <TextBlock Text="{Binding SidebarToggleGlyph}" Style="{StaticResource Lzn.Icon}" FontSize="11" Foreground="{StaticResource Lzn.TextMuted}" />
                        </Button>
                        <TextBlock Style="{StaticResource Lzn.Text.Caption}" VerticalAlignment="Center">
                            <Run Text="Tweaker" Foreground="{StaticResource Lzn.TextSecondary}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,2,0,10" Style="{StaticResource CollapsedOnly}">
                    <Border Width="40" Height="32" ClipToBounds="True" HorizontalAlignment="Center" Background="Transparent"
                            ToolTip="{Binding AppVersion, StringFormat=LZN Tweaker · {0}}" ToolTipService.Placement="Right">
                        <Canvas>
                            <Image Source="pack://application:,,,/LznTweaker;component/Assets/Brand/lzn-logo-mark.png" Height="32" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="LZN Tweaker" />
                        </Canvas>
                    </Border>
                    <Button Style="{StaticResource Lzn.GhostButton}" HorizontalAlignment="Center" Padding="10,7" Margin="0,10,0,0" Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{Binding SidebarToggleText}" ToolTipService.Placement="Right" AutomationProperties.Name="{Binding SidebarToggleText}">
                        <TextBlock Text="{Binding SidebarToggleGlyph}" Style="{StaticResource Lzn.Icon}" FontSize="12" Foreground="{StaticResource Lzn.TextMuted}" />
                    </Button>
                </StackPanel>

                <!-- Rodapé recolhido: só o avatar com o ponto de status; o resumo fica na dica. -->
                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource CollapsedOnly}"
                      ToolTip="{Binding FooterSummary}" ToolTipService.Placement="Right" AutomationProperties.Name="{Binding FooterSummary}">
                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Lzn.AccentSoft}" BorderBrush="{StaticResource Lzn.AccentStroke}" BorderThickness="1">
                        <TextBlock Text="{Binding UserInitial}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Ellipse Style="{StaticResource Lzn.StatusDot}" Fill="{StaticResource Lzn.RiskLow}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Stroke="{StaticResource Lzn.Sidebar}" StrokeThickness="2" Width="11" Height="11" />
                </Grid>

                <!-- Rodapé: status, usuário, Windows e privilégios -->
                <Border DockPanel.Dock="Bottom" Padding="12" Margin="0,12,0,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Lzn.Panel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Style="{StaticResource Lzn.StatusDot}" Fill="{StaticResource Lzn.RiskLow}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="150"
                                       ToolTip="{Binding StatusText}" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Lzn.AccentSoft}" BorderBrush="{StaticResource Lzn.AccentStroke}" BorderThickness="1">
                                <TextBlock Text="{Binding UserInitial}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PrivilegeText}" FontSize="{StaticResource Lzn.FontSize.Caption}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Lzn.RiskWarn}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Lzn.AccentHover}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding WindowsVersion}" Style="{StaticResource Lzn.Text.Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Navegação (teclado: setas para cima/baixo) -->
                <ListBox ItemsSource="{Binding NavView}" SelectedItem="{Binding SelectedItem}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource SidebarNavItem}"
                         KeyboardNavigation.TabNavigation="Once">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Style="{StaticResource ExpandedOnly}">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Lzn.Text.Overline}" Margin="10,10,0,5" />
                                        </Border>
                                        <!-- Recolhida, a seção vira uma linha divisória. -->
                                        <Border Height="1" Margin="6,12,6,8" Background="{StaticResource Lzn.Stroke}" Style="{StaticResource CollapsedOnly}" />
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type shell:NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontSize="14" Width="24">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Lzn.Icon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Lzn.AccentHover}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           Style="{StaticResource ExpandedOnly}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Conteúdo da página atual, com transição suave -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView, NotifyOnTargetUpdated=True}" Focusable="False">
            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ContentControl.Triggers>
        </ContentControl>

        <!-- Notificações -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Width="340">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type shell:ToastViewModel}">
                    <!-- Notificação: superfície elevada com faixa colorida pelo tipo (sucesso, aviso, erro). -->
                    <Border Background="{StaticResource Lzn.SurfaceRaised}" BorderBrush="{StaticResource Lzn.StrokeStrong}" BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Lg}" Margin="0,8,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Margin="0,10" CornerRadius="0,2,2,0" Background="{Binding AccentBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" Foreground="{Binding AccentBrush}" VerticalAlignment="Top" Margin="11,13,10,0" />
                            <StackPanel Grid.Column="2" Margin="0,12,0,12">
                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{StaticResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource Lzn.GhostButton}" VerticalAlignment="Top" Margin="6,6,6,0" ToolTip="Fechar" AutomationProperties.Name="Fechar notificação"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Lzn.Icon}" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
