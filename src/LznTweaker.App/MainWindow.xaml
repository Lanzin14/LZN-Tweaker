<Window x:Class="LznTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:LznTweaker.Shell"
        Title="LZN Tweaker" Icon="pack://application:,,,/LznTweaker;component/app.ico" Height="880" Width="1400"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Lzn.Background}" Foreground="{DynamicResource Lzn.Text}"
        FontFamily="{StaticResource Lzn.Font}" FontSize="{StaticResource Lzn.FontSize.Body}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Partes da sidebar que só aparecem expandida (nomes, cabeçalhos de seção, rodapé completo). -->
        <Style x:Key="ExpandedOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CollapsedOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Item do menu: ícone (violeta quando é a página aberta) e nome; recolhida, só o ícone. -->
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type shell:NavItem}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontSize="15" Width="26">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Lzn.Icon}">
                            <Setter Property="Foreground" Value="{DynamicResource Lzn.Sidebar.TextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Lzn.AccentHover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                           Style="{StaticResource ExpandedOnly}" />
            </StackPanel>
        </DataTemplate>
        <!-- Ponto de privilégio: verde como administrador, âmbar sem (o app pede administrador para aplicar). -->
        <Style x:Key="PrivilegeDot" TargetType="Ellipse">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource Lzn.RiskWarn}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElevated}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Lzn.RiskLow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Recolhida, cada página mostra o nome na dica ao lado do ícone. -->
        <Style x:Key="SidebarNavItem" TargetType="ListBoxItem" BasedOn="{StaticResource Lzn.NavItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding Title}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Lzn.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar expansível: 208 px com nomes ou 68 px só com ícones; painel solto com cantos arredondados sobre o fundo.
             Texto em Geist (Lzn.SidebarFont). -->
        <Border BorderBrush="{DynamicResource Lzn.Sidebar.Stroke}" BorderThickness="1" CornerRadius="14" Margin="12,12,0,12"
                TextElement.FontFamily="{StaticResource Lzn.SidebarFont}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Lzn.Sidebar}" />
                    <Setter Property="Width" Value="208" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter Property="Width" Value="68" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="12,18,12,12">
                <!-- Cabeçalho: logo oficial (símbolo + LZN; o "Tweaker" escuro da arte não aparece sobre fundo escuro) e versão.
                     Recolhida, só o símbolo: a mesma arte, menor e cortada à esquerda. -->
                <DockPanel DockPanel.Dock="Top" Margin="6,0,0,14" Style="{StaticResource ExpandedOnly}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Lzn.GhostButton}" Padding="7,5" Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{Binding SidebarToggleText}" AutomationProperties.Name="{Binding SidebarToggleText}">
                        <TextBlock Text="{Binding SidebarToggleGlyph}" Style="{StaticResource Lzn.Icon}" FontSize="11" Foreground="{DynamicResource Lzn.Sidebar.TextMuted}" />
                    </Button>
                    <Image Source="pack://application:,,,/LznTweaker;component/Assets/Brand/lzn-logo-mark.png" Height="22" Stretch="Uniform" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="LZN Tweaker" ToolTip="LZN Tweaker" />
                    <TextBlock Style="{StaticResource Lzn.Text.Caption}" Foreground="{DynamicResource Lzn.Sidebar.TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"
                               ToolTip="{Binding AppVersion, StringFormat=LZN Tweaker {0}}">
                        <Run Text="Tweaker" Foreground="{DynamicResource Lzn.Sidebar.Text}" FontWeight="Medium" />
                    </TextBlock>
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,2,0,10" Style="{StaticResource CollapsedOnly}">
                    <Border Width="40" Height="32" ClipToBounds="True" HorizontalAlignment="Center" Background="Transparent"
                            ToolTip="{Binding AppVersion, StringFormat=LZN Tweaker · {0}}" ToolTipService.Placement="Right">
                        <Canvas>
                            <Image Source="pack://application:,,,/LznTweaker;component/Assets/Brand/lzn-logo-mark.png" Height="32" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="LZN Tweaker" />
                        </Canvas>
                    </Border>
                    <Button Style="{StaticResource Lzn.GhostButton}" HorizontalAlignment="Center" Padding="10,7" Margin="0,10,0,0" Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{Binding SidebarToggleText}" ToolTipService.Placement="Right" AutomationProperties.Name="{Binding SidebarToggleText}">
                        <TextBlock Text="{Binding SidebarToggleGlyph}" Style="{StaticResource Lzn.Icon}" FontSize="12" Foreground="{DynamicResource Lzn.Sidebar.TextMuted}" />
                    </Button>
                </StackPanel>

                <!-- Rodapé recolhido: só o avatar com o ponto de status; o resumo fica na dica. -->
                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource CollapsedOnly}"
                      ToolTip="{Binding FooterSummary}" ToolTipService.Placement="Right" AutomationProperties.Name="{Binding FooterSummary}">
                    <Ellipse Width="9" Height="9" Margin="0,4" Style="{StaticResource PrivilegeDot}" />
                </Grid>

                <!-- Rodapé: privilégio numa linha; usuário, Windows e status ficam na dica. -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10,10,0,0" Style="{StaticResource ExpandedOnly}"
                            ToolTip="{Binding FooterSummary}" ToolTipService.Placement="Right" AutomationProperties.Name="{Binding FooterSummary}">
                    <Ellipse Width="7" Height="7" Margin="0,0,10,0" Style="{StaticResource PrivilegeDot}" />
                    <TextBlock Text="{Binding PrivilegeText}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{DynamicResource Lzn.Sidebar.TextMuted}" />
                </StackPanel>

                <!-- Tema (expandida): seguir o Windows, claro ou escuro Grafite + Azul. Troca na hora e fica salvo. -->
                <DockPanel DockPanel.Dock="Bottom" Margin="10,8,4,0" Style="{StaticResource ExpandedOnly}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Lzn.Segment.First}" Padding="0" Width="30" Height="26" GroupName="Tema" Command="{Binding SetThemeCommand}" CommandParameter="System"
                                     IsChecked="{Binding IsThemeSystem, Mode=OneWay}" ToolTip="Seguir o tema do Windows" AutomationProperties.Name="Seguir o tema do Windows">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Lzn.Icon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource Lzn.Segment}" Padding="0" Width="30" Height="26" GroupName="Tema" Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                     IsChecked="{Binding IsThemeLight, Mode=OneWay}" ToolTip="Tema claro" AutomationProperties.Name="Tema claro">
                            <TextBlock Text="&#xE706;" Style="{StaticResource Lzn.Icon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource Lzn.Segment.Last}" Padding="0" Width="30" Height="26" GroupName="Tema" Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                     IsChecked="{Binding IsThemeDark, Mode=OneWay}" ToolTip="Tema escuro" AutomationProperties.Name="Tema escuro">
                            <TextBlock Text="&#xE708;" Style="{StaticResource Lzn.Icon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </RadioButton>
                    </StackPanel>
                    <TextBlock Text="Tema" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{DynamicResource Lzn.Sidebar.TextMuted}" VerticalAlignment="Center" />
                </DockPanel>
                <!-- Tema (recolhida): um botão que alterna Windows → claro → escuro. -->
                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Center" Padding="9,6" Margin="0,6,0,0" Command="{Binding CycleThemeCommand}"
                        ToolTip="{Binding ThemeText}" ToolTipService.Placement="Right" AutomationProperties.Name="{Binding ThemeText}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Lzn.GhostButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding ThemeGlyph}" Style="{StaticResource Lzn.Icon}" FontSize="13" Foreground="{DynamicResource Lzn.Sidebar.TextMuted}" />
                </Button>

                <!-- Rodapé: Histórico fixo, separado do menu por uma linha. -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Margin="4,8,4,6" Background="{DynamicResource Lzn.Sidebar.Stroke}" />
                    <ListBox ItemsSource="{Binding FooterNavItems}" SelectedItem="{Binding SelectedFooterItem}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource SidebarNavItem}"
                             ItemTemplate="{StaticResource NavItemTemplate}" KeyboardNavigation.TabNavigation="Once" />
                </StackPanel>

                <!-- Navegação (teclado: setas para cima/baixo) -->
                <ListBox ItemsSource="{Binding NavView}" SelectedItem="{Binding SelectedMainItem}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource SidebarNavItem}"
                         KeyboardNavigation.TabNavigation="Once">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border Style="{StaticResource ExpandedOnly}">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Lzn.Text.Overline}" Foreground="{DynamicResource Lzn.Sidebar.TextMuted}" Margin="10,10,0,5" />
                                        </Border>
                                        <!-- Recolhida, a seção vira uma linha divisória. -->
                                        <Border Height="1" Margin="6,12,6,8" Background="{DynamicResource Lzn.Sidebar.Stroke}" Style="{StaticResource CollapsedOnly}" />
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <StaticResource ResourceKey="NavItemTemplate" />
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Conteúdo da página atual, com transição suave -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView, NotifyOnTargetUpdated=True}" Focusable="False">
            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ContentControl.Triggers>
        </ContentControl>

        <!-- Notificações -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Width="340">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type shell:ToastViewModel}">
                    <!-- Notificação: superfície elevada com faixa colorida pelo tipo (sucesso, aviso, erro). -->
                    <Border Background="{DynamicResource Lzn.SurfaceRaised}" BorderBrush="{DynamicResource Lzn.StrokeStrong}" BorderThickness="1" CornerRadius="{StaticResource Lzn.Radius.Lg}" Margin="0,8,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Margin="0,10" CornerRadius="0,2,2,0" Background="{Binding AccentBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource Lzn.Icon}" Foreground="{Binding AccentBrush}" VerticalAlignment="Top" Margin="11,13,10,0" />
                            <StackPanel Grid.Column="2" Margin="0,12,0,12">
                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource Lzn.FontSize.BodySmall}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" FontSize="{StaticResource Lzn.FontSize.Caption}" Foreground="{DynamicResource Lzn.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource Lzn.GhostButton}" VerticalAlignment="Top" Margin="6,6,6,0" ToolTip="Fechar" AutomationProperties.Name="Fechar notificação"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Lzn.Icon}" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
