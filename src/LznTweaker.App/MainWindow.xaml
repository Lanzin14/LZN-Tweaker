<Window x:Class="LznTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LznTweaker" Height="900" Width="1440"
        MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate x:Key="RecommendationTemplate">
            <Border Background="#1B1726" CornerRadius="9" Padding="12" Margin="0,0,0,9">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding NivelDeImpacto}" Foreground="#D6B76A" FontSize="10" Margin="10,0,0,0"/></Grid>
                    <TextBlock Text="{Binding DescricaoDetalhada}" Foreground="#AAA1B7" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="16"/>
                    <TextBlock Text="{Binding AplicacaoAutomaticaText}" Foreground="#75CDA8" FontSize="9" FontWeight="Bold" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DriveTemplate">
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="#E8E2F1" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalText}" Foreground="#AAA1B7" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="{Binding FreeText}" Foreground="#9B92AA" FontSize="11"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ProcessTemplate">
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="#E8E2F1" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding MemoryText}" Foreground="#AAA1B7" FontSize="11" Margin="12,0,0,0"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#AAA1B7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#211B2C" />
                                <Setter Property="Foreground" Value="#F2EFF9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F2EFF9" />
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22,18,16">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,34">
                        <Border Width="38" Height="38" CornerRadius="11" Background="#9A78F2" VerticalAlignment="Center">
                            <TextBlock Text="L" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LznTweaker" FontWeight="Bold" FontSize="17" Foreground="#F2EFF9" />
                            <TextBlock Text="PC GAMING COMPANION" FontSize="9" Foreground="#827A91" Margin="1,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="VISÃO GERAL" FontSize="10" FontWeight="Bold" Foreground="#746B82" Margin="12,0,0,8" />
                    <Button x:Name="DashboardNav" Style="{StaticResource NavButtonStyle}" Tag="Painel" Click="Navigate_Click" Background="#2B2140" Foreground="#D8CCFF">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="28" FontSize="16"/><TextBlock Text="Painel" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Diagnóstico" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◉" Width="28" FontSize="16"/><TextBlock Text="Diagnóstico" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <TextBlock Text="FERRAMENTAS" FontSize="10" FontWeight="Bold" Foreground="#746B82" Margin="12,24,0,8" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Tweaks" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="28" FontSize="16"/><TextBlock Text="Tweaks" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Jogos" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◈" Width="28" FontSize="16"/><TextBlock Text="Otimização para jogos" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Aplicativos" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="28" FontSize="16"/><TextBlock Text="Aplicativos" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Inicialização" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="↗" Width="28" FontSize="16"/><TextBlock Text="Inicialização" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Privacidade" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◇" Width="28" FontSize="16"/><TextBlock Text="Privacidade" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Limpeza" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Width="28" FontSize="16"/><TextBlock Text="Limpeza" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <TextBlock Text="ACOMPANHAMENTO" FontSize="10" FontWeight="Bold" Foreground="#746B82" Margin="12,24,0,8" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Histórico" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◷" Width="28" FontSize="16"/><TextBlock Text="Histórico e comparação" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#181421" BorderBrush="#2B2438" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="MODO SEGURO" FontWeight="Bold" FontSize="10" Foreground="#7ED9B2" />
                        <TextBlock Text="As alterações só são executadas após seleção e confirmação." TextWrapping="Wrap" FontSize="11" Foreground="#9B92AA" Margin="0,7,0,0" LineHeight="16" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,0,1" Background="{StaticResource HeaderBrush}">
                <Grid Margin="30,0,34,0">
                    <TextBlock x:Name="BreadcrumbText" Text="Painel  /  Visão geral" VerticalAlignment="Center" Foreground="#9B92AA" FontSize="13" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click" Margin="0,0,12,0" Padding="11,7">
                            <TextBlock Text="↻  Atualizar" FontSize="11" />
                        </Button>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#2C2638">
                            <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#E1DBE9" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="PageHost" Margin="30,26,34,32">
                    <StackPanel>
                        <Grid Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock Text="Seu PC, em perspectiva." FontSize="28" FontWeight="Bold" Foreground="#F2EFF9" />
                                <TextBlock Text="Diagnóstico claro para decisões melhores — sem ajustes automáticos." Foreground="#AAA1B7" FontSize="14" Margin="0,7,0,0" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#2B2140" BorderBrush="#49366A" BorderThickness="1" CornerRadius="8" Padding="11,7">
                                <TextBlock Text="LEITURA DO SISTEMA" Foreground="#D8CCFF" FontWeight="Bold" FontSize="10" />
                            </Border>
                        </Grid>

                        <Border Background="#1F192D" BorderBrush="#362A50" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="i" Grid.Column="0" FontSize="18" FontWeight="Bold" Foreground="#D8CCFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Diagnóstico somente para leitura" FontWeight="SemiBold" Foreground="#EAE3FB" FontSize="13" />
                                    <TextBlock Text="Hardware, Windows e volumes são consultados localmente. Nenhuma configuração é alterada sem seleção e confirmação." Foreground="#B5AAC9" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#9A88D0" FontSize="10" FontWeight="Bold" Margin="18,0,2,0" />
                            </Grid>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="SISTEMA" Foreground="#827A91" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding OperatingSystemName}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap"/><TextBlock Text="{Binding OperatingSystemDetail}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="5,0">
                                <StackPanel><TextBlock Text="PROCESSADOR" Foreground="#827A91" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding ProcessorSummary}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="{Binding ProcessorDetail}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="5,0">
                                <StackPanel><TextBlock Text="MEMÓRIA RAM" Foreground="#827A91" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding MemorySummary}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="10,0,0,0">
                                <StackPanel><TextBlock Text="ARMAZENAMENTO" Foreground="#827A91" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding StorageSummary}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="{Binding StorageDetail}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,9,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16"><TextBlock Text="Condição do sistema" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="LEITURA LOCAL" HorizontalAlignment="Right" Foreground="#827A91" FontSize="9" FontWeight="Bold"/></Grid>
                                    <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="CPU" Foreground="#AAA1B7" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding CpuUsage, Mode=OneWay}" Height="6" Background="#2A2337" Foreground="#9A78F2" BorderThickness="0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding CpuUsageText}" Foreground="#E1DBE9" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/></Grid>
                                    <Grid Margin="0,12,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="Memória" Foreground="#AAA1B7" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding MemoryUsage, Mode=OneWay}" Height="6" Background="#2A2337" Foreground="#B49AFF" BorderThickness="0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding MemoryUsageText}" Foreground="#E1DBE9" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/></Grid>
                                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="Disco do sistema" Foreground="#AAA1B7" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding SystemDriveUsage, Mode=OneWay}" Height="6" Background="#2A2337" Foreground="#8F72D4" BorderThickness="0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding SystemDriveUsageText}" Foreground="#E1DBE9" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/></Grid>
                                    <TextBlock Text="{Binding GraphicsSummary}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding GraphicsMemorySummary}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Margin="9,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Informações do sistema" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding UptimeSummary}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,8" Foreground="#E2D8FF" />
                                    <TextBlock Text="{Binding MotherboardSummary}" Foreground="#AAA1B7" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CommitSummary}" Foreground="#AAA1B7" FontSize="11" TextWrapping="Wrap" Margin="0,13,0,0" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Revisar recomendações  →" Click="Profile_Click" Margin="0,17,0,0" Padding="12,10" HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,9,0">
                                <StackPanel>
                                    <TextBlock Text="Unidades disponíveis" Style="{StaticResource SectionTitleStyle}" />
                                    <ItemsControl ItemsSource="{Binding Drives}" ItemTemplate="{StaticResource DriveTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Margin="9,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Processos com maior uso de RAM" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding TopProcesses}" ItemTemplate="{StaticResource ProcessTemplate}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,9,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14"><TextBlock Text="Recomendações iniciais" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Recommendations.Count, StringFormat={}{0} verificações}" HorizontalAlignment="Right" Foreground="#827A91" FontSize="11"/></Grid>
                                    <ItemsControl ItemsSource="{Binding Recommendations}" ItemTemplate="{StaticResource RecommendationTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Margin="9,0,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15"><TextBlock Text="Atividade de armazenamento" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="WMI" HorizontalAlignment="Right" Foreground="#827A91" FontSize="9" FontWeight="Bold"/></Grid>
                                    <TextBlock Text="{Binding DiskActivitySummary}" Foreground="#AAA1B7" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                                    <Border Height="1" Background="#2A2337" Margin="0,16,0,12" />
                                    <TextBlock Text="A métrica pode não existir em alguns controladores ou edições do Windows. Nesse caso, o painel informa que está indisponível." Foreground="#8D849B" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding LastUpdated}" HorizontalAlignment="Center" Foreground="#665E75" FontSize="10" Margin="0,23,0,0" />
                    </StackPanel>
                </ContentControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

