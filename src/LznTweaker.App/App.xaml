<Application x:Class="LznTweaker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LznTweaker">
    <Application.Resources>
        <!-- Cores, tipografia e estilos ficam todos em Themes/Theme.xaml. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Paleta: trocada em tempo real pelo ThemeService (claro ou escuro, seguindo o Windows por padrão). -->
                <ResourceDictionary Source="Themes/Palette.Dark.xaml" />
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
