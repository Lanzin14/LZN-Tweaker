<UserControl x:Class="LznTweaker.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="#F2EFF9" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CategoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentStrokeBrush}" />
                    <Setter Property="Background" Value="#171322" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CategoryTemplate">
            <Border Style="{StaticResource CategoryCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Selection Checkbox -->
                    <CheckBox Style="{StaticResource AccentCheckBoxStyle}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,14,0" />

                    <!-- Title and Path details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#F2EFF9" />
                            <Border Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVis}}"
                                    Background="#2B2140" BorderBrush="#49366A" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                <TextBlock Text="SISTEMA (UAC)" Foreground="#D8CCFF" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#AAA1B7" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PathSummary, StringFormat='Local: {0}'}" FontSize="10" Foreground="#827A91" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Size and Count Badge -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="14,0,0,0">
                        <Border Background="#211A30" BorderBrush="#3D2D56" BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <TextBlock Text="{Binding SizeDisplay}" FontSize="13" FontWeight="Bold" Foreground="#D8CCFF" HorizontalAlignment="Right" />
                        </Border>
                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#827A91" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,22,34,32">

            <!-- Title & Subtitle Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Limpeza do Sistema &amp; Cache" FontSize="26" FontWeight="Bold" Foreground="#F2EFF9" />
                    <TextBlock Text="Varredura profunda e segura em arquivos temporários, logs residuais e caches do Windows."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#2B2140" BorderBrush="#49366A" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <TextBlock Text="ARQUIVOS EM USO SÃO PRESERVADOS" Foreground="#7ED9B2" FontSize="9" FontWeight="Bold" />
                </Border>
            </Grid>

            <!-- Top Action & Space Summary Card -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ESPAÇO RECONHECIDO PARA LIBERAÇÃO" FontSize="10" FontWeight="Bold" Foreground="#827A91" />
                        <TextBlock Text="{Binding TotalFoundText}" FontSize="32" FontWeight="Bold" Foreground="#F2EFF9" Margin="0,4,0,2" />
                        <TextBlock Text="{Binding SelectedSizeText, StringFormat='{}{0} para remoção segura.'}" FontSize="12" Foreground="#D8CCFF" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="Scan_Click" IsEnabled="{Binding CanScan}" Margin="0,0,10,0" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍 " FontSize="12" />
                                <TextBlock Text="Iniciar Varredura" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="Clean_Click" IsEnabled="{Binding CanClean}" Padding="18,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ " FontSize="12" />
                                <TextBlock Text="Limpar Selecionados" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress & Status Banner -->
            <Border Background="#161220" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#AAA1B7" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#D8CCFF" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Height="5" Value="{Binding ProgressValue, Mode=OneWay}" Background="#251F33" Foreground="#9A78F2" BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- Categories Selection Bar -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="ÁREAS DE VARREDURA" FontSize="11" FontWeight="Bold" Foreground="#827A91" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Marcar Todos" Click="SelectAll_Click" Padding="10,5" Margin="0,0,6,0" FontSize="11" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Desmarcar Todos" Click="SelectNone_Click" Padding="10,5" FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- Category Cards List -->
            <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryTemplate}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
