<UserControl x:Class="LznTweaker.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="#F2EFF9" FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="PresetPillButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- Compact Tweak Row Item Template with Rich Tooltip -->
        <DataTemplate x:Key="CompactTweakItemTemplate">
            <Border CornerRadius="8" Padding="10,6" Margin="0,1"
                    ToolTipService.InitialShowDelay="120"
                    ToolTipService.BetweenShowDelay="80"
                    ToolTipService.ShowDuration="25000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F192C" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ToolTip>
                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                        <Border Background="#161220" BorderBrush="#3D3056" BorderThickness="1" CornerRadius="10" Padding="14" MaxWidth="390">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.75" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#F2EFF9" TextWrapping="Wrap" />
                                    <Border Grid.Column="1" Background="{Binding RiskBackgroundBrush}" BorderBrush="{Binding RiskBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding RiskLevel, StringFormat=Risco {0}}" Foreground="{Binding RiskBrush}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#827A91" Margin="0,0,0,6" />

                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#AAA1B7" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,8" />

                                <Border Height="1" Background="#2B2438" Margin="0,2,0,8" />

                                <TextBlock Text="DETALHES TÉCNICOS:" FontSize="9" FontWeight="Bold" Foreground="#827A91" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding TechnicalReason}" FontSize="11" Foreground="#C8BFD7" TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,8" />

                                <Border Height="1" Background="#2B2438" Margin="0,0,0,8" />

                                <WrapPanel Margin="0,0,0,4">
                                    <Border Background="#211A30" BorderBrush="#382B52" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding AdministratorText}" Foreground="#C9B9F2" FontSize="10" />
                                    </Border>
                                    <Border Background="#1A2826" BorderBrush="#25433C" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding RestartText}" Foreground="#91BFB0" FontSize="10" />
                                    </Border>
                                    <Border Background="#2B2319" BorderBrush="#473722" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding RollbackText}" Foreground="#D9B17B" FontSize="10" />
                                    </Border>
                                    <Border Background="#1D1A26" BorderBrush="#302B3D" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Compatibility}" Foreground="#8D849B" FontSize="10" />
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="{Binding StateText}" Foreground="{StaticResource AccentTextBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Checkbox -->
                    <CheckBox Grid.Column="0" Style="{StaticResource AccentCheckBoxStyle}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,10,0" />

                    <!-- Tweak Name -->
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontSize="13" FontWeight="Medium" Foreground="#F2EFF9"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                    <!-- Risk Badge Indicator -->
                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Background="{Binding RiskBackgroundBrush}"
                            BorderBrush="{Binding RiskBorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding RiskLevel}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{Binding RiskBrush}" />
                    </Border>

                    <!-- Help Question Mark Icon Button -->
                    <Border Grid.Column="3" Width="18" Height="18" CornerRadius="9"
                            Background="#251F33" BorderBrush="#382E4D" BorderThickness="1"
                            VerticalAlignment="Center" Cursor="Help">
                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="#BFAEDF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,32,32">

            <!-- Title & Subtitle Header -->
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Biblioteca de Tweaks" FontSize="26" FontWeight="Bold" Foreground="#F2EFF9" />
                    <TextBlock Text="Selecione um perfil rápido ou personalize os ajustes individualmente. Passe o mouse sobre qualquer item para detalhes."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#2B2140" BorderBrush="#49366A" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <TextBlock Text="EXECUÇÃO COORDENADA" Foreground="#D8CCFF" FontSize="9" FontWeight="Bold" />
                </Border>
            </Grid>

            <!-- Presets Bar & Quick Selection -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Preset Quick Buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PRESETS:" FontSize="10" FontWeight="Bold" Foreground="#827A91" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Style="{StaticResource PresetPillButtonStyle}" Click="PresetStandard_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="★ " Foreground="#9A78F2" FontSize="10" />
                                    <TextBlock Text="Standard (Recomendado)" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PresetPillButtonStyle}" Click="PresetMinimal_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " Foreground="#7ED9B2" FontSize="10" />
                                    <TextBlock Text="Mínimo" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PresetPillButtonStyle}" Click="PresetAdvanced_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙ " Foreground="#E0BF80" FontSize="10" />
                                    <TextBlock Text="Avançado" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PresetPillButtonStyle}" Click="ClearSelection_Click">
                                <TextBlock Text="✕ Limpar Seleção" />
                            </Button>
                        </StackPanel>

                        <!-- Refresh State Button -->
                        <Button Grid.Column="1" Style="{StaticResource PresetPillButtonStyle}" Click="Refresh_Click" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↻ " FontSize="11" />
                                <TextBlock Text="Detectar Estado Real" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Height="1" Background="#241E30" Margin="0,11,0,10" />

                    <!-- Status / Summary info line -->
                    <Grid>
                        <TextBlock Text="{Binding SelectedPresetOption.Description}" Foreground="#827A91" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border HorizontalAlignment="Right" Background="#211A30" BorderBrush="#3B2C54" BorderThickness="1" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="{Binding SelectionSummary}" Foreground="#D8CCFF" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2-COLUMN COMPACT TWEAKS GRID -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Essential Tweaks + Advanced Tweaks -->
                <StackPanel Grid.Column="0">

                    <!-- Block 1: Essential Tweaks -->
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="13" Foreground="#9A78F2" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Essential Tweaks" FontSize="14" FontWeight="SemiBold" Foreground="#F2EFF9" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="#211A30" CornerRadius="8" Padding="7,2">
                                    <TextBlock Text="{Binding EssentialItems.Count, StringFormat={}{0} opções}" Foreground="#D8CCFF" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding EssentialItems}" ItemTemplate="{StaticResource CompactTweakItemTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- Block 2: Advanced Tweaks - CAUTION -->
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚠" FontSize="13" Foreground="#E0BF80" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Advanced Tweaks" FontSize="14" FontWeight="SemiBold" Foreground="#F2EFF9" VerticalAlignment="Center" />
                                    <Border Background="#302315" BorderBrush="#594123" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="CUIDADO" Foreground="#E0BF80" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="#211A30" CornerRadius="8" Padding="7,2">
                                    <TextBlock Text="{Binding AdvancedItems.Count, StringFormat={}{0} opções}" Foreground="#D8CCFF" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AdvancedItems}" ItemTemplate="{StaticResource CompactTweakItemTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: Customize Preferences + Performance Plans -->
                <StackPanel Grid.Column="2">

                    <!-- Block 3: Customize Preferences -->
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎨" FontSize="13" Foreground="#7ED9B2" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Customize Preferences" FontSize="14" FontWeight="SemiBold" Foreground="#F2EFF9" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="#211A30" CornerRadius="8" Padding="7,2">
                                    <TextBlock Text="{Binding PreferenceItems.Count, StringFormat={}{0} preferências}" Foreground="#D8CCFF" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PreferenceItems}" ItemTemplate="{StaticResource CompactTweakItemTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- Block 4: Performance Plans -->
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔋" FontSize="13" Foreground="#AE92FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Performance Plans" FontSize="14" FontWeight="SemiBold" Foreground="#F2EFF9" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="#211A30" CornerRadius="8" Padding="7,2">
                                    <TextBlock Text="{Binding PerformancePlanItems.Count, StringFormat={}{0} planos}" Foreground="#D8CCFF" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PerformancePlanItems}" ItemTemplate="{StaticResource CompactTweakItemTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Execution Logs & Real-Time Status Banner -->
            <Border Background="#161220" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Status da Sessão e Detecção" FontWeight="SemiBold" Foreground="#F2EFF9" FontSize="12" />
                    <TextBlock Text="{Binding AvailabilityMessage}" Foreground="#AAA1B7" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding OperationMessage}" Foreground="#D8CCFF" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding HistoryMessage}" Foreground="#827A91" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Bottom Global Actions Bar -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource SecondaryButtonStyle}" Content="🛡️ Abrir Proteção do Sistema" Click="OpenProtection_Click" HorizontalAlignment="Left" Padding="14,10" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Grid.Column="1" Content="Detalhes do Selecionado" Click="Details_Click" Margin="9,0,0,0" Padding="14,10" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Grid.Column="2" Content="↺ Undo Selecionados" Click="UndoSelected_Click" IsEnabled="{Binding CanUndoSelected}" Margin="9,0,0,0" Padding="14,10" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Grid.Column="3" Content="⚡ Executar Tweaks Selecionados" Click="RunTweaks_Click" IsEnabled="{Binding CanApply}" Margin="9,0,0,0" Padding="18,10" />
            </Grid>

            <!-- Footer Note -->
            <TextBlock Text="{Binding UndoSummary}" Foreground="#827A91" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
